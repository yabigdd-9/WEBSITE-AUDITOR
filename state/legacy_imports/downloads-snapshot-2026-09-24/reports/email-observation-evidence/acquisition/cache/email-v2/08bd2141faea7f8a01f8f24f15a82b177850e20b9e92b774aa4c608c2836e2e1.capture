<style id="wp-custom-css">
.wp-caption-text {
	line-height: 1.5em;
	font-size: 16px;
	text-align: left;
}

#field_16_6 {
	width: 100%;
	padding-right: 20px;
}

#field_32_2, #field_32_5 {
	width: 100%;
	padding-right: 0;
}

@media(max-width: 767px) {
	#field_16_6 {
	padding-right: 0;
	}
}

#gform_submit_button_16 {
	margin-right: 20px;
}

.gform_footer {
	margin-bottom: 20px!important;
}

#bookappraisal {
	overflow: hidden;
}

@media(max-width: 767px) {
	.gform_footer .gform_button {
		width: 100%!important;
	}
}

@media(min-width: 767px) {
	.request_form.site_appr_form .gform_legacy_markup_wrapper .gform_footer {
		position: absolute;
	}
}

.page-template-franchise video {
	height: auto;
	margin: auto;
	padding: 10px;
	position: relative;
}

@media(max-width: 1024px) {
	.page-template-franchise video {
		padding: 0;;
	}
}

.project_bg_small {
	cursor: pointer;
}

.no-vacancies {
	text-align: center;
}

/* Vacancies */

.careeer_wrap {
	width: 100%;
	margin: 40px 0
}

.career-card {
	background: white;
	padding: 30px;
	border-top: solid 5px #003767;
	max-width: 410px;
}

.career-grid {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	grid-gap: 20px;
}

.career-card__location,
.career-card__expiry {
  font-size: 16px;
  line-height: 1.4;
	font-weight: 500;
  margin: 0 0 6px; /* tighten gap between location and date */
}

/* Optional: make location a bit more structured next to icon */
.career-card__location {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

/* Map pin icon */
.career-card__icon--location {
  display: inline-block;
  width: 16px;
  height: 16px;
  background-size: contain;
  background-repeat: no-repeat;
  background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' fill='none' stroke='%23000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0Z'/%3E%3Ccircle cx='12' cy='10' r='3'/%3E%3C/svg%3E");
  opacity: 0.85;
}

.career-card__link {
	margin-bottom: 0;
	margin-top: 30px;
}

/* Layout */
.career-primary-content {
  padding: 60px 0;
}

@media(max-width: 767px) {
	.career-primary-content {
		padding: 40px 0;
	}
}

.career-layout {
  display: flex;
  flex-wrap: wrap;
  gap: 40px;
  align-items: flex-start;
}

.career-main {
  flex: 1 1 60%;
  min-width: 0;
	max-width: 100%;
}

.career-sidebar {
  flex: 1 1 30%;
	width: 100%;
  min-width: 260px;
}

@media(min-width: 1024px) {
	.career-sidebar {
		position: sticky;
		top: 120px;
	}
}

/* Breadcrumb */
.career-breadcrumb {
  font-size: 14px;
  margin-bottom: 16px;
}

.career-breadcrumb a {
  text-decoration: none;
  color: #666;
}

.career-breadcrumb a:hover {
  text-decoration: underline;
}

/* Meta row */
.career-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}

.career-meta__item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: #555;
}

.career-meta__label {
  font-weight: 600;
}

.career-meta__value {
  font-weight: 400;
}

/* Map pin icon */
.career-meta__icon--location {
  display: inline-block;
  width: 18px;
  height: 18px;
  background-size: contain;
  background-repeat: no-repeat;
  background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' fill='none' stroke='%23000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0Z'/%3E%3Ccircle cx='12' cy='10' r='3'/%3E%3C/svg%3E");
  opacity: 0.8;
}

/* Body content */
.career-body {
  background: #ffffff;
  padding: 40px;
  border-radius: 0;
  box-shadow: 0 8px 20px rgba(0,0,0,0.04);
  font-size: 16px;
  line-height: 1.6;
  color: #333;
}

@media(max-width: 767px) {
	.career-body {
  	padding: 25px;
		max-width: 100%;
	}
	
	.career-body h2 {
		font-size: 30px!important;;
	}
	
	.gform-theme--foundation .gform_fields {
		grid-template-columns: unset!important;
	}
}

/* Sidebar summary card */
.career-summary-card {
  background: #ffffff;
  border-radius: 0;
  padding: 40px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.04);
}

@media(max-width: 767px) {
	.career-summary-card { 
		padding: 25px;
	}
}

.career-summary-card__title {
  font-size: 18px;
  margin: 0 0 16px;
}

.career-summary-card__list {
  list-style: none;
  margin: 0 0 16px;
  padding: 0;
}

.career-summary-card__item {
  display: flex;
  flex-direction: column;
  margin-bottom: 8px;
}

.career-summary-card__label {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #888;
  margin-bottom: 2px;
}

.career-summary-card__value {
  font-size: 15px;
  font-weight: 600;
  color: #222;
}

.career-summary-card__actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
}

.career-summary-card__back {
  font-size: 14px;
  color: #555;
  text-decoration: none;
}

.career-summary-card__back:hover {
  text-decoration: underline;
}

/* Apply block */
.career-apply-block {
  margin-top: 40px;
  background: #ffffff;
  padding: 40px;
  border-radius: 0;
  box-shadow: 0 8px 20px rgba(0,0,0,0.04);
}

@media(max-width: 767px) {
	.career-apply-block {
		padding: 20px;
		position: relative;
	}
	#gform_fields_34 {
		grid-template-columns: unset;
	}
}

.career-apply-block h2 {
  margin-top: 0;
  margin-bottom: 8px;
}

.career-apply-intro {
  margin-bottom: 20px;
  font-size: 15px;
  color: #555;
}


/* Responsive */
@media (max-width: 991px) {
  .career-layout {
    flex-direction: column;
  }

  .career-sidebar {
    order: -1;
  }
}

.career-card__title {
		font-size: 24px;
	}

@media(max-width: 767px) {
	.career-card__title {
		line-height: 1.2em;
	}
}

.career-body h2 {
	font-size: 50px;
}

@media(max-width: 767px) {
.career-body h2 {
	font-size: 40px;
}
}

.gfield--input-type-fileupload .gfield_label {
	display: block!important;
}

#gform_35 .gform_fields {
	grid-gap: 25px!important;
}

.single-career .inner_banner_sec figure {
	background: #003767;
	background-image: unset!important;
	min-height: 300px;
}

@media(min-width: 1024px) {
	.single-career .inner_banner_sec .banner_text {
	max-width: 1300px!important;
	margin: 0 auto;
}
}

@media(max-width: 1024px) {
	.single-career .inner_banner_sec figure {
	min-height: 200px;
}
}

#gform_35 input:not(input[type="submit"]):not(input[type="file"]) {
	  padding: 17px !important;
    font-size: 14px !important;
    color: #003767 !important;
    font-family: 'Oxygen' !important;
    border-radius: 0;
    border: 1px solid #A7A9AC;
    text-transform: uppercase;
    letter-spacing: 1.4px !important;
    width: 100% !important;
		line-height: 1.5;
		min-height: 50px;
}

#gform_submit_button_35 {
	width: 160px;
    font-size: 16px;
    letter-spacing: 1px;
    font-weight: 400;
    padding: 20px;
    text-transform: uppercase;
    margin-right: 0;
    border-radius: 0;
    background-color: #88A3BA;
    border: none;
    color: #fff;
    cursor: pointer;
	transition: ease .3s;
}

#gform_submit_button_35:hover {
	background: #002C52;
}

.gform_required_legend {
	display: none;
}

html {
    scroll-behavior: smooth;
}


.gfield input {
	text-align: left;
	line-height: 1.5em!important;
	min-height: 55px!important;
	font-size: 14px!important;
	color: #003767 !important;
  text-transform: uppercase!important;
	border-radius: 0!important;
  letter-spacing: 1.4px!important;
	outline: none!important;
}

.gform_fields  {
	grid-gap: 15px 12px!important;
}

.gform_button {
    font-size: 16px!important;
		border-radius: 0!important;
    letter-spacing: 1px!important;
    font-weight: 400!important;
    padding: 20px!important;
    text-transform: uppercase!important;
    margin-right: 0;
    border-radius: 0;
    background-color: #88A3BA!important;
    border: none;
    color: #fff;
    cursor: pointer;
}

.gform-footer input {
	min-width: 100%!important;
}

@media(min-width: 1024px) {
	.my-popup .download_gallery_text {
		padding: 20px 50px 50px 50px;
	}
}

.gform-loader {
	margin: 20px auto 0 auto!important;
}

/* Page Banner Style Overrides */

.home .banner-sec-wrap {
	flex-direction: column;
	display: flex;
	grid-gap: 10px;
	justify-content: flex-end;
	padding-bottom: 60px;
}

.home .banner-sec-wrap a {
	max-width: fit-content;
}

.home .banner-sec-wrap .sec-btn:visited {
	color: white;
}

.home .banner-sec-wrap .sec-btn:hover {
	color: #002C52;
}

.sec-btn {
	background: transparent;
	color: white;
}

.white-btn {
	transition: ease .2s!important;
}

.sec-btn:hover {
	background: white;
	color: #191970;
}

.gform-footer input {
	min-width: 100%!important;
}

@media(min-width: 1024px) {
	.my-popup .download_gallery_text {
		padding: 20px 50px 50px 50px;
	}
}

.gform-loader {
	margin: 20px auto 0 auto!important;
}

#gform_ajax_spinner_36 {
	display: none!important;
}

.my-popup .gform_submission_error, .my-popup .gfield_validation_message {
	color: white!important;
}

.my-popup .gform_validation_errors .gform-icon {
	background: white!important;
}

.gform_confirmation_message_36  {
	font-size: 16px!important;
}

.request_form .gform_legacy_markup_wrapper ul.gform_fields {
	gap: 0!important;
}

.urban-sold-overlay {
	height: 13.7%!important;
	font-size: 35px!important;
	letter-spacing: 2px!important;
}

.video_bg_img {
	background-position: center;
}

.inner_banner_slide-wrapper .banner_bg {
	    background-position: center 80%;
}

.section_primary_content {
	padding-top: 100px;
}

.section_primary_content h2 {
	font-size: 35px;
	margin-bottom: 30px!important;
}
@media(max-width: 767px) {
	.section_primary_content {
		padding-top: 50px;
	}
	.section_primary_content h2 {
		font-size: 25px;
	}
}

@media(min-width: 767px) {
	.design_build_category .design_category_text {
		padding-right: 60px;
	}
}

.design_build_category figure, .design_build_category .col-6 {
	align-items: center;
	display: flex;
	justify-content: flex-end;
}

.page-id-222 .design_category_sec > .container .design_build_category:first-child, .page-id-30803 .design_category_sec > .container .design_build_category:first-child {
	background: #003767!important;
	color: #ffffff!important
}

.page-id-222 .design_category_sec > .container .design_build_category:first-child h3, .page-id-30803 .design_category_sec > .container .design_build_category:first-child h3 {
	color: white;
}

.page-id-222 .design_category_sec > .container .design_build_category:first-child .blue_btn, .page-id-30803 .design_category_sec > .container .design_build_category:first-child .blue_btn, .white_btn {
	background: #ffffff!important;
	color: #003767!important;
	border: none!important;
}


.page-id-222 .design_category_sec > .container .design_build_category:first-child .blue_btn:hover, .page-id-30803 .design_category_sec > .container .design_build_category:first-child .blue_btn:hover, .white_btn:hover {
	opacity: 0.7;
}

.inspired_reality_sec {
	background-position: center;
}

.inspired_reality_sec .inspired_wrap {
	width: 100%;
}

.inspired_reality_sec .inspired_wrap h3 {
	max-width: 580px;
}

.footer_banner {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 50px;
}

.footer_banner h3 {
	font-size: 28px;
}

.celebrating-20-badge {
	max-width: 100px;
	margin-right: 75px;
}

section.plain_text_sec {
	padding-top: 100px;
	padding-bottom: 0;
}

@media(max-width: 767px) {
	.celebrating-20-badge {
		margin-right: unset;
	}
	
	.logo_award_wrap {
		flex-direction: column;
		gap: 20px;
	}
	
	section.plain_text_sec {
		padding-top: 50px;
	}
}

.footer_logo {
	max-width: 190px;
}

/* Banner slider: mobile "Play Video" button.
   Sits directly beneath the existing mobile button(s) in .title
   and inherits size, padding and type from .button.white-btn.
   Only the fill and border are changed to give the outlined look. */

.banner_sec .title .play-video-btn {
	display: flex;        /* block-level, so it drops onto its own line under the button above */
	width: fit-content;   /* but only as wide as its content, same as the other button */
	align-items: center;
	justify-content: center;
	gap: 10px;
	margin-top: 12px;     /* gap between buttons, tweak to taste */
	background: transparent;
	border: 1px solid #fff;
	color: #fff;
}

.banner_sec .title .play-video-btn:hover,
.banner_sec .title .play-video-btn:focus {
	background: #fff;
	color: #1c2b3a; /* match the site's dark text colour */
}

/* Small play triangle, CSS only */
.banner_sec .title .play-video-btn .play-video-icon {
	width: 0;
	height: 0;
	border-top: 5px solid transparent;
	border-bottom: 5px solid transparent;
	border-left: 8px solid currentColor;
}

/* Belt and braces: never let it show on desktop/tablet, even if a
   generic .button rule sets display. Match the theme's mob-visible breakpoint. */
@media (min-width: 768px) {
	.banner_sec .title .play-video-btn {
		display: none !important;
	}
}
</style>
