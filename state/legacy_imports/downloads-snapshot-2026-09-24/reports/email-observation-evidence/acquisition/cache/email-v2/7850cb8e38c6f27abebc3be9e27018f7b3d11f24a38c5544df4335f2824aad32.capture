w, http://skilledelectrical.co.nz/wp-content/uploads/2026/03/builderscrack-reviews-logo-24x8.png 24w, http://skilledelectrical.co.nz/wp-content/uploads/2026/03/builderscrack-reviews-logo-36x13.png 36w, http://skilledelectrical.co.nz/wp-content/uploads/2026/03/builderscrack-reviews-logo-48x17.png 48w" sizes="auto, (max-width: 350px) 100vw, 350px" /></a></div><div data-bb-version="5.6.8" class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_none bt_bb_bottom_spacing_small" data-bt-override-class="{&quot;bt_bb_top_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_top_spacing_none&quot;,&quot;def&quot;:&quot;none&quot;},&quot;bt_bb_bottom_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_bottom_spacing_small&quot;,&quot;def&quot;:&quot;small&quot;}}"></div><div data-bb-version="5.6.8" class="bt_bb_image bt_bb_shape_soft-rounded bt_bb_target_self bt_bb_align_left bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" style="max-height: 61px; max-width: 175px;" data-bt-override-class="{&quot;bt_bb_align_&quot;:{&quot;current_class&quot;:&quot;bt_bb_align_left&quot;,&quot;def&quot;:&quot;left&quot;},&quot;bt_bb_content_display_&quot;:{&quot;current_class&quot;:&quot;bt_bb_content_display_always&quot;,&quot;def&quot;:&quot;always&quot;},&quot;bt_bb_animation_&quot;:{&quot;current_class&quot;:&quot;bt_bb_animation_no_animation&quot;,&quot;def&quot;:&quot;no_animation&quot;}}"><a href="https://www.topreviews.co.nz/best-electricians-christchurch/"  target="_self" title="top-reviews-nz-logo"><img loading="lazy" decoding="async" width="350" height="122" src="http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo.png" class="attachment-full size-full" alt="http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo.png" title="top-reviews-nz-logo" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo.png 350w, http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo-320x112.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo-24x8.png 24w, http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo-36x13.png 36w, http://skilledelectrical.co.nz/wp-content/uploads/2026/03/top-reviews-nz-logo-48x17.png 48w" sizes="auto, (max-width: 350px) 100vw, 350px" /></a></div></div></div></div><div  class="bt_bb_column col-xxl-3 col-xl-3 col-xs-12 col-sm-12 col-md-12 col-lg-3 bt_bb_vertical_align_top bt_bb_align_left bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div  class="bt_bb_text" ><div class="paragraph">
