			<div class="btContent">
			<div data-rocket-location-hash="58ad7f8002e09446b1e1769b38603883" class="bt_bb_wrapper" data-templates-time=""><section data-bb-version="5.6.8" id="bt_bb_section6a9fd86ff0a97" class="bt_bb_section bt_bb_color_scheme_5 bt_bb_layout_boxed_1200 bt_bb_vertical_align_middle bt_bb_background_overlay_dark_gradient bt_bb_top_spacing_extra_large bt_bb_bottom_spacing_large bt_bb_background_overlay_dark_gradient" style="; --section-primary-color:#111112; --section-secondary-color:#d4a017;" data-bt-override-class="{&quot;bt_bb_top_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_top_spacing_extra_large&quot;,&quot;def&quot;:&quot;extra_large&quot;},&quot;bt_bb_bottom_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_bottom_spacing_large&quot;,&quot;def&quot;:&quot;large&quot;},&quot;bt_bb_animation_&quot;:{&quot;current_class&quot;:&quot;bt_bb_animation_no_animation&quot;,&quot;def&quot;:&quot;no_animation&quot;}}"><div class="bt_bb_background_image_holder_wrapper"><div class="bt_bb_background_image_holder btLazyLoadBackground bt_bb_parallax"  data-background_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2026/03/skilled-electrical-team-2026.jpg" data-parallax=".7" data-parallax-offset="0" data-parallax-zoom-start="1" data-parallax-zoom-end="1" data-parallax-blur-start="0" data-parallax-blur-end="0" data-parallax-opacity-start="1" data-parallax-opacity-end="1" style=" background-image: url(&#039;http://skilledelectrical.co.nz/wp-content/plugins/bold-page-builder/img/blank.gif&#039;);"></div></div><div class="bt_bb_port"><div class="bt_bb_cell"><div class="bt_bb_cell_inner"><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-12 col-xl-12 col-xs-12 col-sm-12 col-md-12 col-lg-12 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:12;" data-width="12" data-bt-override-class="{&quot;bt_bb_align_&quot;:{&quot;current_class&quot;:&quot;bt_bb_align_left&quot;,&quot;def&quot;:&quot;left&quot;,&quot;xl&quot;:&quot;left&quot;}}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_medium" data-bt-override-class="null"></div><header data-bb-version="5.6.8" class="bt_bb_headline bt_bb_color_scheme_6 bt_bb_dash_none bt_bb_size_extralarge bt_bb_align_center" style="; --headline-primary-color:#ffffff; --headline-secondary-color:#d4a017;" data-bt-override-class="{&quot;bt_bb_size_&quot;:{&quot;current_class&quot;:&quot;bt_bb_size_extralarge&quot;,&quot;def&quot;:&quot;extralarge&quot;},&quot;bt_bb_align_&quot;:{&quot;current_class&quot;:&quot;bt_bb_align_center&quot;,&quot;def&quot;:&quot;center&quot;}}"><h1 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >ABOUT US - SKILLED ELECTRICAL</span></span></h1></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><header data-bb-version="5.8.0" class="bt_bb_headline bt_bb_color_scheme_6 bt_bb_dash_none bt_bb_size_medium bt_bb_align_center" style="; --headline-primary-color:#ffffff; --headline-secondary-color:#d4a017;" data-bt-override-class="{&quot;bt_bb_size_&quot;:{&quot;current_class&quot;:&quot;bt_bb_size_medium&quot;,&quot;def&quot;:&quot;medium&quot;},&quot;bt_bb_align_&quot;:{&quot;current_class&quot;:&quot;bt_bb_align_center&quot;,&quot;def&quot;:&quot;center&quot;}}"><h4 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >It's not easy finding a reliable electrician. <br />
That's why we exist, to show you they're out there.</span></span></h4></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_large" data-bt-override-class="null"></div></div></div></div></div></div></div><!-- cell_inner --></div><!-- cell --></div><!-- port --></section><section id="bt_bb_section6a9fd86ff12a9" class="bt_bb_section bt_bb_layout_boxed_1200 bt_bb_vertical_align_top bt_bb_background_overlay_light_gradient bt_bb_top_spacing_medium bt_bb_background_overlay_light_gradient"  data-bt-override-class="null"><div class="bt_bb_background_image_holder_wrapper"><div class="bt_bb_background_image_holder bt_bb_parallax"  data-parallax="0.5" data-parallax-offset="0" data-parallax-zoom-start="1" data-parallax-zoom-end="1" data-parallax-blur-start="0" data-parallax-blur-end="0" data-parallax-opacity-start="1" data-parallax-opacity-end="1" style=" background-image:url(&#039;http://skilledelectrical.co.nz/wp-content/uploads/2018/10/background_grayscale_03.jpg&#039;);"></div></div><div class="bt_bb_port"><div class="bt_bb_cell"><div class="bt_bb_cell_inner"><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-6 col-xl-6 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal bt_bb_animation_fade_in animate" style="; --column-width:6;" data-width="6" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_icon bt_bb_color_scheme_3 bt_bb_style_borderless bt_bb_size_xlarge bt_bb_shape_circle bt_bb_target_self bt_bb_text_empty bt_bb_align_inherit" style="; --primary-color:#d4a017; --secondary-color:#111112;" data-bt-override-class="{}"><a href="#"  target="_self"   data-ico-fontawesome="&#xf10d;" class="bt_bb_icon_holder"></a></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_color_scheme_5 bt_bb_dash_none bt_bb_size_large bt_bb_align_inherit" style="; --headline-primary-color:#111112; --headline-secondary-color:#d4a017;" data-bt-override-class="{}"><h3 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >Our <b>genuine goal</b> in the industry is <b>to make the world a happier place</b> through building an exceptional business.<br />
</span></span></h3></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><div class="bt_bb_icon bt_bb_color_scheme_3 bt_bb_style_borderless bt_bb_size_xlarge bt_bb_shape_circle bt_bb_target_self bt_bb_text_empty bt_bb_align_right" style="; --primary-color:#d4a017; --secondary-color:#111112;" data-bt-override-class="{}"><a href="#"  target="_self"   data-ico-fontawesome="&#xf10e;" class="bt_bb_icon_holder"></a></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><div class=" bt_bb_row_inner bt_bb_column_inner_gap_0"   data-bt-override-class="{}"><div class="bt_bb_row_inner_holder"  ><div  class="bt_bb_column_inner col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_left bt_bb_padding_normal"  data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_inner_content"><div class="bt_bb_column_inner_content_inner"><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_medium bt_bb_subheadline bt_bb_align_inherit" data-bt-override-class="{}"><h4 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >Dean Wilson</span></span></h4><div class="bt_bb_headline_subheadline">Founder and General Manager</div></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column_inner col-xxl-9 col-xl-9 bt_bb_vertical_align_top bt_bb_align_left bt_bb_padding_normal"  data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_inner_content"><div class="bt_bb_column_inner_content_inner"></div></div></div></div></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-6 col-xl-6 bt_bb_vertical_align_bottom bt_bb_align_right bt_bb_padding_normal bt_bb_animation_fade_in animate" style="; --column-width:6;" data-width="6" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_ " style="height:690px; overflow: hidden;" data-bt-override-class="{}"><span><img fetchpriority="high" decoding="async" width="350" height="700" src="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Dean_4.png" class="attachment-full size-full" alt="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Dean_4.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Dean_4.png" title="Dean_4" loading="eager" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Dean_4.png 350w, http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Dean_4-320x640.png 320w" sizes="(max-width: 350px) 100vw, 350px" /></span></div></div></div></div></div></div></div><!-- cell_inner --></div><!-- cell --></div><!-- port --></section><section id="bt_bb_section6a9fd86ff1fe7" class="bt_bb_section bt_bb_layout_boxed_1200 bt_bb_vertical_align_middle"  data-bt-override-class="null"><div class="bt_bb_port"><div class="bt_bb_cell"><div class="bt_bb_cell_inner"><div class="bt_bb_row " style=" background-color: rgba(255, 255, 255, 1);" data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-12 col-xl-12 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:12;" data-width="12" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_large bt_bb_align_center" data-bt-override-class="{}"><h2 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >OUR VALUES</span></span></h2></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty.png" title="Values_Honesty" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Honesty.png 833w" sizes="(max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >HONESTY, INTEGRITY AND TRUST</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><p>Everyone who comes into contact with Skilled Electrical, Christchurch knows they can expect us to always operate with honesty, integrity and trust. We greatly respect the fact that people have entrusted us to do the job.</p>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional.png" title="Values_Professional" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Professional.png 833w" sizes="(max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >PROFESSIONAL AND CALM</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><p>We behave in a professional and respectful way towards others.  We take our job very seriously, yet we understand it’s not typically the end of the world if the original plan doesn’t come together.  We keep things in perspective.</p>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh.png" title="Values_Laugh" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Laugh.png 833w" sizes="(max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >STILL ROOM FOR A LAUGH</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><p>We have a light-hearted approach to what we do and like to inject a bit of fun into our day when the opportunity arises.  We always look to have a cheerful manner during our day and hopefully pass that on to others.​</p>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img loading="lazy" decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers.png" title="Values_Problem-Solvers" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Problem-Solvers.png 833w" sizes="auto, (max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >PRODUCTIVE PROBLEM SOLVERS</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><p>We take ownership of our tasks, jobs and projects.  We are there to solve our client’s/colleague’s issues and problems fast and efficiently.  When we are given that responsibility we understand that we are the only ones to make it happen.​</p>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img loading="lazy" decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High.png" title="Values_Aim-High" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Aim-High.png 833w" sizes="auto, (max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >WE AIM HIGH</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><p>We are always looking to see what we are capable off.  We aim to be among the best there is.  We are always taking our skills, our team and our business to the next level.​</p>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img loading="lazy" decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service.png" title="Values_Service" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Service.png 833w" sizes="auto, (max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >SERVICE FOCUSED</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><p>Our job is not just to be just technicians. Our goal is to provide our clients with the best service we can have them experience. At a minimum we want to meet their expectations, however we are always looking to exceed their expectations.</p>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img loading="lazy" decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate.png" title="Values_Communicate" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Communicate.png 833w" sizes="auto, (max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_top bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >WE COMMUNICATE</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><div class="paragraph">We understand that on almost all levels lack of communication results in problems on any job site. We believe that communication is key, and we will do our utmost to ensure everyone we deal with is communicated to regularly and understood.</div>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-3 col-xl-3 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:3;" data-width="3" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img loading="lazy" decoding="async" width="160" height="160" src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble-160x160.png" class="attachment-thumbnail size-thumbnail" alt="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble-160x160.png" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble.png" title="Values_Humble" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble-160x160.png 160w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble-640x640.png 640w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble-768x768.png 768w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble-320x320.png 320w, http://skilledelectrical.co.nz/wp-content/uploads/2021/01/Values_Humble.png 833w" sizes="auto, (max-width: 160px) 100vw, 160px" /></span></div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div><div  class="bt_bb_column col-xxl-9 col-xl-9 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal" style="; --column-width:9;" data-width="9" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_inherit bt_bb_align_inherit" data-bt-override-class="{}"><h6 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >WE ARE HUMBLE</span></span></h6></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div><div  class="bt_bb_text" ><div class="paragraph">And sometimes we might get it wrong. However, if on a particular occasion we do, we will bend over backwards to make it right, we will learn from the experience to ensure the same doesn’t happen again.</div>
</div><div class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_small" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row "  data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-12 col-xl-12 bt_bb_vertical_align_top bt_bb_align_left bt_bb_padding_normal" style="; --column-width:12;" data-width="12" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><div class="bt_bb_button bt_bb_color_scheme_6 bt_bb_icon_position_left bt_bb_style_filled bt_bb_size_normal bt_bb_width_inline bt_bb_shape_inherit bt_bb_target_self bt_bb_align_center" style="; --primary-color:#ffffff; --secondary-color:#d4a017;" data-bt-override-class="{&quot;bt_bb_size_&quot;:{&quot;current_class&quot;:&quot;bt_bb_size_normal&quot;,&quot;def&quot;:&quot;normal&quot;,&quot;xl&quot;:&quot;normal&quot;},&quot;bt_bb_align_&quot;:{&quot;current_class&quot;:&quot;bt_bb_align_center&quot;,&quot;def&quot;:&quot;center&quot;,&quot;xl&quot;:&quot;center&quot;}}"><a href="/projects" target="_self" class="bt_bb_link" title="Book a NO FRUSTRATIONS GUARANTEED Electrician Now"><span class="bt_bb_button_text" >Book a NO FRUSTRATIONS GUARANTEED Electrician Now</span></a></div></div></div></div></div></div></div><!-- cell_inner --></div><!-- cell --></div><!-- port --></section><section id="bt_bb_section6a9fd87001a19" class="bt_bb_section bt_bb_color_scheme_13 bt_bb_layout_boxed_1200 bt_bb_vertical_align_top bt_bb_top_spacing_medium bt_bb_bottom_spacing_medium" style="; --section-primary-color:#181818; --section-secondary-color:#f9f9f9;" data-bt-override-class="null"><div class="bt_bb_port"><div class="bt_bb_cell"><div class="bt_bb_cell_inner"><div class="bt_bb_row " style=" background-color: rgba(255, 255, 255, 1);" data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-12 col-xl-12 bt_bb_vertical_align_top bt_bb_align_center bt_bb_padding_normal" style="; --column-width:12;" data-width="12" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><header class="bt_bb_headline bt_bb_dash_none bt_bb_size_large bt_bb_align_center" data-bt-override-class="{}"><h2 class="bt_bb_headline_tag"><span class="bt_bb_headline_content"><span >OUR STORY</span></span></h2></header><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div></div></div></div></div></div><div class="bt_bb_row " style=" background-color: rgba(255, 255, 255, 1);" data-bt-override-class="{}"><div class="bt_bb_row_holder" ><div  class="bt_bb_column col-xxl-6 col-xl-6 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_30 bt_bb_animation_fade_in animate" style="; --column-width:6;" data-width="6" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div><div  class="bt_bb_text" ><p style="text-align: justify"><span style="color: #f25000">Skilled Electrical</span> was formed in September of 2009. Initially, it was Dean himself on the tools contracting to various companies throughout the South Island, often in the mining industry.</p>
<p style="text-align: justify"><span style="color: #f25000">The Christchurch earthquake</span> and the Pike River disaster were the catalysts for deciding to establish a full-blown contracting electrical company based in Christchurch, within Canterbury and the South Island.</p>
<p style="text-align: justify">Skilled Electrical currently has a team of approximately <span style="color: #f25000">27 technicians</span>, including 2 inspectors and 2 engineers within the group.</p>
</div></div></div></div><div  class="bt_bb_column col-xxl-6 col-xl-6 bt_bb_vertical_align_middle bt_bb_align_left bt_bb_padding_normal bt_bb_animation_fade_in animate" style="; --column-width:6;" data-width="6" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_column_content_inner"><div class="bt_bb_image bt_bb_shape_square bt_bb_target_self bt_bb_align_inherit bt_bb_hover_style_simple bt_bb_content_display_always bt_bb_content_align_middle bt_bb_inner_padding_15" data-bt-override-class="{}"><span><img loading="lazy" decoding="async" width="1600" height="1200" src="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1.jpg" class="attachment-full size-full" alt="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1.jpg" data-full_image_src="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1.jpg" title="Skilled_tshirt" srcset="http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1.jpg 1600w, http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1-640x480.jpg 640w, http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1-1280x960.jpg 1280w, http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1-768x576.jpg 768w, http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1-1536x1152.jpg 1536w, http://skilledelectrical.co.nz/wp-content/uploads/2020/12/Skilled_tshirt-1-320x240.jpg 320w" sizes="auto, (max-width: 1600px) 100vw, 1600px" /></span></div></div></div></div></div></div></div><!-- cell_inner --></div><!-- cell --></div><!-- port --></section><section data-bb-version="5.0.1" id="bt_bb_section6a9fd8700240a" class="bt_bb_section bt_bb_layout_boxed_1200 bt_bb_vertical_align_top bt_bb_top_spacing_medium bt_bb_bottom_spacing_none hidden-section" style="display: none;" data-bt-override-class="{&quot;bt_bb_top_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_top_spacing_medium&quot;,