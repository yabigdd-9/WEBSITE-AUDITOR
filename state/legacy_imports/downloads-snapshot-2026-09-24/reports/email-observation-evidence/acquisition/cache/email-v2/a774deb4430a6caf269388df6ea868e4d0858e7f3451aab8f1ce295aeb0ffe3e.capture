<style>
.skel-home, .skel-home * { box-sizing: border-box; }
.skel-home { margin: 0; background: #ffffff; font-family: 'Montserrat', system-ui, sans-serif; color: #17140f; }
.skel-home h1, .skel-home h2, .skel-home h3, .skel-home .display { font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; font-weight: 400; letter-spacing: 0.01em; margin: 0; text-transform: uppercase; }
.skel-home p { margin: 0; }
.skel-home a { color: #b69330; text-decoration: none; }
.skel-home a:hover { color: #8a6f24; }
.skel-home button { font-family: 'Montserrat', sans-serif; cursor: pointer; }
.skel-home .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
.skel-home .eyebrow { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: #b69330; }
.skel-home .rule { width: 64px; height: 4px; background: #d4a017; margin-top: 14px; }
.skel-home .rule.center { margin-left: auto; margin-right: auto; }
.skel-home .btn-gold { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: #d4a017; color: #17140f; font-weight: 800; font-size: 15px; letter-spacing: 0.03em; padding: 16px 30px; border-radius: 3px; border: none; text-transform: uppercase; transition: background 0.15s ease; }
.skel-home .btn-gold:hover { color: #ffffff; }
.skel-home .btn-outline { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: transparent; color: #ffffff; font-weight: 800; font-size: 15px; letter-spacing: 0.03em; padding: 15px 29px; border-radius: 3px; border: 1.5px solid #ffffff; text-transform: uppercase; transition: all 0.15s ease; }
.skel-home .btn-outline:hover { background: #ffffff; color: #17140f; }
.skel-home .icon-circle { width: 68px; height: 68px; min-width: 68px; border-radius: 50%; background: #17140f; display: flex; align-items: center; justify-content: center; }
.skel-home .card { background: #ffffff; border: 1px solid #e7e1d2; border-radius: 6px; padding: 28px; }
.skel-home .skel-faq-a { display: none; }
.skel-home .skel-faq-item--open .skel-faq-a { display: block; }
.skel-home .skel-faq-item--open .skel-faq-icon { transform: rotate(180deg); }
.skel-home .hero-h1 { font-size: 76px; line-height: 0.98; max-width: 920px; }
.skel-home .hero-sub { font-size: 19px; }
.skel-home .section-h2 { font-size: 44px; }
.skel-home .stat-row { display: flex; align-items: baseline; }
.skel-home .stat-hero { font-size: 104px; }
.skel-home .stat-grid { display: flex; justify-content: center; flex-wrap: wrap; }
.skel-home .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); }
.skel-home .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); }
.skel-home .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); }
.skel-home .grid-5 { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); }
.skel-home .grid-split { display: grid; grid-template-columns: 1.1fr 1fr; }
@media (max-width: 900px) {
  .skel-home .hero-h1 { font-size: 58px; }
  .skel-home .grid-3, .skel-home .grid-4 { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .skel-home .grid-5 { grid-template-columns: repeat(3, minmax(0,1fr)); }
  .skel-home .grid-split { grid-template-columns: 1fr; }
  .skel-home .stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px 16px; }
}
@media (max-width: 640px) {
  .skel-home .wrap { padding: 0 20px; }
  .skel-home .hero-h1 { font-size: 48px; line-height: 1.05; }
  .skel-home .hero-sub { font-size: 16px; }
  .skel-home .section-h2 { font-size: 30px; }
  .skel-home .stat-row { flex-wrap: wrap; }
  .skel-home .stat-hero { font-size: 56px; }
  .skel-home .stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px 16px; }
  .skel-home .grid-2, .skel-home .grid-3, .skel-home .grid-4, .skel-home .grid-split { grid-template-columns: 1fr; }
  .skel-home .grid-5 { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
</style>

