# Ignore raw data snapshots
data/raw/*
!data/raw/.gitignore

# Ignore large parquet files
data/parquet/*/*.parquet
!data/parquet/.gitignore

# Ignore DuckDB database
data/warehouse/*.duckdb
!data/warehouse/.gitignore

# Ignore temporary downloads and caches
data/cache/*
!data/cache/.gitignore
data/tmp/*
!data/tmp/.gitignore

# Ignore artifacts that are large
data/artifacts/*/*.json
!data/artifacts/.gitignore
# Ignore virtual environments, dependencies, and large local files
.venv/
.venv-email/
node_modules/
database/*.db
database/*.db-shm
database/*.db-wal
__pycache__/
*.pyc

# Secrets / local environment
.env
.env.*
!.env.example
backups/**/.env

# Secrets / environment files
.env
.env.*
!.env.example
backups/**/.env
