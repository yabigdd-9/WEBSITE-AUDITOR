# Caches / builds
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.DS_Store
*.log

# Virtual environments
venv/
.venv*/
.venv-auditor/
.venv-email/
backups/
WEBSITES/BUISNESSaudits/runs/

# Secrets / credentials (NEVER track)
.env
.env.*
!.env.example
*.pem
id_rsa
id_rsa.*
service-account*.json
*credentials*
*secret*

# Local state / outputs
# Nightly baseline snapshots are intentionally persisted by CI so the watchdog
# can compare one run with the next. All other generated outputs remain ignored.
outputs/*
!outputs/snapshots/
!outputs/snapshots/**
audits/
*.db
*.db-shm
*.db-wal

/.venv-email
state/worker-logs/
state/dead-letter/
state/worker-heartbeats/
state/supervisor.pid
state/supervisor.heartbeat
*.sqlite
*.sqlite-shm
*.sqlite-wal
node_modules/

# Generated human-facing Obsidian operator workspace
WEBSITE-AUDITOR-BRAIN/

# Ignore .env files in any subdirectory
**/.env
**/.env.*
!**/.env.example

# Runtime state (regenerated; never track).
state/errors.jsonl
state/health.json
state/metrics.jsonl
state/deployments.jsonl
state/HERMES_EXECUTION_STATE.yaml
reports/acceptance-results.json
state/
