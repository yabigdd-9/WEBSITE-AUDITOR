#!/bin/sh
set -eu
MM_COMMAND_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MM_PYTHON="$MM_COMMAND_DIR/.venv-email/bin/python"
if [ ! -x "$MM_PYTHON" ]; then
    echo "BLOCKED: Python email environment missing. See requirements-email.txt and reports/EMAIL_FINDER_V2_IMPLEMENTATION.md." >&2
    exit 2
fi
exec "$MM_PYTHON" "$MM_COMMAND_DIR/scripts/mm_operator.py" "$@"
