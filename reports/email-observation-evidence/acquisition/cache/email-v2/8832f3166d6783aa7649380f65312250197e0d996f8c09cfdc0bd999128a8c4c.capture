 <script>
document.addEventListener("DOMContentLoaded", function () {
	const tabs = document.querySelectorAll(".tab-link");
	const tabContents = document.querySelectorAll(".tab-content");

	function activateTab(tabId) {
		tabs.forEach((tab) => {
			if (tab.getAttribute("data-tab") === tabId) {
				tab.classList.add("current");
			} else {
				tab.classList.remove("current");
			}
		});

		tabContents.forEach((content) => {
			if (content.id === tabId) {
				content.style.display = "block";
			} else {
				content.style.display = "none";
			}
		});
	}

	// Handle tab click
	tabs.forEach((tab) => {
		tab.addEventListener("click", function () {
			const tabId = this.getAttribute("data-tab");
			activateTab(tabId);

			// Update URL parameter
			const url = new URL(window.location);
			url.searchParams.set("tab", tabId);
			window.history.replaceState({}, "", url);
		});
	});

	// On page load: check URL and activate correct tab
	const urlParams = new URLSearchParams(window.location.search);
	const initialTab = urlParams.get("tab") || "show-homes"; // fallback to default tab
	activateTab(initialTab);
});
</script>
 
<script>
document.addEventListener("DOMContentLoaded", function () {
  const pathname = window.location.pathname.toLowerCase();
  const fullUrl = window.location.href.toLowerCase();
  let region = null;

  // Only run on pages under /locations/
  if (pathname.startsWith("/locations/")) {
    if (fullUrl.includes("waikato")) {
      region = "Waikato";
    } else if (fullUrl.includes("thames-coromandel")) {
      region = "Thames and Coromandel";
    } else if (fullUrl.includes("rotorua")) {
      region = "Rotorua";
    }

    if (region) {
      // Set localStorage
      localStorage.setItem("selected_region", region);

      // Build URL and set cookie
      const targetUrl = new URL("https://urban.co.nz/house-and-land-packages/");
      targetUrl.searchParams.set("region", region);

      document.cookie = "back_to_listing_url=" + encodeURIComponent(targetUrl.toString()) + "; path=/; max-age=" + (60 * 60 * 24); // 1 day
    }
  }
});
</script>

