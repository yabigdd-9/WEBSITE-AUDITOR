 def rotate_logs(log_dir: Path = LOG_DIR, max_size_mb: int = 50, retention_days: int = 30) -> list[str]:
+    if max_size_mb <= 0 or retention_days <= 0:
+        raise ValueError('Log size and retention limits must be positive')
     rotated = []
