-
-# ---------------------------------------------------------------------------
-# Schema vs visible comparison
-# ---------------------------------------------------------------------------
-
-
-def compare_schema_to_visible(
-    schema_name: str = "",
-    schema_address: NormalizedAddress | None = None,
-    schema_phone: NormalizedPhone | None = None,
-    schema_hours: list[OpeningHour] | None = None,
