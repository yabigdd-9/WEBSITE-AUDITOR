-    tool_name: str
-    args: dict[str, Any] = field(default_factory=dict)
-    result_summary: str = ""
-    duration_ms: int = 0
-    blocked: bool = False
-    block_reason: str = ""
-
-
-# ---------------------------------------------------------------------------
-# Failure record
-# ---------------------------------------------------------------------------
-
-
-@dataclass(frozen=True)
-class EvalFailure:
-    """A deterministic or graded failure within an evaluation run."""
-
-    failure_class: FailureClass
-    case_id: str
-    grader: str
-    message: str
