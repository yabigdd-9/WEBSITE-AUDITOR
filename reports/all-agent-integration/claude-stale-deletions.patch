-        required = set()
-        if expected:
-            required.update(expected.tools_must_use)
-
-        if not required:
-            return "PASS"
-
-        used = {tc.tool_name for tc in result.tool_calls if not tc.blocked}
-        missing = required - used
-        if missing:
-            result.add_failure(
-                EvalFailure(
