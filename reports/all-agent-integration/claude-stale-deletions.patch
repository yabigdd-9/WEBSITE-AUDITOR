-
-# ---------------------------------------------------------------------------
-# EvalResult — graded output for a single case
-# ---------------------------------------------------------------------------
-
-
-@dataclass
-class EvalResult:
-    """The graded result for one EvalCase execution."""
-
-    case_id: str
-    run_id: str
-    overall: GraderVerdict = "N/A"
-    grader_verdicts: dict[str, GraderVerdict] = field(default_factory=dict)
