-
-
-class ReplayRunner:
-    """Manages frozen replay snapshots and verifies hashes before execution."""
-
-    def __init__(
-        self,
-        runner: EvalRunner,
-        snapshot_dir: Path | None = None,
-    ):
-        self.runner = runner
-        self.snapshot_dir = snapshot_dir
-        self._snapshots: dict[str, ReplaySnapshot] = {}
-
-    def create_snapshot(
-        self,
-        snapshot_id: str,
