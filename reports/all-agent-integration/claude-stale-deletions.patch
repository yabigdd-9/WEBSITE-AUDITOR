-
-    try:
-        import inspect_ai
-
-        versions["inspect_ai"] = getattr(inspect_ai, "__version__", "unknown")
-    except ImportError:
-        pass
-
-    try:
-        versions["python"] = f"{__import__('sys').version_info.major}.{__import__('sys').version_info.minor}.{__import__('sys').version_info.micro}"
