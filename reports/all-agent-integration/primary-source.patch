+        with _db() as d:
+            row = d.execute(
+                "SELECT count(*) FROM mm_messages WHERE sent_at IS NOT NULL OR send_receipt IS NOT NULL"
+            ).fetchone()
+        assert row[0] == 0, f"Found {row[0]} sent messages"
+
+    def test_no_proposals_sent(self):
