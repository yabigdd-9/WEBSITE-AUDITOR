+"""Post-approval send planning regressions using disposable local evidence only."""
+import datetime as dt
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import mm_approval as approval
+import mm_core as core
+import mm_evidence_bridge as bridge
+import test_pipeline as fixture
+
+
+class SendPlanRevalidation(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.d = fixture.fresh_db(self.tmp.name)
+        self.bid = fixture.add_business(self.d)
+        fixture.ApprovalEngine._fully_evidence(self)
+        self.address = 'office@fixture.example.co.nz'
+        self.body = 'Subject: fix\n\nFixture body.'
+        self.campaign = 'synthetic-campaign'
+        self.approval_id = approval.request_approval(self.d, self.bid)
+        result = approval.decide(self.d, self.approval_id, 'reviewer-fixture',
+                                 'Synthetic exact-content review')
+        self.assertEqual(result['status'], 'APPROVED')
+
+    def tearDown(self):
+        self.d.close()
+        self.tmp.cleanup()
+
+    def plan(self):
+        return approval.plan_send(self.d, self.bid, self.address, self.body, self.campaign)
+
+    def suppress(self):
+        # Deliberately retain the older approval record, matching the production
+        # trigger's scope: mm_messages approvals are revoked, approval_records stay.
+        self.d.execute('INSERT INTO mm_suppression VALUES(?,?,?)',
+                       ('  OFFICE@fixture.example.co.nz  ', 'unsubscribe', core.now()))
+
+    def assert_blocked(self, reason, *, existing=0):
+        with self.assertRaisesRegex(ValueError, reason):
+            self.plan()
+        self.assertEqual(self.d.execute(
+            'SELECT count(*) FROM outreach_send_ledger').fetchone()[0], existing)
+
+    def test_approved_then_unsubscribe_cannot_create_plan(self):
+        self.suppress()
+        self.assert_blocked('Suppressed recipient')
+        self.assertEqual(self.d.execute(
+            'SELECT status FROM approval_records WHERE id=?',
+            (self.approval_id,)).fetchone()[0], 'APPROVED')
+
+    def test_pending_replay_after_unsubscribe_is_blocked(self):
+        original = self.plan()
+        self.suppress()
+        self.assert_blocked('Suppressed recipient', existing=1)
+        self.assertEqual(self.d.execute(
+            'SELECT status FROM outreach_send_ledger WHERE idempotency_key=?',
+            (original['idempotency_key'],)).fetchone()[0], 'planned')
+
+    def test_business_hold_added_after_approval_blocks_plan(self):
+        self.d.execute('INSERT INTO mm_holds VALUES(?,?)', (self.bid, 'manual hold'))
+        self.assert_blocked('Suppressed business')
+
+    def test_legacy_do_not_contact_added_after_approval_blocks_plan(self):
+        self.d.execute('INSERT INTO contacts(address_or_channel,do_not_contact) VALUES(?,1)', (self.address,))
+        self.assert_blocked('Suppressed recipient')
+
+    def test_recipient_permission_withdrawal_blocks_pending_replay(self):
+        self.plan()
+        self.d.execute("UPDATE mm_contact_evidence SET unsubscribe_state='unsubscribed'")
+        self.assert_blocked('CONTACT_PERMISSION_REQUIRED', existing=1)
+
+    def test_consent_expiry_blocks_plan(self):
+        stale = (dt.datetime.now(core.UTC) - dt.timedelta(days=8)).isoformat()
+        self.d.execute('UPDATE mm_contact_evidence SET checked_at=?', (stale,))
+        self.assert_blocked('fresh recipient source capture required')
+
+    def test_future_contact_evidence_blocks_plan(self):
+        future = (dt.datetime.now(core.UTC) + dt.timedelta(days=1)).isoformat()
+        self.d.execute('UPDATE mm_contact_evidence SET checked_at=?', (future,))
+        self.assert_blocked('fresh recipient source capture required')
+
+    def test_modified_contact_capture_blocks_plan(self):
+        path = self.d.execute('SELECT capture_path FROM mm_contact_evidence').fetchone()[0]
+        Path(path).write_text('Modified after approval')
+        self.assert_blocked('fresh recipient source capture required')
+
+    def audit_path(self):
+        return Path(self.d.execute(
+            'SELECT report_path FROM mm_audit_evidence WHERE business_id=?',
+            (self.bid,)).fetchone()[0])
+
+    def test_deleted_audit_after_approval_blocks_new_plan(self):
+        self.audit_path().unlink()
+        self.assert_blocked('AUDIT_EVIDENCE_REQUIRED: MISSING')
+
+    def test_deleted_audit_blocks_pending_replay(self):
+        self.plan()
+        self.audit_path().unlink()
+        self.assert_blocked('AUDIT_EVIDENCE_REQUIRED: MISSING', existing=1)
+
+    def test_modified_audit_blocks_pending_replay(self):
+        self.plan()
+        path = self.audit_path()
+        path.write_text(path.read_text() + ' ')
+        self.assert_blocked('AUDIT_EVIDENCE_REQUIRED: INVALID', existing=1)
+
+    def test_modified_audit_artifact_blocks_pending_replay(self):
+        self.plan()
+        path = self.audit_path().with_name('report.html')
+        path.write_bytes(b'x' * path.stat().st_size)
+        self.assert_blocked('AUDIT_EVIDENCE_REQUIRED: INVALID', existing=1)
+
+    def test_expired_audit_blocks_pending_replay_with_fresh_contact(self):
+        self.plan()
+        class AuditClock(dt.datetime):
+            @classmethod
+            def now(cls, tz=None):
+                return super().now(tz) + dt.timedelta(days=8)
+        # Advance only the audit validator clock: contact remains genuinely
+        # current, and the saved report/anchor bytes remain unchanged.
+        with patch.object(bridge, 'dt', SimpleNamespace(datetime=AuditClock, timedelta=dt.timedelta)):
+            self.assert_blocked('AUDIT_EVIDENCE_REQUIRED: STALE', existing=1)
+
+    def test_unconfirmed_or_revoked_consent_blocks_plan(self):
+        for field, value in [('permission_basis', 'Unconfirmed'),
+                             ('permission_verified_by', ''), ('confidence', 0.6)]:
+            with self.subTest(field=field):
+                original = self.d.execute(
+                    f'SELECT {field} FROM mm_contact_evidence').fetchone()[0]
+                self.d.execute(f'UPDATE mm_contact_evidence SET {field}=?', (value,))
+                self.assert_blocked('current verified recipient permission required')
+                self.d.execute(f'UPDATE mm_contact_evidence SET {field}=?', (original,))
+
+    def test_consent_for_different_recipient_does_not_allow_plan(self):
+        self.d.execute("UPDATE mm_contact_evidence SET recipient='other@fixture.example.co.nz'")
+        self.assert_blocked('CONTACT_PERMISSION_REQUIRED')
+
+    def test_current_high_selection_change_blocks_plan(self):
+        self.d.execute("UPDATE email_verifications SET email='other@fixture.example.co.nz'")
+        self.assert_blocked('VERIFIED_RECIPIENT_REQUIRED')
+
+    def test_policy_rollback_after_approval_blocks_new_plan(self):
+        for mode in ('shadow', 'v1_hold'):
+            with self.subTest(mode=mode):
+                self.d.execute('UPDATE email_policy SET mode=?', (mode,))
+                self.assert_blocked('verification rollout not enabled')
+                self.d.execute("UPDATE email_policy SET mode='v2'")
+
+    def test_policy_rollback_blocks_pending_replay(self):
+        self.plan()
+        for mode in ('shadow', 'v1_hold'):
+            with self.subTest(mode=mode):
+                self.d.execute('UPDATE email_policy SET mode=?', (mode,))
+                self.assert_blocked('verification rollout not enabled', existing=1)
+                self.d.execute("UPDATE email_policy SET mode='v2'")
+
+    def assert_release_policy_blocks(self, *, existing=0):
+        for field, value in [('mode', 'POST_DEPLOYMENT_OBSERVATION'),
+                             ('verifier_version', 'obsolete-verifier')]:
+            with self.subTest(field=field):
+                original = self.d.execute(
+                    f'SELECT {field} FROM email_release_policy').fetchone()[0]
+                self.d.execute(f'UPDATE email_release_policy SET {field}=?', (value,))
+                self.assert_blocked('production email persistence is held', existing=existing)
+                self.d.execute(f'UPDATE email_release_policy SET {field}=?', (original,))
+
+    def test_release_policy_change_after_approval_blocks_new_plan(self):
+        self.assert_release_policy_blocks()
+
+    def test_release_policy_change_blocks_pending_replay(self):
+        self.plan()
+        self.assert_release_policy_blocks(existing=1)
+
+    def test_case_changed_recipient_cannot_use_approved_lowercase_digest(self):
+        self.d.execute("UPDATE email_verifications SET email='Office@fixture.example.co.nz'")
+        self.assert_blocked('exact published local-part casing')
+
+    def test_exact_published_local_part_casing_can_plan(self):
+        self.d.execute("UPDATE email_verifications SET email='Office@fixture.example.co.nz'")
+        self.address = 'Office@fixture.example.co.nz'
+        planned = self.plan()
+        self.assertEqual(planned['status'], 'planned')
+        self.assertEqual(planned['recipient'], self.address)
+
+    def test_pending_idempotent_replay_does_not_consume_daily_capacity(self):
+        original = self.plan()
+        for _ in range(approval.DAILY_SEND_CAP + 1):
+            self.assertEqual(self.plan(), original)
+        self.assertEqual(self.d.execute(
+            "SELECT count FROM rate_buckets WHERE bucket='outreach_send'").fetchone()[0], 1)
+
+    def assert_terminal_receipt_preserved(self, status):
+        planned = self.plan()
+        receipt = approval.record_result(self.d, planned['idempotency_key'],
+                                          status, provider_message_id='fixture-receipt')
+        self.suppress()
+        self.d.execute("UPDATE approval_records SET status='REJECTED'")
+        self.assertEqual(self.plan(), receipt)
+        self.assertEqual(self.d.execute(
+            'SELECT count(*) FROM outreach_send_ledger').fetchone()[0], 1)
+
+    def test_sent_provider_record_remains_readable_after_suppression(self):
+        self.assert_terminal_receipt_preserved('sent')
+
+    def test_bounced_provider_record_remains_readable_after_suppression(self):
+        self.assert_terminal_receipt_preserved('bounced')
+
+    def test_terminal_replay_remains_read_only_when_audit_is_missing(self):
+        for status in ('sent', 'bounced'):
+            with self.subTest(status=status):
+                # Each terminal receipt keeps its existing row. A replay has
+                # no authority to plan a second transmission.
+                if status == 'sent':
+                    receipt = self.recorded(status)
+                    self.audit_path().unlink()
+                else:
+                    receipt = approval.record_result(
+                        self.d, receipt['idempotency_key'], status,
+                        provider_message_id='fixture-receipt')
+                before = list(self.d.iterdump())
+                writes = self.d.total_changes
+                self.assertEqual(self.plan(), receipt)
+                self.assertEqual(list(self.d.iterdump()), before)
+                self.assertEqual(self.d.total_changes, writes)
+
+    def recorded(self, status, *, bounce=None):
+        planned = self.plan()
+        return approval.record_result(
+            self.d, planned['idempotency_key'], status,
+            provider_message_id='fixture-receipt', bounce=bounce,
+        )
+
+    def ledger_row(self, key):
