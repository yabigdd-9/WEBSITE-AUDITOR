+"""Regression coverage for bounded national discovery query rotation."""
+
+import datetime as dt
+import json
+from unittest.mock import patch
+
+import mm_recurring_discovery as recurring
+import pytest
+import yaml
+
+UTC = dt.timezone.utc
+
+
+def run_cycle(tmp_path, queries, *, state=None, sources=None, **options):
+    config = tmp_path / "schedule.yaml"
+    config.write_text(yaml.safe_dump({
+        "enabled": True,
+        "rotate_queries": True,
+        "region": "New Zealand",
+        "queries": queries,
+        "inbox_dir": "missing",
+        **options,
+    }))
+    path = tmp_path / "state.json"
+    if state is not None:
+        path.write_text(json.dumps(state))
+    collection = {
+        "candidates": [],
+        "sources": sources if sources is not None else [
+            {"kind": "search", "candidates": 0}
+        ],
+        "counts": {"candidates": 0, "source_errors": 0},
+    }
+    intake = {"counts": {"inserted": 0, "duplicates": 0, "rejected": 0}}
+    with patch.object(recurring.mm_core, "root", return_value=tmp_path), \
+         patch.object(recurring.mm_discovery, "collect_multi_source", return_value=collection) as collect, \
+         patch.object(recurring.mm_discovery, "ingest", return_value=intake) as ingest:
+        result = recurring.run_due(
+            object(), config_path=config, state_path=path,
+            at=dt.datetime(2026, 10, 8, tzinfo=UTC), force=True,
+        )
+    return result, collect, ingest
+
+
+def test_next_cycle_reaches_queries_past_old_first_twenty(tmp_path):
+    pool = [f"NZ service {index}" for index in range(45)]
+    first, collect, _ = run_cycle(tmp_path, pool)
+    assert collect.call_args.kwargs["queries"] == pool[:20]
+    assert first["query_cursor"] == 20
+
+    second, collect, _ = run_cycle(tmp_path, pool)
+    assert collect.call_args.kwargs["queries"] == pool[20:40]
+    assert second["query_cursor"] == 40
+
+    third, collect, _ = run_cycle(tmp_path, pool)
+    assert collect.call_args.kwargs["queries"] == pool[40:] + pool[:15]
+    assert len(collect.call_args.kwargs["queries"]) == 20
+    assert third["query_cursor"] == 15
+    assert third["external_sends"] == third["paid_calls"] == 0
+
+
+def test_search_outage_retries_same_batch_even_when_inbox_succeeds(tmp_path):
+    pool = [f"NZ service {index}" for index in range(25)]
+    first, _, _ = run_cycle(tmp_path, pool)
+    failed, collect, _ = run_cycle(tmp_path, pool, sources=[
+        {"kind": "import", "candidates": 1},
+        {"kind": "search", "candidates": 0, "error": "unavailable"},
+    ])
+    assert failed["query_cursor"] == first["query_cursor"]
+    assert failed["query_rotation_advanced"] is False
+    expected = collect.call_args.kwargs["queries"]
+    recovered, collect, _ = run_cycle(tmp_path, pool)
+    assert collect.call_args.kwargs["queries"] == expected
+    assert recovered["query_cursor"] == 15
+
+
+def test_config_change_resets_cursor_and_removes_duplicate_queries(tmp_path):
+    first, _, _ = run_cycle(tmp_path, [f"old {index}" for index in range(25)])
+    result, collect, _ = run_cycle(
+        tmp_path, ["builder NZ", "builder NZ", "", "  painter NZ  "], state=first
+    )
+    assert collect.call_args.kwargs["queries"] == ["builder NZ", "painter NZ"]
+    assert result["query_pool_size"] == 2
+    assert result["query_batch_start_cursor"] == 0
+    assert result["query_cursor"] == 0
+
+
+@pytest.mark.parametrize("cursor", ["broken", None, -1, float("inf")])
+def test_bad_cursor_recovers_without_stalling_discovery(tmp_path, cursor):
+    pool = [f"NZ service {index}" for index in range(25)]
+    state, _, _ = run_cycle(tmp_path, pool)
+    state["query_cursor"] = cursor
+    result, collect, _ = run_cycle(tmp_path, pool, state=state)
+    assert collect.call_args.kwargs["queries"] == pool[:20]
+    assert result["query_cursor"] == 20
+
+
+def test_rotation_remains_opt_in(tmp_path):
+    pool = [f"NZ service {index}" for index in range(25)]
+    first, _, _ = run_cycle(tmp_path, pool)
+    result, collect, _ = run_cycle(tmp_path, pool, state=first, rotate_queries=False)
+    assert collect.call_args.kwargs["queries"] == pool[:20]
+    assert "query_cursor" not in result
+
+
+def test_disabled_rotation_does_not_collect_or_change_cursor(tmp_path):
+    pool = [f"NZ service {index}" for index in range(25)]
+    state, _, _ = run_cycle(tmp_path, pool)
+    result, collect, ingest = run_cycle(tmp_path, pool, state=state, enabled=False)
+    assert result["ran"] is False
+    collect.assert_not_called()
+    ingest.assert_not_called()
+    assert json.loads((tmp_path / "state.json").read_text()) == state
+
+
+def test_national_config_covers_broad_regions_and_stays_bounded():
+    config = recurring.load_config()
+    assert config["rotate_queries"] is True
+    assert len(config["queries"]) == 384
+    assert len(set(config["queries"])) == 384
+    assert any("accountant" in query for query in config["queries"])
+    assert any("Invercargill" in query for query in config["queries"])
+    batch, state = recurring._select_queries(config, {})
+    assert len(batch) == recurring.mm_discovery.MAX_BATCH_QUERIES
+    assert state["query_pool_size"] == 384
+
+
+def test_completion_is_measured_after_ingest_without_moving_timer_anchor(tmp_path):
+    start = dt.datetime(2026, 10, 8, tzinfo=UTC)
+    completed = start + dt.timedelta(seconds=90)
+    schedule = {"enabled": True, "interval_minutes": 360,
+                "queries": ["builder NZ"], "inbox_dir": "missing"}
+    config = tmp_path / "schedule.yaml"
+    config.write_text(yaml.safe_dump(schedule))
+    state_path = tmp_path / "state.json"
+    events = []
+
+    def collect(**_options):
+        events.append("collect")
+        return {"candidates": [], "sources": [{"kind": "search"}], "counts": {}}
+
+    def ingest(*_args, **_options):
+        events.append("ingest")
+        return {"counts": {"inserted": 0, "duplicates": 0, "rejected": 0}}
+
+    def completion_clock(tz):
+        assert tz is UTC
+        events.append("completion_clock")
+        return completed
+
+    with (
+        patch.object(recurring.mm_core, "root", return_value=tmp_path),
+        patch.object(recurring.mm_discovery, "collect_multi_source", side_effect=collect),
+        patch.object(recurring.mm_discovery, "ingest", side_effect=ingest),
+        patch.object(recurring.dt, "datetime", wraps=dt.datetime) as clock,
+    ):
+        clock.now.side_effect = completion_clock
+        result = recurring.run_due(
+            object(), config_path=config, state_path=state_path, at=start,
+        )
+
+    assert events == ["collect", "ingest", "completion_clock"]
+    clock.now.assert_called_once_with(UTC)
+    assert result["started_at"] == result["last_finished_at"] == start.isoformat()
+    assert result["completed_at"] == completed.isoformat()
+    assert json.loads(state_path.read_text()) == result
+    assert recurring.due(schedule, result, at=start + dt.timedelta(hours=6)) is True
+    assert recurring.due(schedule, result, at=start + dt.timedelta(hours=5)) is False
+
+
+def test_not_due_skips_completion_clock_collection_and_state_write(tmp_path):
+    start = dt.datetime(2026, 10, 8, tzinfo=UTC)
+    config = tmp_path / "schedule.yaml"
+    config.write_text(yaml.safe_dump({
+        "enabled": True, "interval_minutes": 360, "queries": ["builder NZ"],
+    }))
+    state_path = tmp_path / "state.json"
+    state_path.write_text(json.dumps({
+        "last_finished_at": start.isoformat(),
+        "completed_at": (start + dt.timedelta(seconds=90)).isoformat(),
+        "query_cursor": 20,
+    }))
+    previous_state = state_path.read_bytes()
+    with (
+        patch.object(recurring.mm_discovery, "collect_multi_source") as collect,
+        patch.object(recurring.mm_discovery, "ingest") as ingest,
+        patch.object(recurring.dt, "datetime", wraps=dt.datetime) as clock,
+    ):
+        clock.now.side_effect = AssertionError("Not-due cycle must not measure completion")
+        result = recurring.run_due(
+            object(), config_path=config, state_path=state_path,
+            at=start + dt.timedelta(minutes=30),
+        )
+
+    assert result["ran"] is False
+    assert result["reason"] == "disabled_or_not_due"
+    assert "completed_at" not in result
+    clock.now.assert_not_called()
+    collect.assert_not_called()
+    ingest.assert_not_called()
+    assert state_path.read_bytes() == previous_state
