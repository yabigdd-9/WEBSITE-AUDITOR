{
  "name": "04 - Record Evidence Audit",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8787/audit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "Authorization": "Bearer {{$credentials.mmBridgeToken}}"
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { id: $json.business_id, url: $json.url, observation: $json.observation, limitation: $json.limitation, capture: $json.capture, status: $json.status || 'unverified', method: $json.method || 'observed', confidence: $json.confidence || 0.5, claim_type: $json.claim_type || 'website_quality' } }}"
      },
      "name": "Record Audit Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        350,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Record Audit Evidence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Pacific/Auckland",
    "executionTimeout": 300
  }
}
