{
  "name": "10 - Learning Snapshot",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8787/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "Authorization": "Bearer {{$credentials.mmBridgeToken}}"
        }
      },
      "name": "MM Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        350,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const envelope = $input.first().json;\\nconst result = envelope.result || envelope;\\nconst metrics = result.metrics || {};\\nreturn [{ json: { generated_at: result.generated_at, real_prospects: metrics.real_prospects || 0, verified_sends: metrics.verified_sends || 0, verified_replies: metrics.verified_replies || 0, net_received_nzd: metrics.net_received_nzd || 0, note: 'read-only learning snapshot' } }];"
      },
      "name": "Learning Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "MM Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "MM Status": {
      "main": [
        [
          {
            "node": "Learning Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Pacific/Auckland",
    "executionTimeout": 300
  }
}
