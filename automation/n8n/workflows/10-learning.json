{
  "name": "10 - Outcome Learning",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8787/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"Authorization": "Bearer {{$credentials.mmBridgeToken}}"}
      },
      "name": "MM Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [350, 300]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst metrics = result.metrics || {};\nreturn [{ json: { industry: 'general', region: 'NZ', verified_problem: true, offer_type: 'website_rescue', reply_state: 'pending', sale_state: 'pending', revenue_nzd: metrics.net_received_nzd || 0, events: 'outcome_learning_recorded' } }];"
      },
      "name": "Extract Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    }
  ],
  "connections": {"Manual Trigger": {"main": [[{"node": "MM Status", "type": "main", "index": 0}]]}, "MM Status": {"main": [[{"node": "Extract Metrics", "type": "main", "index": 0}]]}},
  "settings": {"timezone": "Pacific/Auckland", "executionTimeout": 300}
}