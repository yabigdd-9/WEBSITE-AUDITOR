{
  "name": "02 - First Party Website Verification",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8787/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"Authorization": "Bearer {{$credentials.mmBridgeToken}}"}
      },
      "name": "MM Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [350, 300]
    },
    {
      "parameters": {
        "jsCode": "const candidates = ($input.first().json.email_contacts || []).filter(c => c.verification === 'NO_VERIFIED_EMAIL');\nreturn candidates.map(c => ({ json: { business_id: c.business_id, business: c.business, website: c.website, canonical_domain: c.canonical_domain, email: c.email } }));"
      },
      "name": "Queue Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    }
  ],
  "connections": {"Manual Trigger": {"main": [[{"node": "MM Status", "type": "main", "index": 0}]]}, "MM Status": {"main": [[{"node": "Queue Candidates", "type": "main", "index": 0}]]}},
  "settings": {"timezone": "Pacific/Auckland", "executionTimeout": 300}
}