{
  "name": "06 - Brain Review",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8787/brain-review",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"Authorization": "Bearer {{$credentials.mmBridgeToken}}"},
        "sendQuery": true,
        "queryParameters": {"id": "={{$json.message_id}}"}
      },
      "name": "Brain Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [350, 300]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst decision = result.decision || 'NEEDS_RESEARCH';\nconst next = decision === 'APPROVED_FOR_SEND' ? 'generate_draft' : decision === 'NEEDS_RESEARCH' ? 'return_to_research' : 'close_candidate';\nreturn [{ json: { message_id: result.message_id, decision, rejections: result.rejections || [], next_action: next } }];"
      },
      "name": "Route Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    }
  ],
  "connections": {"Manual Trigger": {"main": [[{"node": "Brain Review", "type": "main", "index": 0}]]}, "Brain Review": {"main": [[{"node": "Route Decision", "type": "main", "index": 0}]]}},
  "settings": {"timezone": "Pacific/Auckland", "executionTimeout": 300}
}