{
  "name": "06b - Brain Approve/Reject Pipeline",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8787/brain-approve",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"Authorization": "Bearer {{$credentials.mmBridgeToken}}"},
        "sendQuery": true,
        "queryParameters": {"id": "={{$json.message_id}}"}
      },
      "name": "Brain Approve",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [350, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8787/brain-reject",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"Authorization": "Bearer {{$credentials.mmBridgeToken}}"},
        "sendBody": true,
        "bodyParameters": {"id": "={{$json.message_id}}", "reason": "={{$json.reason || 'no_real_opportunity'}}"}
      },
      "name": "Brain Reject",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [350, 400]
    },
    {
      "parameters": {
        "jsCode": "const approve = $('Brain Approve').first().json;\nconst reject = $('Brain Reject').first().json;\nif (approve.ok) return [{ json: { decision: 'APPROVED', message_id: approve.result.message_id } }];\nif (reject.ok) return [{ json: { decision: 'REJECTED', message_id: reject.result.message_id, reason: reject.result.reason } }];\nreturn [{ json: { decision: 'NEEDS_RESEARCH', message_id: $json.message_id } }];"
      },
      "name": "Aggregate Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    }
  ],
  "connections": {"Manual Trigger": {"main": [[{"node": "Brain Approve", "type": "main", "index": 0}, {"node": "Brain Reject", "type": "main", "index": 0}]]}, "Brain Approve": {"main": [[{"node": "Aggregate Decision", "type": "main", "index": 0}]]}, "Brain Reject": {"main": [[{"node": "Aggregate Decision", "type": "main", "index": 0}]]}},
  "settings": {"timezone": "Pacific/Auckland", "executionTimeout": 300}
}