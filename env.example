# Money Engine Environment Configuration
# Copy this to .env and fill in values. .env is gitignored — never commit secrets.

# Hunter.io API key (optional — enables external email enrichment)
# Sign up: https://hunter.io/users/sign_up
# Free plan: 50 requests/month
HUNTER_API_KEY=

# OpenRouter / Nous / LLM provider keys (if using model features)
# OPENROUTER_API_KEY=
# NOUS_API_KEY=
