# WEBSITE-AUDITOR Environment Variables
# Copy this file to .env and fill in values as needed

# ─── Core Application ──────────────────────────────────────────────
# Output directory for audit results
# WA_OUTPUT_ROOT=outputs/toolkit

# Default HTTP request timeout (seconds)
# WA_DEFAULT_TIMEOUT=8.0

# Allow auditing private/non-global IP addresses (security risk if enabled)
# WA_ALLOW_PRIVATE=false

# Maximum redirect hops to follow
# WA_MAX_REDIRECTS=6

# ─── Browser / Rendered Checks ─────────────────────────────────────
# Enable browser-based checks (requires Playwright/Chromium)
# WA_BROWSER_ENABLED=false

# Generate visual diff screenshots against previous runs
# WA_SCREENSHOT_DIFF=false

# Gotenberg URL for PDF generation (if not using default)
# GOTENBERG_URL=http://localhost:3000

# LightPanda / Crawl4AI URLs for alternative renderers
# LIGHTPANDA_URL=
# CRAWL4AI_URL=

# ─── External Tools ────────────────────────────────────────────────
# Require external tools (Lighthouse, Lychee) to be installed
# WA_EXTERNAL_TOOLS=false

# ─── AI / Model Settings ───────────────────────────────────────────
# Enable AI-powered draft generation
# WA_AI_ENABLED=false

# AI generation timeout (seconds)
# WA_AI_TIMEOUT=120.0

# Path to local GGUF model file
# WA_AI_MODEL_PATH=

# OpenRouter API key (for external model routing)
# OPENROUTER_API_KEY=

# ─── Rate Limiting ─────────────────────────────────────────────────
# Minimum interval between requests to same host (seconds)
# WA_MIN_REQUEST_INTERVAL=0.1

# Maximum concurrent audit runs
# WA_MAX_CONCURRENT_AUDITS=2

# ─── Caching ───────────────────────────────────────────────────────
# Enable HTTP response caching
# WA_CACHE_ENABLED=false

# Cache TTL in hours
# WA_CACHE_TTL_HOURS=24

# ─── Reporting ──────────────────────────────────────────────────────
# Brand name for report headers
# WA_BRAND=Website Auditor

# Hourly rate in NZD for cost estimates
# WA_HOURLY_RATE_NZD=

# ─── Monitoring & Alerts ───────────────────────────────────────────
# Webhook URL for regression alerts (Slack, Discord, etc.)
# ALERT_WEBHOOK_URL=

# Enable runtime health checks
# WA_HEALTH_CHECK_ENABLED=true

# ─── Logging ────────────────────────────────────────────────────────
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# WA_LOG_LEVEL=INFO

# Output logs as JSON lines
# WA_JSON_LOGS=false

# ─── Database ───────────────────────────────────────────────────────
# SQLite database path
# WA_DB_PATH=outputs/toolkit/history.sqlite3

# ─── External API Keys ──────────────────────────────────────────────
# Google PageSpeed Insights API key
# PAGESPEED_API_KEY=

# RankNibbler API key
# RANKNIBBLER_API_KEY=

# LanguageTool API base URL
# WA_LANGUAGETOOL_URL=https://api.languagetool.org/v2

# SMTP probe enable (for email verification)
# SMTP_PROBE=0

# ─── GitHub Integration ────────────────────────────────────────────
# GitHub token for issue exporter
# GITHUB_TOKEN=

# ─── Monthly Demo ───────────────────────────────────────────────────
# Root directory for monthly demo outputs
# WA_MONTHLY_DEMO_ROOT=

# ─── Money Machine / Legacy ────────────────────────────────────────
# Money Machine root directory (used in tests)
# MM_ROOT=

# Allow external free models (used in tests)
# MM_ALLOW_EXTERNAL_FREE_MODELS=0

# Optional local integration connectors. Keep credentials in your runtime
# environment or ignored .env file; do not commit secret values.
OBSIDIAN_VAULT_PATH=
NOTION_API_KEY=
WA_INTEGRATION_PORT=8091
WA_WEBHOOK_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Required before GitHub push/PR events can trigger a deterministic site audit.
GITHUB_REPOSITORY_ALLOWLIST=
GITHUB_AUDIT_SITE_URL=

# DeepSeek Harness
# DSH_MM_ALLOW_BOUNDED_WRITES=0

# WordPress Connector (legacy)
# WP_SITE_URL=
# WP_USERNAME=
# WP_APP_PASSWORD=