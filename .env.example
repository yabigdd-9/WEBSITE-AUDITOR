# Tier 1 Enrichment
PAGESPEED_API_KEY=
RANKNIBBLER_API_KEY=

# GitHub (for github_issue_exporter.py)
GITHUB_TOKEN=

# Optional local integration connectors. Keep credentials in your runtime
# environment or ignored .env file; do not commit secret values.
OBSIDIAN_VAULT_PATH=
NOTION_API_KEY=
WA_INTEGRATION_PORT=8091
WA_WEBHOOK_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Required before GitHub push/PR events can trigger a deterministic site audit.
GITHUB_REPOSITORY_ALLOWLIST=
GITHUB_AUDIT_SITE_URL=

# DeepSeek Harness
DSH_MM_ALLOW_BOUNDED_WRITES=0   # keep 0 except supervised tests

# Repo-owned A2A gateway (loopback only; all opt-ins remain off by default)
MM_A2A_GATEWAY_ENABLED=0
MM_A2A_FREE_ROUTING=0
MM_ALLOW_EXTERNAL_FREE_MODELS=0
MM_A2A_GATEWAY_HOST=127.0.0.1
MM_A2A_GATEWAY_PORT=8094
MM_A2A_GATEWAY_TOKEN= # Set locally via keychain/environment; never commit a real token
