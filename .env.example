# Tier 1 Enrichment
PAGESPEED_API_KEY=
RANKNIBBLER_API_KEY=

# GitHub (for github_issue_exporter.py)
GITHUB_TOKEN=

# Optional local integration connectors. Keep credentials in your runtime
# environment or ignored .env file; do not commit secret values.
OBSIDIAN_VAULT_PATH=
NOTION_API_KEY=
WA_INTEGRATION_PORT=8091
WA_WEBHOOK_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Required before GitHub push/PR events can trigger a deterministic site audit.
GITHUB_REPOSITORY_ALLOWLIST=
GITHUB_AUDIT_SITE_URL=

# DeepSeek Harness
DSH_MM_ALLOW_BOUNDED_WRITES=0   # keep 0 except supervised tests

# CatalyxLabs Website Auditor hosted runtime (fill only after provider approval; keep credentials outside Git)
CATALYX_ENV=development
CATALYX_DATABASE_URL=
CATALYX_PUBLIC_BASE_URL=
CATALYX_TOTP_ENCRYPTION_KEY=
CATALYX_REGISTRATION_MODE=closed
CATALYX_MAIL_MODE=local_mailbox
CATALYX_EXTERNAL_SEND_ALLOWED=false
CATALYX_SMTP_HOST=
CATALYX_SMTP_PORT=587
CATALYX_SMTP_USERNAME=
CATALYX_SMTP_PASSWORD=
CATALYX_SMTP_FROM=
