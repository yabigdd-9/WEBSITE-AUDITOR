7,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/d60bbd_99293d487f0242489165aa30c498456d~mv2.jpg" alt="C-Bus automation approved supplier badge" style="object-fit:cover" class="gRkIq0 sFiSiq" width="124" height="47"/></div></div><div id="comp-mt7zos98" class="W4V2qg comp-mt7zos98 wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="173px" srcSet="https://static.wixstatic.com/media/d60bbd_d9bd0ef5bcd74edf93f8a6cfc2c3fb64~mv2.png/v1/fill/w_173,h_51,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/d60bbd_d9bd0ef5bcd74edf93f8a6cfc2c3fb64~mv2.png 1x, https://static.wixstatic.com/media/d60bbd_d9bd0ef5bcd74edf93f8a6cfc2c3fb64~mv2.png/v1/fill/w_346,h_102,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/d60bbd_d9bd0ef5bcd74edf93f8a6cfc2c3fb64~mv2.png 2x" id="img_comp-mt7zos98" src="https://static.wixstatic.com/media/d60bbd_d9bd0ef5bcd74edf93f8a6cfc2c3fb64~mv2.png/v1/fill/w_173,h_51,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/d60bbd_d9bd0ef5bcd74edf93f8a6cfc2c3fb64~mv2.png" alt="Daikin heat pumps certified installer badge" style="object-fit:cover" class="gRkIq0 sFiSiq" width="173" height="51"/></div></div></div></div></section><section id="comp-mt7zpkmc" tabindex="-1" class="Le88gL comp-mt7zpkmc wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-mt7zpkmc" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mt7zpkmc" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mt7zpkmc" data-motion-part="BG_MEDIA comp-mt7zpkmc" class="ROWgFb"></div></div><div data-mesh-id="comp-mt7zpkmcinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mt7zpkmcinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mt7zpkmm" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mt7zpkmm wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="line-height:normal; font-size:36px;"><span style="color:rgb(34, 34, 34); font-family:tusker-grotesk-condensed; font-size:36px; font-style:normal; font-weight:bold; letter-spacing:0.05em;" class="wixui-rich-text__text">Specialist partnerships</span></h2></div><div id="comp-mt7zpkmn" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mt7zpkmn wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:18px; line-height:normal;"><span style="color:rgb(34, 34, 34); font-family:barlow-v2; font-size:18px; font-style:normal; font-weight:normal; letter-spacing:0em;" class="wixui-rich-text__text"><span style="font-size:18px;" class="wixui-rich-text__text">The best results come from working with the right people. Alongside our own specialist teams, ATL works closely with trusted partners who share our commitment to quality, innovation and exceptional customer service. These partnerships allow us to deliver seamless solutions across lighting, security and emerging technologies while giving our customers access to industry-leading expertise.</span></span></p></div><div id="comp-mt80bi5i" class="W4V2qg comp-mt80bi5i wixui-image cs40a3"><a data-testid="linkElement" href="https://www.atllighting.co.nz/" target="_blank" rel="noreferrer noopener" class="apPOZK"><img loading="lazy" sizes="152px" srcSet="https://static.wixstatic.com/media/1c9d7c_19eca6f0515d4ffeb70fa821af234480~mv2.png/v1/fill/w_152,h_86,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/1c9d7c_19eca6f0515d4ffeb70fa821af234480~mv2.png 1x, https://static.wixstatic.com/media/1c9d7c_19eca6f0515d4ffeb70fa821af234480~mv2.png/v1/fill/w_304,h_172,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/1c9d7c_19eca6f0515d4ffeb70fa821af234480~mv2.png 2x" id="img_comp-mt80bi5i" src="https://static.wixstatic.com/media/1c9d7c_19eca6f0515d4ffeb70fa821af234480~mv2.png/v1/fill/w_152,h_86,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/1c9d7c_19eca6f0515d4ffeb70fa821af234480~mv2.png" alt="ATL Designer Lighting logo" style="object-fit:cover" class="gRkIq0 sFiSiq" width="152" height="86"/></a></div><div id="comp-mt807ngv" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mt807ngv wixui-rich-text" data-testid="richTextElement"><h3 class="font_3 wixui-rich-text__text" style="line-height:normal; font-size:24px;"><span style="color:rgb(34, 34, 34); font-family:montserrat; font-size:24px; font-style:normal; font-weight:normal; letter-spacing:0em;" class="wixui-rich-text__text">ATL Designer Lighting</span></h3></div><div id="comp-mt8071mu" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mt8071mu wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:18px; line-height:normal;"><span style="color:rgb(34, 34, 34); font-family:barlow-v2; font-size:18px; font-style:normal; font-weight:normal; letter-spacing:0em;" class="wixui-rich-text__text"><span style="font-size:18px;" class="wixui-rich-text__text">Working alongside ATL Designer Lighting, we help clients create beautifully illuminated spaces with professional lighting design, product selection and expert installation&mdash;all backed by one coordinated team.</span></span></p></div><div id="comp-mt808nqm" class="comp-mt808nqm" data-semantic-classname="button"><a data-testid="linkElement" href="https://www.atllighting.co.nz/" target="_blank" rel="noreferrer noopener" class="StylableButton2545352419__root style-mt808nqr3__root wixui-button StylableButton2545352419__link" aria-label="Visit ATL Designer Lighting"><span class="StylableButton2545352419__container"><span class="StylableButton2545352419__label wixui-button__label" data-testid="stylablebutton-label">Visit ATL Designer Lighting</span><span class="StylableButton2545352419__icon wixui-button__icon" aria-hidden="true" data-testid="stylablebutton-icon"><span>
