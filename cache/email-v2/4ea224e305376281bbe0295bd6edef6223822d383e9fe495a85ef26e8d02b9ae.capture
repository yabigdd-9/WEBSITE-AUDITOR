#comp-kixxnh6u .style-kk4tkj7q__root[disabled] .StylableButton2545352419__icon{fill: #8F8F8F}

#comp-kixxnh6u .style-kk4tkj7q__root .StylableButton2545352419__container{transition: inherit;flex-direction: row-reverse}

#comp-kixxnh6u .style-kk4tkj7q__root .StylableButton2545352419__label{transition: inherit;font-family: barlow-medium,barlow,sans-serif;font-size: 20px;color: #E1251D;font-weight: 700;margin: 0px 0px 0px 2.5px;letter-spacing: 0.05em}

#comp-kixxnh6u .style-kk4tkj7q__root .StylableButton2545352419__icon{transition: inherit;fill: #E1251D;width: 25px;height: 25px;margin: 0px 2.5px 0px 0px}

#comp-kixxnh6u .style-kk4tkj7q__root:hover .StylableButton2545352419__icon{
    fill: #FFFFFF}

@media screen and (min-width: 1px) and (max-width: 0px) {
