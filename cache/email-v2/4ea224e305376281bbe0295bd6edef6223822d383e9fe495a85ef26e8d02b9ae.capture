/* START STYLABLE DIRECTIVE RULES */

#comp-kixxnh6u .style-kk4tkj7q__root:hover{background: rgba(255, 255, 255, 0);border: 0px solid #222222}

#comp-kixxnh6u .style-kk4tkj7q__root:hover .StylableButton2545352419__label{text-shadow: none;color: #FFFFFF;font-weight: 400}

#comp-kixxnh6u .style-kk4tkj7q__root[disabled]{background: #E2E2E2}

