isplay:none;position:fixed;top:0;right:0;bottom:0;left:0;z-index:99999;background:rgb(8 12 20 / .9);padding:28px 20px;cursor:zoom-out;align-items:center;justify-content:center;margin:0}body.single-post .post-content .sr-lb-box:checked~.sr-lb-modal{display:flex}body.single-post .post-content .sr-lb-inner{display:block;max-width:min(1100px, 94vw);text-align:center}body.single-post .post-content .sr-lb-modal img{display:block;width:auto!important;max-width:100%;max-height:82vh;aspect-ratio:auto!important;object-fit:contain!important;border-radius:4px;background:#fff;margin:0 auto!important}body.single-post .post-content .sr-lb-cap{display:block;margin-top:12px;font-size:13px;line-height:1.5;color:#e8ebf2}body.single-post .post-content .sr-lb-x{position:fixed;top:6px;right:8px;width:46px;height:46px;display:flex;align-items:center;justify-content:center;font-size:34px;line-height:1;color:#fff;font-weight:300}@media (max-width:620px){body.single-post .post-content .sr-lb-modal{padding:8px}body.single-post .post-content .sr-lb-inner{max-width:100%}body.single-post .post-content .sr-lb-modal img{max-height:78vh}body.single-post .post-content .sr-lb-cap{margin-top:10px;font-size:12px;padding:0 4px}body.single-post .post-content .sr-lb-x{top:2px;right:2px;background:rgb(8 12 20 / .6);border-radius:50%}}body:has(.sr-lb-box:checked) .cnb-single,body:has(.sr-lb-box:checked) .rpi-flash-wrap,body:has(.sr-lb-box:checked) .om-holder{display:none!important}body:has(.sr-lb-box:checked){overflow:hidden}body.single-post .post-content img.scg-dia{display:block;max-width:100%;height:auto;border-radius:3px;margin:28px auto}body.single-post .post-content .scg-dia-narrow{display:none!important}@media (max-width:767px){body.single-post .post-content .scg-dia-wide{display:none!important}body.single-post .post-content .scg-dia-narrow{display:block!important}}</style> 
