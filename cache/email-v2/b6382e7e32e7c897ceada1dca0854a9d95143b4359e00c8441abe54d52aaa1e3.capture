55,255,1)" data-tsh="c:rgba(0,0,0,0.55);h:3px;v:2px;b:7px;" data-rsp_ch="on" data-xy="x:c;xo:1px,0,-1px,0;y:m;yo:21px,35px,6px,-39px;" data-text="w:normal,normal,normal,normal;s:47,53,48,39;l:72,70,48,35;fw:300;a:center;" data-dim="w:724px,681px,589px,515px;h:83px,90px,116px,96px;" data-padding="t:10,10,10,13;b:10,10,10,13;" data-frame_0="sX:1.5;sY:1.5;" data-frame_0_mask="u:t;" data-frame_1="x:0,0,0,0px;y:0,0,0,0px;sp:50;" data-frame_1_mask="u:t;x:0,0,0,0px;y:0,0,0,0px;" data-frame_999="y:100%;e:power2.inOut;st:w;sp:1000;sR:8950;" data-frame_999_mask="u:t;" style="z-index:7;font-family:'Raleway';" >Our Story </h1><a id="slider-37-slide-44-layer-2" class="rs-layer rev-btn" href="https://superiorrenovations.co.nz/download-information-pack/" target="_self" data-type="button" data-rsp_ch="on" data-xy="x:c;xo:0,-1px,1px,0;yo:473px,485px,324px,326px;" data-text="w:normal;s:15;l:40,48,47,41;fw:400,300,300,300;a:center;" data-dim="w:333px,324px,302px,282px;h:auto,48px,49px,42px;minh:0px,none,none,none;" data-padding="r:25,21,16,10;l:25,21,16,10;" data-border="bos:solid;boc:rgba(255,255,255,0.35);bow:1px,1px,1px,1px;bor:25px,25px,25px,25px;" data-frame_1="sp:50;" data-frame_999="o:0;st:w;sR:8950;" data-frame_hover="bgc:rgba(0,0,0,0);boc:rgba(255,255,255,0.75);bor:25px,25px,25px,25px;bos:solid;bow:1px,1px,1px,1px;e:power1.inOut;" style="z-index:10;background-color:rgba(0,0,0,0);font-family:'Roboto';" >Download Company Information Pack </a><rs-layer id="slider-37-slide-44-layer-4" class="NotGeneric-SubTitle" data-type="text" data-color="rgba(255,255,255,1)" data-rsp_ch="on" data-xy="x:c;xo:9px,6px,1px,0;y:m;yo:107px,124px,56px,74px;" data-text="w:normal;s:14,14,13,13;l:20;fw:300,300,400,400;a:center;" data-dim="w:535px,527px,527px,427px;h:auto,auto,auto,180px;" data-frame_0="y:100%;" data-frame_0_mask="u:t;y:100%;" data-frame_1="e:power4.inOut;sp:50;" data-frame_1_mask="u:t;" data-frame_999="y:100%;e:power2.inOut;st:w;sp:1000;sR:8950;" data-frame_999_mask="u:t;" style="z-index:8;font-family:'Open Sans';" >It all started with believing in creating a personalized renovation experience. Our focus is on transforming not only spaces but lifestyles but bring together a team who respect your vision and home. We're here to make renovations more than just a project—they're a journey to a better home and life. </rs-layer> </rs-slide> </rs-slides> </rs-module> 
