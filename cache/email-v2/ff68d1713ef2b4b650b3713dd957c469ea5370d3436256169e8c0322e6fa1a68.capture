<link rel="stylesheet" href="https://www.energysmart.co.nz/hubfs/hub_generated/module_assets/1/147310199414/1740804714274/module_Footer.min.css">

  <style>
    
        
    .footer-top-right .hs_email {
      width: 100% !important;
      flex: 1 1 auto !important;
      margin: 0 !important;
    }
    
    .footer-wrap .actions input.hs-button.primary {
      color: #053638;
      transition: all .3s;
      cursor: pointer;
      font-family: 'ReplicaLLWeb-Heavy', sans-serif !important;
    }

    
    @media (max-width: 1100px) {
      .footer-top-left {
        padding-bottom: 0;
      }

      .footer-top-left a {
        padding-bottom: 0.7rem !important;
      }

      .not-phone {
        font-size: 90% !important;
      }

      .footer-top-left img {
        width: 22px !important;
      }

      .footer-top-content {
        flex-direction: row;
        gap: 2rem;
      }

      .footer-top-right h4 {
      
        min-width: 23rem; 
      }

      .footer-wrap .content-wrapper {
        display: flex;
        flex-direction: column;
      }

    }
      
    @media (max-width: 820px) {
      .footer {
        margin-top: unset !important;
        padding-top: 6vw;
      }
      
      .footer .copyright {
        background: unset !important;
      }
      
      .footer.footer {
        background-color: #053638 !important;
      }

      .footer-top-content {
        display: block;
      }
      
      .footer-top-right {
        padding: 0 3vw !important;
      }
      
      .footer-top-right h4 {
        font-family: 'Aeonik-Regular', sans-serif !important;
        font-size: 4.25vw !important;
        text-align: center !important;
        padding: 0 !important;
        margin-bottom: 3.5vw !important;
        min-width: unset;
      }
      
      .footer-wrap .content-wrapper {
        
      }

      footer.footer .content-wrapper {
        padding: 0;
      }
      
      .footer-wrap .copyright .content-wrapper {
        display: block !important;
        text-align: unset !important;
        padding: 0 0 3vw;
      }
      
      .footer-top-left {
        display: none !important;
      }
      
      .footer-middle-content {
        display: none !important;
      }
      
      .content-foot p,
      .content-foot p a {
        font-size: 3.3vw !important;
      }
      
      .content-foot p {
/*         maybe in the wrong place */
        line-height: 3.5vw !important;
        padding: 15vw 3vw 0 !important;
      }
      
      .content-foot-right {
        display: block !important;
      }
      
      .footer-top-right form input[type=email] {
        height: 10vw !important;
      }
      
      .footer-top-right form .hs_submit .actions {
        max-width: unset !important;
      }
      
      .footer-wrap form input[type=email],
      .footer-wrap form input[type=email]:-webkit-autofill {
        font-size: 4.25vw !important;
        padding: 0 3.5vw !important;
      }
      
      .footer-top-right .hs_email {
        width: unset !important;
        flex: 1 1 auto !important;
      }
      
      .footer-top-right .hs_submit {
        width: unset !important;
      }
      
      .footer-top-right .actions {
        top: unset !important;
      }
      
      .footer-top-right .actions input.hs-button.primary.large {
        padding: 0 5.5vw !important;
        height: 10vw !important;
        font-size: 3.2vw !important;
        
      }
      
      #privacy-terms-conditions {
        display: none !important;
      }
      
      #copyright-logo p {
        font-size: 3.3vw !important;
        color: #a2bfac !important;
        padding: 4vw 3vw !important;
      }
    }
    
  </style>

