<!--     <script async src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAw35gB1q94NHGHtwlSPcK19HlaKmkm72U&callback=initMap&libraries=&v=weekly"> -->
      
<!--     </script> -->
    
    <script async defer type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBfDdpqdNgQmDCcM1PphnOLtUHCpONZ58E&amp;callback=initMap&amp;libraries=places&amp;v=weekly"></script>


    <script defer>
      async function initMap() {
        const position = { lat: -43.534277 , lng: 172.702012 }

        const map = new google.maps.Map(document.getElementById("map"), {
          zoom: 15,
          center: position
        })

        const marker = new google.maps.Marker({
          position: position,
          map,
          title: `<h6>EnergySmart Canterbury</h6>`
        })

        const infowindow = new google.maps.InfoWindow({
          content: `<h6>EnergySmart Canterbury</h6>`
        })

        const openInfoWindow = () => infowindow.open(map, marker)

        marker.addListener("click", () => openInfoWIndow() )

        // open infoWindow by default
        openInfoWindow()
      }
    </script>

