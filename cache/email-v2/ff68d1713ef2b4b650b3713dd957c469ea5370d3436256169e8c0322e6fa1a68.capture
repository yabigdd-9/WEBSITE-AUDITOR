<style>
  .module-local-branch-book {
  
    background-color: #6f6f6f82;
    background-image: url('https://www.energysmart.co.nz/hubfs/Christchurch%20Avon.jpg');
    background-blend-mode: color;
    position: relative;
    background-size: cover; 
    background-position: center; 
    background-repeat: no-repeat;
    height: 100px;
    width: 100%;
    display: flex;
    flex-direction: column; /* Stack items vertically */
    justify-content: center; /* Center items vertically in the container */
    align-items: center; /* Center items horizontally in the container */
    min-height: 95svh; /* total viewport height minus menu */
  }

  .module-local-branch-book::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #114242;
    mix-blend-mode: color; /* use 'background' to tint the location photo */ 
    z-index: 1; /* Ensure overlay is behind the content */
  }

  .module-local-branch-book > * {
      position: relative;
      z-index: 2; /* Ensure content is in front of the overlay */
  }
  
  .module-local-branch-book h1{
    text-transform: uppercase;
    max-width: 90%;
    text-align: CENTER !important;
    line-height: 0.875;

    margin: 0;
    color: #d6f700 !important;
    font-size: clamp(5vw, 5rem, 10vw);
    
    font-family: 'ReplicaLLWeb-Heavy','Poppins', sans-serif !important;
      
    text-shadow: 0 0 2rem #000000b8;
  }
  
  .module-local-branch-book p{
    max-width: 55%;
    text-wrap: balance;
    text-align: CENTER !important;
    font-size: 1.875rem;
    line-height: 1.333;
    margin: 1rem 0 1.5rem;
    color: #FFFFFF !important;
    
      font-family: 'Aeonik-Regular','Poppins', sans-serif !important;
      
    text-shadow: 0 0 8px black;
  }
  
  .module-local-branch-book .book{
    background: #d6f700;
    text-align: CENTER !important;
    font-size: 0.875rem;
    padding: 0.5rem 1.3rem 0.4rem;
    color: #053638 !important;
    font-family: 'ReplicaLLWeb-Heavy',Poppins, sans-serif !important;
}
  
</style>


  <style>

    .special-padding {
      padding: 2rem;
    }

    #a-unique-and-descriptive-name {
      
      background-color: #F6F9F4;
      
      
      
      padding-left: 0;
      padding-right: 0;
    }

    #a-unique-and-descriptive-name li {
      color: #114242;
      font-size: 1.125rem;
      line-height: 1.333;
      list-style-type: none;
      margin-bottom: 0.6rem;
      margin-left: 1.3rem;
      position: relative;
    }

    
    #a-unique-and-descriptive-name li a, 
    #a-unique-and-descriptive-name li a:visited {
      
      
      font-size: 1.125rem;
      text-decoration: none;
      
      font-family: 'ReplicaLLWeb-Heavy','Poppins', sans-serif !important;
        
      color: #053539;
    }

    #a-unique-and-descriptive-name li a:hover, 
    #a-unique-and-descriptive-name li a:active {
      color: #a2bfac;
    } 

    #a-unique-and-descriptive-name li .logo-only {
      height: 0.8rem;
      position: absolute;
      left: -1.3rem;
      top: 5px;
      
      
    }

    #a-unique-and-descriptive-name .main-heading {
      max-width: 100% !important;
      text-align: CENTER !important;
      margin: 0 auto;
      
      
      
      
      padding: 3rem;
      /*       padding-bottom: 3rem; */
      
      color:  !important;
      
      font-size: 3rem;
      
      line-height: 1.125;
      
      font-family: 'ReplicaLLWeb-Heavy','Poppins', sans-serif !important;
        
    }

    #a-unique-and-descriptive-name .main-heading.main-heading--banner-alternate {
      background: #d6f700;
      text-transform: uppercase;
      line-height: .875;
      text-wrap-style: balance;
      padding: 4rem calc(4rem + 10%);
    }

    #a-unique-and-descriptive-name .subtext {
      text-align: CENTER !important;
      
      margin: 0 auto 1rem;
      
/*       padding-inline: 2rem !important; */
      color: #082021 !important;
      
      font-size: 1.125rem;
      line-height: 1.333;
      max-width: 60ch;
      text-wrap: pretty;
      
      font-family: 'ReplicaLLWeb-Heavy','Poppins', sans-serif !important;
        
    }

    .module-image-and-text .subtext a {
      cursor: pointer;
      transition: .16s;
      color: #114242;
      text-decoration: underline;
    }

    .module-image-and-text .subtext a:hover, 
    .module-image-and-text .subtext a:active {
      color: #d6f700;
      background: #053539;
      padding: 0.2rem;
      margin: -0.2rem;
    }

    .box-list--banner {
      display: flex;
      flex-direction: column;
      gap: .3rem;
      margin-bottom: 1.4rem;

      a {
        transition: .08s;
        color: var(--col-eggshell);
        &:hover, &:active {
          color: var(--col-hot-yellow);
        }
      }
    }

    #a-unique-and-descriptive-name .box-heading {
      
      color: #114242;
      font-family: 'Aeonik-Bold', sans-serif;
      max-width: 100%;
      font-size: 2.125rem;
      line-height: 1.17;
      margin-bottom: 2rem;
      
      margin-top:px !important;
      
      
      
      
      
    }
    
    
    
    
    .hsfc-Step__Content {
      padding: 0 !important;
    }
    
    .hs_cos_wrapper_type_form {
      width: 100%;
    }
    .hsfc-ErrorAlert {
      font-weight: bold;
      color: #d6f700 !important;
    }


    #a-unique-and-descriptive-name .box-subtext {
      
      max-width: 100%;
      color: #114242;
      a {
        transition: .08s;
        background: var(--col-hot-yellow);
        padding: .2rem;
        margin: -.2rem;
        &:hover, &:active {
          color: var(--col-hot-yellow);
          background: var(--col-dark-green); 
        }
      }
      
      margin: 1.7rem 0;
