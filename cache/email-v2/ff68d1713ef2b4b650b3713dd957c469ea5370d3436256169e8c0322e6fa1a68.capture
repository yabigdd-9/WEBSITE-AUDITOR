<link rel="stylesheet" href="https://www.energysmart.co.nz/hubfs/hub_generated/module_assets/1/148822088824/1765404928134/module_Header_Rebrand.min.css">

<style>

  [data-global-resource-path="EnergySmart_2023_Rebrand/templates/partials/header.html"]{
    position: sticky;
    top: 0;
    z-index: 9999;
  }

  .header-wrapper svg{
    width: 12px;
    color: #A2BFAC;
    margin-right: 10px;
  }

  .header-wrapper .menu-item:hover svg{
    color: #053638;
    transform: rotate(180deg);
    transition: all .4s cubic-bezier(.645,.045,.355,1);
  }

  .header-top-cta ul{
    margin: 0;
    padding: 1rem 0;
  }

  li.cta-buttons {
    padding-top: 2vh;
  }

  .cta-buttons a {
    background-color: #D6F700;      
    font-size: 13px;
    color: #053638;
    
    font-family: 'ReplicaLLWeb-Heavy','Poppins', sans-serif;
      
  }

  .top-header-content-left a { 
    align-items: center;
    display: flex;
    outline: 0;
    container-type: inline-size;
  }

  .menu-open .top-header-content-left {
    margin-left: 1rem;
    margin-top: 0.5rem;
  }

  .menu-back-button, .menu-button, .sub-menu-item {
    display: none;
  }

  .hs-menu-wrapper{
    height: 100%;
  }

  .main-menu-logo {
    height: 2.4rem;
  }

  .main-menu-logo .main-menu-logo--icon-only {
    height: 2.6rem;
  }

  .main-menu-logo--icon-only {
    height: 2.6rem;
    display: none;
  }

  @container (width < 161px) {
    .main-menu-logo {
      display: none;
    }
    .main-menu-logo--icon-only {
      display: block;
    }
  }

  img.main-menu-logo.main-menu-logo--icon-only {
    height: 2.6rem;
  }

  .hs-menu-wrapper ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding-left: 0;
    height: 100%;
    align-items: center;
  }

  .new-menu-items {
    display: none;
  }

  .half-logo{
    width: 10px;
  }

  .half-logo-back{
    width: 10px;
  }

  .menu-close {
    display: none;
    position: absolute;
    top: 10px;
    right: 10px;
    border: none;
    background: none;
    color: grey;
    font-size: 24px;
    cursor: pointer;
  }    

  .hs-menu-item.hs-item-has-children>a{
    padding-left: 20px;
    padding-right: 5px;
  }

  .hs-menu-wrapper.flyouts .hs-menu-children-wrapper li:not(:last-child){
    border-bottom: 1px solid #a2bfac;
  }

  .hs-menu-wrapper.flyouts .hs-menu-children-wrapper {
    opacity: 0;
    position: absolute;
    padding: 45px 20px 5px 20px;
    background-color: white;
    line-height: 20px;
    border-radius: 3px;
  }

  .hs-menu-wrapper.active {
    display: block;
  }

  .menu-button {
    display: none;
    padding: 10px 20px;
    background-color: #D6F700;
    border: none;
  }

  .top-header-wrap{
    display:flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 2rem;
  } 

  .top-header-content-right .submenu a{
    font-size: 15px;
    color: #053638;
    
    font-family: 'Aeonik-Regular','Poppins', sans-serif;
      
      ;  
  }

  .hs-menu-wrapper.flyouts .hs-menu-children-wrapper a{
    display: block;
    white-space: nowrap;
    line-height: 55px;
    text-transform: capitalize;
  }

  .top-header-content-right {
    display: flex;
    flex-direction: row;
  }

  .book-assessment-section{
    display: none;
  }

  .book-assessment-section{
    background-color: #D6F700;
    padding: 2vh 6vw;
  }

  .book-assessment-section p{
    color: black;
    font-size : 5vw;
    color: #053638;
    
    font-family: 'Aeonik-Bold','Poppins', sans-serif;
      
  }

  .book-assessment-section button{
    padding: 1vh 3vw;
    background-color: #053638;
    border: none;
  }  

  .book-assessment-section button.cta-button-contact a{
    color: white;
    font-size : 4vw;
    padding: 1vh 4vw;
    font-size : 4vw;
    color: #FFFFFF;
    
    font-family: 'Aeonik-Bold','Poppins', sans-serif;
      
  }    
  .top-header-wrap .hs-menu-item a{
    color: #053638;
    text-transform: uppercase;
  }

  @media screen and (width < 1280px) {

    .header-wrapper svg {
      display: none;
    }

    .top-header-wrap {
      padding: 0 .625rem;
    }

    .menu-item span {
      padding: 0.5rem 0.625rem;
    }

    .header-top-cta ul{
      margin: 0;
      padding: 0.9rem 0;
    }

    li.cta-buttons:not(:last-of-type) {
      padding-right: 1rem;
    }

    .menu-item span {
      font-size: 0.75rem;
    }

  }    

  @media screen and (width < 820px) {
    .header-wrapper svg {
      display: unset;
    }

    .header-wrapper .menu-item:hover svg {
      color: inherit;
      transform: none;
      transition: all .4s cubic-bezier(.645,.045,.355,1);
    }

    .menu-item {
      height: 10vw;
    }

    .top-header-content-left img {
      
      max-width: none;
      height: none;
    }

    .menu-item:hover {
      background-color: inherit;
    }

    .menu-item:hover .submenu {
      display: none;
    }

    .submenu {
      background-color: transparent;
    }  

    .sub-menu-items {
      height: 7vw;
    }

    .main-menu{
      display: none;
    }

    .menu-open .main-menu{
      width: 100%;
      position: fixed;
      top: 16vw;
    }

    .menu-open .menu-item span {
      padding: 10px 0;
    }

    .menu-open .top-header-content-left{ 
      margin-left: 3vw;
      margin-top: 2vw;
    }

    .menu-open .top-header-content-right svg{
      margin: 0px;
    }

    .menu-button{
      display: block;
    }

    .top-header-wrap{
      padding: 2vw 3vw;
    }      

    .header-top-cta { display: none; }  

    .top-header-wrap.menu-open  .book-assessment-section{
      display: block;
      width: 100%;
    }

    .top-header-wrap.menu-open svg{
      width: 5vw;
      transform: rotate(270deg); 
    }

    .submenu-open svg{
      display: none;
    }

    .submenu-open.flex-container{
      align-items: start;
      height: 100%;
    }   

    .menu-open .hs-menu-wrapper.flyouts .hs-menu-item:not(.submenu-open) .hs-menu-children-wrapper {
      display: none;
      position: absolute;
      padding: 45px 20px 5px 20px;
      opacity: 0;
    }

    .menu-open .hs-menu-wrapper.flyouts .hs-menu-item.submenu-open .hs-menu-children-wrapper li {
      opacity: 1;
      border:none;  
      display:flex;
    }

    .menu-open .main-menu .menu-item.submenu-open .submenu{
      display:block;
      position: relative;
      padding-top: 15px;       
    }

    .menu-open .main-menu .menu-item.submenu-open .submenu li{
      background-color: transparent;
      border: none;
      padding: 0px;
      line-height: 1.333;
    }

    .half-logo{
      width: 5vw;
      transform: rotate(270deg);      
    }
    .hs-menu-wrapper ul {
      width: 95vw;
      margin-left: auto;
      margin-right: auto;
      padding-right: 5vw;
    }

    .top-header-wrap.menu-open .new-menu-items:not(.flex-container){
      display: block;
    }

    body.noscroll {
      overflow: hidden;
      height: 100dvh;
      background-color:#053638;
    }  


    .top-header-wrap.menu-open {
      flex-direction: column;
      height: 100dvh;
      width: 100vw;
      background-color:#053638;
      justify-content: space-between;
      align-items: unset;
      padding-left: 0px;
      padding-right: 0px;
      padding-bottom: 0px;
    }

    .hs-menu-wrapper {
      display: none;
      z-index: 1000;     
    }  

    .menu-button {
      display: block;        
    }      

    .top-header-content-right {
      display: flex;
      flex-direction: row;
      align-items: end;
      text-align: left ;
    }

    .top-header-wrap.menu-open .menu-item span, 
    .contact-us-new-link a{
      color: #d6f700;
      font-size: 8vw;        
      margin: 0px;
      text-transform: uppercase;
      font-family: 'ReplicaLLWeb-Heavy';
    }

    .top-header-wrap.menu-open .submenu-item, 
    .privacy-new-link a, 
    .terms-new-link a, 
    .locations-new-link a {
      color: #A2BFAC;
      text-transform: none;
      font-size: 4vw;
      padding: 0px;
      margin: 0px;
      text-decoration: underline;
    }

    .flex-container{
      display:flex;
      justify-content: space-between;
    }

    .menu-open p{
      margin:0px 0px 0.5vh 0px;
    }

    .menu-back-button {
      padding-left: 1vw;
      display: flex;
      flex-direction: row;
      align-items: center;
      margin: 3vw 0 3vw -2vw;
    }

    .menu-back-button img{
      transform: rotate(90deg);
    }

    .menu-back-button button{
      background-color:transparent;
      border-radius: 0px;
      color: white;
      border: none;
      width: auto;
      text-align: left;
      cursor: pointer;
      font-size: 3.5vw;
      padding: 1vw;
    }

    .menu-item a:hover, 
    .menu-item a:focus {
      color: #d6f700 !important;
    }

    .hs-menu-wrapper.flyouts .hs-menu-children-wrapper {
      opacity: 1;
      position: relative;
      padding: 0px 0px 0px 0px;
      background-color: #053638;
      line-height: normal;
      border-radius: 0px;
    }

    .hs-menu-wrapper.flyouts .hs-menu-children-wrapper li a{
      text-decoration: underline;
      color: #a2bfac;
      font-size: 5vw;
    }    

    .submenu-open{
      flex-direction: column;        
    }

    .submenu-open img{
      display: none;        
    }
  }

  @media screen and (min-width: 821px) and (max-width: 990px)  {
    .main-menu{
      padding: 0 1vw !important;
    }

    .main-menu span, .header-top-cta .cta-buttons a{
      font-size: 1.35vw !important;
      padding: 1.25vw !important;
    }

    .main-menu svg{
      width: 1.4vw !important;
    }

    .top-header-wrap{
      padding: 0 1vw !important;
    }

    .menu-item span {
      padding: 0.5rem;
    }
  }

  @media screen and (max-width: 820px)  {
    .main-menu{
      padding: 0 3vw !important;
    }
  }

</style>

