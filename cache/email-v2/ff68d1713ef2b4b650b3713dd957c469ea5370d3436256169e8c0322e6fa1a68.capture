    font-size: 1.125rem;
  }

  /*
  ==================================================
  Two Col Adjust 
  ==================================================
  */

  body .two-col-adjust > span {
    -webkit-box-align: stretch;
    -moz-box-align: stretch;
    -webkit-align-items: stretch;
    -ms-flex-align: stretch;
    align-items: stretch;
    flex-wrap: wrap;
    -wevkit-flex-wrap: wrap;
    flex-direction: row;
    -webkit-flex-direction: row;
    margin-right: 0;
    column-gap: 3vw;
  }

  body .row-fluid .two-col-adjust span > .hs_cos_wrapper {
    display: -webkit-box;
    display: -moz-box;
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    flex-basis: 46%;
    -webkit-flex-basis: 46%;
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
    position: relative;
  }

  body .two-col-adjust>span .hs_cos_wrapper:nth-child(2n) {
    margin-right: 0;
    flex-basis: 38%;
    -webkit-flex-basis: 38%;
  }

  @media(max-width:1280px) {
  }

  @media(max-width:1100px) {
    body .row-fluid .two-col-adjust span > .hs_cos_wrapper {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 0;
      float: none;
    }

    body .container-fluid .row-fluid .two-col-adjust > span {
      display: flex;
      margin: 0;
    }

    .content-region-left {
      width: 100%;
    }

    .content-region-right {
      width: 100%;
      padding-bottom: 0;
    }

    .form-contact-region {
      padding: 30px 0 50px;
    }

    #map {
      aspect-ratio: 5 / 3;
    }

    .form-contact-innter {
      display: grid;
    }
  }

  @media(max-width: 820px) {
    .content-region .content-wrapper {
