<script>
var hsVars = hsVars || {}; hsVars['language'] = 'en';
</script>

<script src="/hs/hsstatic/cos-i18n/static-1.53/bundles/project.js"></script>


<script>

  let menuButton = $('.menu-button');
  let menu = $('.main-menu');
  let menuUL = $('.main-menu');
  let topHeaderWrap = $('.top-header-wrap')
  let body = $('body');
  let closeMenuButton = $('.menu-close')
  let newMenuItems = $('.new-menu-items')
  let menuItemsLevel1 = $('.hs-menu-depth-1')

  let privacyPolicyPage = "https://www.energysmart.co.nz/about-us/privacy-policy/"    
  let termsAndConditionsPage = "https://www.energysmart.co.nz/about-us/terms-conditions/"   

  function resetMobileMenuStatus(){
    if ($('.top-header-wrap').hasClass("menu-open")){
      $('.open-menu-list').removeClass("open-menu-list")
      $('.menu-button').hide();
      $('.new-menu-items').show();
      $('.submenu-open ul').hide();
      $('.submenu-open').removeClass("submenu-open")
      $('.menu-back-button').hide();
      $('.locations-new-link').show();
      $('.book-assessment-section').show();
      $('.menu-close').show();
    } else {
      $('.menu-button').show();
      $('.new-menu-items').hide();
      $('.menu-back-button').hide();
      $('.book-assessment-section').hide();
      $('.menu-close').hide();      
    }

  }


  function toggleMenu(){
    console.log("Toggle menu on/off")
    $('.new-menu-items').toggle(); 
    console.log("Currently this section is visible: "+$('.book-assessment-section').is(":visible"))
    $('.book-assessment-section').toggle();
    console.log("After toggle this section is visible: "+$('.book-assessment-section').is(":visible"))
    $('.menu-button').toggle();
    $('.menu-close').toggle();
    $('.main-menu').toggle();
    $(menu).toggleClass('active')
    $(topHeaderWrap).toggleClass('menu-open');
    $(body).toggleClass('noscroll')       
  }

  function navigateMenu(event, clickedElement) {
    if (window.innerWidth <= 820 && clickedElement.hasClass("top-level") && !clickedElement.hasClass("submenu-open")) {
      // just open sub-menu 
      event.preventDefault();
    }

    event.stopPropagation();

    if (clickedElement.hasClass("submenu-open")){
      console.log("Clicking same menu item so do nothing");
      return;
    }

    if (clickedElement.hasClass("menu-back-button")){
      console.log("Going back and hiding back button")
      $('.menu-back-button').toggle();
      $('.submenu').hide();
      $('.submenu-item').hide();
      $('.menu-item').show();
      $(".submenu-open").removeClass("submenu-open")
      return;
    }

    console.log("Back shouldn't reach here")
    let thisMenuItem =  clickedElement;      
    $('.menu-back-button').show()
    let allMenuSiblings = thisMenuItem.siblings('.menu-item');
    let newContactUsLink = $('.contact-us-new-link');
    //allMenuSiblings.add(newContactUsLink);
    console.log("Found siblings x " + allMenuSiblings.length);
    //allMenuSiblings.css("background-color", "red")
    allMenuSiblings.hide();
    //$('.privacy-new-link').hide();
    //$('.terms-new-link').hide();
    //newContactUsLink.hide();
    thisMenuItem.addClass("submenu-open")
    thisMenuItem.find('ul li').show()
    thisMenuItem.find('ul').show()
  }

  $(document).ready(function() {    
    //     console.log("Document is ready!");

    $(menuUL).prepend('<div style="display:none;" class="menu-back-button"><img class = "half-logo-back" src="https://kiwi.energysmart.co.nz/hubfs/Resources/Logos/dropdown_arrow.svg" alt="Half logo"><button>Back</button></div>')
    $(menuUL).append('<li style="display:flex; display:;" class="contact-us-new-link menu-item hs-item-has-children new-menu-items flex-container" role="none"><a href="contact-us" aria-expanded="false" role="menuitem">Contact us</a><img class = "half-logo" src="https://kiwi.energysmart.co.nz/hubfs/Resources/Logos/dropdown_arrow.svg" alt="Half logo"></li>')
    
    $(menuUL).append(`<li style="display:none;" class="privacy-new-link menu-item new-menu-items sub-menu-items"><a href="${privacyPolicyPage}"  aria-expanded="false" role="menuitem">Privacy Policy</a></li>`)
    $(menuUL).append(`<li style="display:none;" class="terms-new-link menu-item new-menu-items sub-menu-items"><a href="${termsAndConditionsPage}"  aria-expanded="false" role="menuitem">Terms & Conditions</a></li>`)
    $(topHeaderWrap).append('<div style="display:none;" class="book-assessment-section clipped-corner-medium-top-left"><p>BOOK A FREE ASSESSMENT</p><button class="clipped-corner-small-both cta-button-contact"><a href="contact-us">CONTACT US NOW</a></button></div>')


    $('body').on('click', '.menu-button', function() {
      winWidth = window.innerWidth;
      if ( winWidth > 820 ) return;
      toggleMenu();
    });

    $('body').on('click', '.menu-close', function() {
      winWidth = window.innerWidth;
      if ( winWidth > 820 ) return;
      toggleMenu();
    });  

    $('body').on('click', '.menu-back-button', function() {
      winWidth = window.innerWidth;
      if ( winWidth > 820 ) return;
      navigateMenu(event, $(this));
    });

    $('body').on('click', '.menu-item:has(.submenu)', function() {
      winWidth = window.innerWidth;
      if ( winWidth > 820 ) return;
      navigateMenu(event, $(this))
    });    

    initJavascript()



  });


  addEventListener("resize", (event) => initJavascript());

  addEventListener("navigate", (event) => resetMobileMenuStatus());

  function initJavascript(){ 

    $('.menu-button').show();
    //     console.log("$(width) is "+ $(window).width())
    //     console.log("width is "+ window.innerWidth)
    //     console.log("document width is "+ $(document).width())
    if (window.innerWidth > 820) {
      //       console.log("Showing menu")
      $('.hs-menu-item').show()
      $('.new-menu-items').hide();
      $('.menu-back-button').hide();
      $('.book-assessment-section').hide();
      $('.menu-button').hide();
      $('.menu-close').hide();
      return;
    } else {
      //       console.log("Showing menu button")
      resetMobileMenuStatus();
    }
  }

</script> 

<script src="https://www.energysmart.co.nz/hubfs/hub_generated/module_assets/1/155626994802/1744250630778/module_Navigation_-_Breadcrumb_and_Search.min.js"></script>

  <script>
    try {
      const images = document.getElementsByClassName('container')[1].getElementsByClassName('image-box')

      const toggleImages = (event) => {
        for (let image of images) {
          window.innerWidth <= 820
            ? image.hidden = true
          : image.hidden = false
        }
        //           console.log(`setting ${image} to ${image.hidden}`)
      }

      toggleImages()

      addEventListener("resize", (event) => toggleImages(event))

    } catch (error) {
      console.error(error)
    }

  </script>
  

