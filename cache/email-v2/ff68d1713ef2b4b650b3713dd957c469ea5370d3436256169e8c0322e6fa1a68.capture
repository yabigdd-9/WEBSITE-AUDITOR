    }

    .content-region-left p {
      font-size: 3vw;
      margin-bottom: 3vw;
      text-wrap-style: balance;
    }

  }

</style>


<style>
  .form-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .module-send-us-a-message .form-left ul {
    list-style-type: none;
    padding-left: 0;
  }

  .module-send-us-a-message .actions {
