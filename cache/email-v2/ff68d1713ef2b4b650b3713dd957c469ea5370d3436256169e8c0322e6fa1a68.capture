    }

    #a-unique-and-descriptive-name .table-text {
      max-width: 100% !important;
      text-align: CENTER !important;
      line-height: 32px !important;
      margin-top:px !important;
      margin-bottom:px !important;
      padding-bottom:px !important;
      padding-top:px !important;
      padding-left:px !important;
      padding-right:px !important;
      color:  !important;
      font-size:32px !important;
      
      font-family: 'ReplicaLLWeb-Heavy','Poppins', sans-serif !important;
        
    }

    #a-unique-and-descriptive-name .bottom-button .logo-only {
      height: 0.6rem;
      margin-left: 0.25rem;
    }

    #a-unique-and-descriptive-name .bottom-link .logo-only {
      width: 13px;
      transform: translate(px, px);
    }

    #a-unique-and-descriptive-name .container {
      width: 100%;
      position: relative;
       
      padding: 2rem;
      
    }

    #a-unique-and-descriptive-name .text-box {
      color: white;
      flex-basis: 50%;
      

      
      padding: 4rem 5rem;
      
    }

    #a-unique-and-descriptive-name .text-box p {
      
      color: #053638;
      
    }

    

    #a-unique-and-descriptive-name .row {
      display: flex;
      flex-direction: row;
      
    }

    #a-unique-and-descriptive-name .box {
      box-sizing: border-box;
    }

    #a-unique-and-descriptive-name .image-box {
      flex-basis: 50%;
      display: flex;
      overflow: hidden;
    }


    #a-unique-and-descriptive-name .text-left .text-box,
    #a-unique-and-descriptive-name .text-right .image-box {
      order: 1;
    }

    #a-unique-and-descriptive-name .text-left .image-box,
    #a-unique-and-descriptive-name .text-right .text-box {
      order: 2;
    }

    /* standard styling when an image is being used  */
    #a-unique-and-descriptive-name .image-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      /* aspect ratio is treated as a suggestion and is only applied by browser when possible. text in the corresponding row will take priority to dictate the height of the image */
      aspect-ratio: 16/9;
    } 

    /* addition to styling: if an iframe is being used as a code embed (expecting a google map) */
    #a-unique-and-descriptive-name .image-box iframe {
      width: 100%;
      height: 100%;
      aspect-ratio: 4 / 3;
      border: 0;
    } 

    #a-unique-and-descriptive-name .corner-cut-top-left { 
      background: linear-gradient(deg, rgba(5,53,57,1) %, rgba(5,53,57,1) %, rgba(5,53,57,1) 100%, rgba(5,53,57,0) 100%);
    }    

    #a-unique-and-descriptive-name .text-right .corner-cut-bottom-right { 
      background: linear-gradient(deg, rgba(5,53,57,0) %, rgba(5,53,57,1) %, rgba(5,53,57,1) 100%, rgba(5,53,57,1) 100%);
    }

    #a-unique-and-descriptive-name .box:not(.corner-cut-top-left):not(.corner-cut-bottom-right), 
    #a-unique-and-descriptive-name .text-left .corner-cut-bottom-right {
      
      background: white;
      
    }

    #a-unique-and-descriptive-name table{
      color: white;
      background-color: transparent;
      border-collapse: collapse;
      width: 100%;
    }

    #a-unique-and-descriptive-name td:first-child {
      
    }

    #a-unique-and-descriptive-name td {
      border: none;
      text-align: left !important;
      background-color: transparent;  
      color: #053638 !important; 
    }

    #a-unique-and-descriptive-name tr { 
      border-bottom: 1px solid #a2bfac;
      color: #053638;
    }

    #a-unique-and-descriptive-name th {
      background-color: transparent;
      border-bottom: 1px solid #a2bfac;
      color: #053638;
      border: none;
      text-align: left !important;
    }

    #a-unique-and-descriptive-name tr td:first-child {
      color: #053638;
      text-align: left !important;
    }

    .table-wrapper {
      margin-bottom: 2rem;
    }

    @media (max-width: 1280px) {

      #a-unique-and-descriptive-name .box-heading {
        font-size: 5vw;
      }

      #a-unique-and-descriptive-name .box-subtext {
        font-size: 1.8vw;
      }

      /* hang on - the 'card-wrapper' class isn't used in this module. this selector is probably having no effect. flex-direction is actually being set as 'row' in the .row selector earlier in this css spaghetti */
      #a-unique-and-descriptive-name .card-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      #a-unique-and-descriptive-name .text-box {
        padding: 6vw 3vw;
      }

      #a-unique-and-descriptive-name li {
        font-size: 1.8vw;
        margin-left: 2vw;
        margin-bottom: 0.8vw;
      }

      #a-unique-and-descriptive-name li .logo-only {
        height: 1.4vw;
        left: -2vw;
        top: 0.4vw;
      }  

      #a-unique-and-descriptive-name .bottom-button {
        font-size: 1.5vw;
        
      }
    }

    @media (max-width: 820px) {

      #a-unique-and-descriptive-name {
        margin-bottom: 0 !important;
      }

      #a-unique-and-descriptive-name .container {
         
        padding: 0 3vw 3vw;
        
      }

      #a-unique-and-descriptive-name li {
        font-size: 3.5vw;
        margin-bottom: 2vw;
        margin-left: 5vw;
      }

      #a-unique-and-descriptive-name li .logo-only {
        height: 2.6vw;
        left: -5vw;
        top: 0.9vw;
      }

      #a-unique-and-descriptive-name .clipped-corner-large-bottom-right{
        clip-path:none;
      }

      #a-unique-and-descriptive-name .last-row.text-right .image-box{
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 43px), calc(100% - 51.24px) 100%, 0 100%);
      }

      #a-unique-and-descriptive-name .text-left .text-box,
      #a-unique-and-descriptive-name .text-right .image-box {
        order: unset;
      }

      #a-unique-and-descriptive-name .text-left .image-box,
      #a-unique-and-descriptive-name .text-right .text-box {
        order: unset;
      }  

      #a-unique-and-descriptive-name .bottom-button .logo-only {
        height: 1.7vw;
        margin-left: 0.4vw;
      }

      #a-unique-and-descriptive-name .row {
        height: auto;
      }

      #a-unique-and-descriptive-name .image-box {
        height: 50vh;        
      }
      
      /* hide the image on small screen widths for compact banner style */
      

      #a-unique-and-descriptive-name .main-heading {
        margin: 0 auto !important;
        padding: 6vw !important;
        font-size: 7.5vw !important;
        max-width: unset !important;
      }

      #a-unique-and-descriptive-name .subtext {
        line-height: 1.28 !important;
        margin: 0 !important;
        padding: 3vw !important;
        font-size: 4.25vw !important;
      }

      #a-unique-and-descriptive-name .row {
        flex-direction: column;
        min-height: revert;
      }

      #a-unique-and-descriptive-name .text-box {
        min-height: fit-content;
        
      }

      #a-unique-and-descriptive-name .box-heading {
        font-size: 10.5vw !important;
        margin: 0 0 3vw !important;
        padding: 0 !important;
      }

      #a-unique-and-descriptive-name .box-subtext {
        
        font-size: 3.5vw !important;
        
        padding-bottom: 2vw !important; 
        margin: 0;
      }

      #a-unique-and-descriptive-name .bottom-button {
        font-size: 2.6vw;
        padding: 1.7vw 2.8vw;
        margin: 0;
      }

      .table-wrapper {
        margin-bottom: 6vw;
        font-size: 3.5vw
      }

      p {
        font-size: 3.3vw;
        margin: 0;
      }

    }    

    

    #a-unique-and-descriptive-name .deal__container {
      /*         needs own clip path for corners, as default class is overridden in this module  */
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 43px), calc(100% - 51.24px) 100%, 0 100%);        
      position: absolute;
      background: #fffe;
      bottom: 2rem;
      padding: 1.8rem 2.6rem;
      left: 45%;
      min-width: 400px;
      max-width: 50%;
      width: fit-content;

      @media (max-width: 820px) {
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 6.2vw), calc(100% - 7.37vw) 100%, 0 100%);
        bottom: unset;
        left: unset;
        top: 48%;
        right: 3vw;
        padding: 2vw 4vw 2vw 3vw;
        min-width: 45%;
        max-width: 60%;
      }
    }

    #a-unique-and-descriptive-name .deal__container:after {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      max-height: 80%;
      left: 4%;
      bottom: 10%;
      background: #a2bfac55;
      mask-image: url(https://www.energysmart.co.nz/hubfs/Resources/Logos/EnergySmart%20Icon_Green.svg);
      mask-repeat: no-repeat;
      z-index: -1;
    }

    #a-unique-and-descriptive-name .deal__heading {
      font-family: 'ReplicaLLWeb-Heavy', sans-serif;
      font-size: 1.8rem;
      text-transform: uppercase;
      text-wrap: balance;
      line-height: .88;
      color: #114242;
      margin-bottom: 0.5rem;

      @media (max-width: 820px) {
        font-size: 3.8vw;
        margin-bottom: .8vw;
      }
    }

    #a-unique-and-descriptive-name .deal__text {    
      font-size: 1.2rem;
      line-height: 1.333;
      text-wrap: pretty;

      @media (max-width: 820px) {
        font-size: 2.8vw;
        line-height: 1.25;
      }
    }


  </style>
  

