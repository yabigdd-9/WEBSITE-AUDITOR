ref=\"\u002Frefrigeration-services\">Refrigeration Services\u003C\u002Fa>\u003C\u002Fli>\n                \u003C\u002Ful>\n            \u003C\u002Fdiv>\n\n            \u003C!-- Company Links Column -->\n            \u003Cdiv class=\"footer-column footer-links\">\n                \u003Ch3>Company\u003C\u002Fh3>\n                \u003Cul>\n                    \u003Cli>\u003Ca href=\"\u002F\">Home\u003C\u002Fa>\u003C\u002Fli>\n                    \u003Cli>\u003Ca href=\"\u002Fabout\">About Us\u003C\u002Fa>\u003C\u002Fli>\n                    \u003Cli>\u003Ca href=\"\u002Fcontact\">Contact\u003C\u002Fa>\u003C\u002Fli>\n                    \u003Cli>\u003Ca href=\"\u002Fblog\">Blog\u003C\u002Fa>\u003C\u002Fli>\n                \u003C\u002Ful>\n            \u003C\u002Fdiv>\n\n            \u003C!-- Service Areas & Map Column -->\n            \u003Cdiv class=\"footer-column footer-map\">\n                \u003Ch3>Service Areas\u003C\u002Fh3>\n                \u003Cp class=\"service-areas-text\">Proudly servicing Christchurch, Rolleston, and surrounding areas\u003C\u002Fp>\n                \u003Cdiv class=\"map-container\">\n                    \u003Ciframe src=\"https:\u002F\u002Fwww.google.com\u002Fmaps\u002Fembed?pb=!1m18!1m12!1m3!1d3729.2216221930757!2d172.62693007616997!3d-43.52377817110857!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6d318b45f7fbb3a3%3A0xbd32a2b362377e66!2sAlpha%20Heat%20Pumps%20Christchurch%20Chch!5e1!3m2!1sen!2snz!4v1765924200632!5m2!1sen!2snz\" \n                            width=\"100%\" \n                            height=\"200\" \n                            style=\"border:0;\" \n                            allowfullscreen=\"\" \n                            loading=\"lazy\" \n                            referrerpolicy=\"no-referrer-when-downgrade\"\n                            title=\"Alpha Heat Pumps Christchurch Location\">\n                    \u003C\u002Fiframe>\n                \u003C\u002Fdiv>\n            \u003C\u002Fdiv>\n        \u003C\u002Fdiv>\n\n        \u003C!-- Footer Bottom -->\n        \u003Cdiv class=\"footer-bottom\">\n            \u003Cp class=\"footer-copyright\">\n                &copy; \u003Cspan id=\"currentYear\">\u003C\u002Fspan> Alpha Heat Pumps Christchurch. All rights reserved.\n            \u003C\u002Fp>\n            \u003Ca href=\"https:\u002F\u002Fsnbusinesssolutions.co.nz\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"footer-credit-badge\">\n                \u003Cspan class=\"credit-text\">Website & Marketing by\u003C\u002Fspan>\n                \u003Cspan class=\"credit-company\">SN Business Solutions\u003C\u002Fspan>\n                \u003Csvg class=\"credit-arrow\" xmlns=\"http:\u002F\u002Fwww.w3.org\u002F2000\u002Fsvg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                    \u003Cline x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\">\u003C\u002Fline>\n                    \u003Cpolyline points=\"12 5 19 12 12 19\">\u003C\u002Fpolyline>\n                \u003C\u002Fsvg>\n            \u003C\u002Fa>\n        \u003C\u002Fdiv>\n    \u003C\u002Fdiv>\n\u003C\u002Ffooter>\n\n\u003Cstyle>\n    \u002F* ========================================\n       FOOTER STYLES\n       ======================================== *\u002F\n\n    .site-footer {\n        background: linear-gradient(135deg, #2a2a2a 0%, var(--alpha-grey) 100%);\n        color: var(--white);\n        padding: 60px 0 0;\n        margin-top: 80px;\n        position: relative;\n        overflow: hidden;\n    }\n\n    .site-footer::before {\n        content: '';\n        position: absolute;\n        top: 0;\n        left: 0;\n        right: 0;\n        height: 4px;\n        background: linear-gradient(90deg, var(--alpha-blue) 0%, var(--alpha-red) 100%);\n    }\n\n    .footer-container {\n        max-width: 1400px;\n        margin: 0 auto;\n        padding: 0 30px;\n    }\n\n    \u002F* Footer Top Grid *\u002F\n    .footer-top {\n        display: grid;\n        grid-template-columns: 1fr;\n        gap: 40px;\n        padding-bottom: 40px;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n    }\n\n    \u002F* Company Info Column *\u002F\n    .footer-company {\n        max-width: 100%;\n    }\n\n    .footer-logo-wrapper {\n        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.9) 100%);\n        padding: 15px 20px;\n        border-radius: 8px;\n        display: inline-block;\n        margin-bottom: 20px;\n        box-shadow: 0 4px 15px rgba(2, 203, 254, 0.15);\n        border: 1px solid rgba(2, 203, 254, 0.2);\n    }\n\n    .footer-logo {\n        height: 45px;\n        width: auto;\n        display: block;\n    }\n\n    .footer-tagline {\n        font-size: 14px;\n        line-height: 1.6;\n        color: rgba(255, 255, 255, 0.85);\n        margin-bottom: 25px;\n    }\n\n    .footer-contact-info {\n        margin-bottom: 25px;\n    }\n\n    .footer-contact-item {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        color: var(--white);\n        text-decoration: none;\n        font-size: 15px;\n        font-weight: 500;\n        margin-bottom: 14px;\n        transition: all 0.3s ease;\n        padding: 8px 0;\n    }\n\n    .footer-contact-item:hover {\n        color: var(--alpha-blue);\n        padding-left: 5px;\n    }\n\n.footer-contact-item svg {\n    flex-shrink: 0;\n    fill: var(--alpha-blue);\n    filter: drop-shadow(0 0 4px rgba(2, 203, 254, 0.3));\n}\n\n\u002F* Keep email icon with stroke *\u002F\n.footer-contact-item:nth-child(2) svg {\n    fill: none;\n    stroke: var(--alpha-blue);\n}\n\n    .footer-hours {\n        margin-bottom: 25px;\n        background: rgba(255, 255, 255, 0.05);\n        padding: 20px;\n        border-radius: 8px;\n        border-left: 3px solid var(--alpha-blue);\n    }\n\n    .footer-hours h4 {\n        font-size: 16px;\n        font-weight: 600;\n        color: var(--white);\n        margin-bottom: 12px;\n        display: flex;\n        align-items: center;\n        gap: 8px;\n    }\n\n\n\n    .footer-hours p {\n        font-size: 14px;\n        color: rgba(255, 255, 255, 0.85);\n        margin-bottom: 6px;\n    }\n\n    .footer-hours strong {\n        color: var(--alpha-blue);\n        font-weight: 600;\n    }\n\n    \u002F* Social Links *\u002F\n    .footer-social {\n        display: flex;\n        gap: 15px;\n    }\n\n    .social-link {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        width: 44px;\n        height: 44px;\n        background: linear-gradient(135deg, rgba(2, 203, 254, 0.1) 0%, rgba(2, 203, 254, 0.05) 100%);\n        border: 2px solid rgba(2, 203, 254, 0.3);\n        border-radius: 50%;\n        color: var(--white);\n        transition: all 0.3s ease;\n    }\n\n    .social-link:hover {\n        background: linear-gradient(135deg, var(--alpha-blue) 0%, #0198c7 100%);\n        border-color: var(--alpha-blue);\n        transform: translateY(-3px) scale(1.05);\n        box-shadow: 0 6px 20px rgba(2, 203, 254, 0.4);\n    }\n\n    \u002F* Footer Links Columns *\u002F\n    .footer-links h3 {\n        font-size: 18px;\n        font-weight: 600;\n        color: var(--white);\n        margin-bottom: 20px;\n        position: relative;\n        padding-bottom: 12px;\n    }\n\n    .footer-links h3::after {\n        content: '';\n        position: absolute;\n        bottom: 0;\n        left: 0;\n        width: 40px;\n        height: 3px;\n        background: linear-gradient(90deg, var(--alpha-blue) 0%, transparent 100%);\n        border-radius: 2px;\n    }\n\n    .footer-links ul {\n        list-style: none;\n    }\n\n    .footer-links li {\n        margin-bottom: 12px;\n    }\n\n    .footer-links a {\n        color: rgba(255, 255, 255, 0.8);\n        text-decoration: none;\n        font-size: 14px;\n        transition: all 0.3s ease;\n        display: inline-block;\n        position: relative;\n    }\n\n    .footer-links a::before {\n        content: '→';\n        position: absolute;\n        left: -20px;\n        opacity: 0;\n        color: var(--alpha-blue);\n        transition: all 0.3s ease;\n    }\n\n    .footer-links a:hover {\n        color: var(--alpha-blue);\n        padding-left: 20px;\n    }\n\n    .footer-links a:hover::before {\n        opacity: 1;\n        left: 0;\n    }\n\n    \u002F* Map Column *\u002F\n    .footer-map h3 {\n        font-size: 18px;\n        font-weight: 600;\n        color: var(--white);\n        margin-bottom: 15px;\n        position: relative;\n        padding-bottom: 12px;\n    }\n\n    .footer-map h3::after {\n        content: '';\n        position: absolute;\n        bottom: 0;\n        left: 0;\n        width: 40px;\n        height: 3px;\n        background: linear-gradient(90deg, var(--alpha-blue) 0%, transparent 100%);\n        border-radius: 2px;\n    }\n\n    .service-areas-text {\n        font-size: 14px;\n        color: rgba(255, 255, 255, 0.85);\n        margin-bottom: 20px;\n        line-height: 1.6;\n    }\n\n    .map-container {\n        border-radius: 10px;\n        overflow: hidden;\n        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);\n        border: 2px solid rgba(2, 203, 254, 0.2);\n        transition: all 0.3s ease;\n    }\n\n    .map-container:hover {\n        border-color: var(--alpha-blue);\n        box-shadow: 0 8px 30px rgba(2, 203, 254, 0.3);\n        transform: translateY(-2px);\n    }\n\n    .map-container iframe {\n        display: block;\n        width: 100%;\n        filter: grayscale(20%) contrast(1.1);\n    }\n\n    \u002F* Footer Bottom *\u002F\n    .footer-bottom {\n        padding: 30px 0;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        gap: 20px;\n    }\n\n    .footer-copyright {\n        font-size: 14px;\n        color: rgba(255, 255, 255, 0.6);\n        margin: 0;\n    }\n\n    .footer-credit-badge {\n        display: inline-flex;\n        align-items: center;\n        gap: 12px;\n        padding: 14px 24px;\n        background: linear-gradient(135deg, rgba(2, 203, 254, 0.1) 0%, rgba(252, 1, 1, 0.1) 100%);\n        border: 2px solid rgba(2, 203, 254, 0.3);\n        border-radius: 50px;\n        text-decoration: none;\n        transition: all 0.3s ease;\n        position: relative;\n        overflow: hidden;\n    }\n\n    .footer-credit-badge::before {\n        content: '';\n        position: absolute;\n        top: 0;\n        left: -100%;\n        width: 100%;\n        height: 100%;\n        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);\n        transition: left 0.5s ease;\n    }\n\n    .footer-credit-badge:hover::before {\n        left: 100%;\n    }\n\n    .footer-credit-badge:hover {\n        border-color: var(--alpha-blue);\n        background: linear-gradient(135deg, rgba(2, 203, 254, 0.2) 0%, rgba(252, 1, 1, 0.15) 100%);\n        transform: translateY(-3px);\n        box-shadow: 0 8px 25px rgba(2, 203, 254, 0.3);\n    }\n\n    .credit-text {\n        font-size: 13px;\n        color: rgba(255, 255, 255, 0.7);\n        font-weight: 400;\n    }\n\n    .credit-company {\n        font-size: 15px;\n        color: var(--white);\n        font-weight: 700;\n        background: linear-gradient(135deg, var(--alpha-blue) 0%, var(--alpha-red) 100%);\n        -webkit-background-clip: text;\n        -webkit-text-fill-color: transparent;\n        background-clip: text;\n    }\n\n    .credit-arrow {\n        stroke: var(--alpha-blue);\n        transition: transform 0.3s ease;\n    }\n\n    .footer-credit-badge:hover .credit-arrow {\n        transform: translateX(4px);\n    }\n\n    \u002F* ========================================\n       TABLET BREAKPOINT (768px+)\n       ======================================== *\u002F\n\n    @media (min-width: 768px) {\n        .site-footer {\n            padding: 80px 0 0;\n        }\n\n        .footer-container {\n            padding: 0 40px;\n        }\n\n        .footer-top {\n            grid-template-columns: repeat(2, 1fr);\n            gap: 50px;\n            padding-bottom: 50px;\n        }\n\n        .footer-company {\n            grid-column: 1 \u002F -1;\n        }\n\n        .footer-logo {\n            height: 48px;\n        }\n\n        .map-container iframe {\n            height: 250px;\n        }\n\n        .footer-bottom {\n            flex-direction: row;\n            justify-content: space-between;\n            padding: 30px 0;\n        }\n    }\n\n    \u002F* ========================================\n       DESKTOP BREAKPOINT (1024px+)\n       ======================================== *\u002F\n\n    @media (min-width: 1024px) {\n        .footer-top {\n            grid-template-columns: 2fr 1fr 1fr 1.5fr;\n            gap: 60px;\n        }\n\n        .footer-company {\n            grid-column: auto;\n        }\n\n        .footer-logo {\n            height: 50px;\n        }\n\n        .map-container iframe {\n            height: 220px;\n        }\n    }\n\n    \u002F* ========================================\n       LARGE DESKTOP (1200px+)\n       ======================================== *\u002F\n\n    @media (min-width: 1200px) {\n        .footer-container {\n            padding: 0 50px;\n        }\n\n        .footer-top {\n            gap: 80px;\n        }\n    }\n\u003C\u002Fstyle>\n\n\u003Cscript>\n    \u002F\u002F Update copyright year automatically\n    document.getElementById('currentYear').textContent = new Date().getFullYear();\n\u003C\u002Fscript>",{"value":257},[],"ccustom-code-Hiobo_y8vb",{},[],"https:\u002F\u002Ffonts.googleapis.com\u002Fcss?family=Lato:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i%7COpen%20Sans:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i%7CMontserrat:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i%7CRoboto:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i%7CInter:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i%7CPoppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap",[],{"author":264,"canonicalMeta":265,"customMeta":268,"description":272,"imageUrl":273,"keywords":38,"language":274,"title":275,"isPreviewUrl":34},"Carl Hickman",[266],{"content":267},"https:\u002F\u002Falphaheatpumps.co.nz\u002Fhome",[269],{"content":270,"name":271},"index, follow","robots","Alpha Heat Pumps are your local experts in heat pumps Christchurch. We provide professional installation, servicing, and repairs for homes & businesses.\n","https:\u002F\u002Fassets.cdn.filesafe.space\u002F5pwcOgM2ymwHfKFYiutg\u002Fmedia\u002F67a18003b1b7b2128fb98044.png","en","Heat Pumps Christchurch | Heat Pump Installation Christchurch","alphaheatpumps.co.nz","\u002F","xWZv2vxqnwqxq5FQ8JhJ","Home","eiqtkABBcVIjjdOnjlWT",[282],{"id":283,"elements":284,"activeElementId":283},"hl_main_popup-ZNDbF0HvYb",[285],{"extra":286,"class":302,"styles":308,"customCss":311,"id":283,"child":312,"meta":313,"title":314,"tag":38},{"bgImage":287,"overlayColor":289,"left":291,"popupDisabled":293,"minWidth":294,"popupHide":296,"showPopupOnMouseOut":297,"customClass":299,"position":301},{"value":288},{"mediaType":37,"url":38,"opacity":39,"options":40,"svgCode":38,"videoUrl":38,"videoThumbnail":38,"videoLoop":41},{"value":290},"var(--overlay)",{"value":292,"unit":68},50,{"value":34},{"value":295},"medium-page",{"value":34},{"value":298,"delay":101},"exit",{"value":300},[],{"value":91},{"borders":303,"borderRadius":305,"radiusEdge":307},{"value":304},"borderFull",{"value":306},"radius2",{"value":24},{"borderWidth":309},{"value":310,"unit":28},"10",[],[],"hl_main_popup","Popup","https:\u002F\u002Fassets.cdn.filesafe.space\u002F5pwcOgM2ymwHfKFYiutg\u002Fmedia\u002F67b3fdc570fcfe3703288099.png","\u003C!-- Google tag (gtag.js) --