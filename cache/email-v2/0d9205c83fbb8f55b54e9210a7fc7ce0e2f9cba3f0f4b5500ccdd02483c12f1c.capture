                </li>
                <li class="dropdown-item">
                    <a href="/heat-pump-service-christchurch" class="dropdown-link">Servicing & Cleaning</a>
                </li>
            </ul>
        </li>
        <li class="nav-item">
            <a href="/additional-heating-christchurch" class="nav-link">Additional Heating Services</a>
        </li>
        <li class="nav-item">
            <a href="/refrigeration-services" class="nav-link">Refrigeration</a>
        </li>
        <li class="nav-item">
            <a href="/about" class="nav-link">About</a>
        </li>
        <li class="nav-item">
            <a href="/contact" class="nav-link">Contact</a>
        </li>
    </ul>
</nav>

            <!-- Header CTA Section -->
            <div class="header-cta">
                <a href="/contact" class="btn-quote">Get a Quote</a>
            </div>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle mobile menu">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>
        </div>

        <!-- Mobile Navigation -->
     <nav class="mobile-nav" id="mobileNav">
    <ul class="mobile-nav-list">
        <li class="mobile-nav-item">
            <a href="/" class="mobile-nav-link">Home</a>
        </li>
        <li class="mobile-nav-item mobile-dropdown">
            <button class="mobile-dropdown-toggle" data-dropdown="heatPump">
                Heat Pump Services
                <svg class="mobile-dropdown-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
            <ul class="mobile-dropdown-menu">
                <li class="mobile-dropdown-item">
                    <a href="/heat-pumps-christchurch" class="mobile-dropdown-link">Heat Pump Installation</a>
                </li>
                <li class="mobile-dropdown-item">
                    <a href="/daikin-heat-pumps-christchurch" class="mobile-dropdown-link">Why We Use Daikin</a>
                </li>
                <li class="mobile-dropdown-item">
                    <a href="/heat-pump-service-christchurch" class="mobile-dropdown-link">Servicing & Cleaning</a>
                </li>
            </ul>
        </li>
        <li class="mobile-nav-item">
            <a href="/additional-heating-christchurch" class="mobile-nav-link">Additional Heating Services</a>
