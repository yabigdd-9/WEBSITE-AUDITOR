<style>
    /* ========================================
       FOOTER STYLES
       ======================================== */

    .site-footer {
        background: linear-gradient(135deg, #2a2a2a 0%, var(--alpha-grey) 100%);
        color: var(--white);
        padding: 60px 0 0;
        margin-top: 80px;
        position: relative;
        overflow: hidden;
    }

    .site-footer::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--alpha-blue) 0%, var(--alpha-red) 100%);
    }

    .footer-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 30px;
    }

    /* Footer Top Grid */
    .footer-top {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
        padding-bottom: 40px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Company Info Column */
    .footer-company {
        max-width: 100%;
    }

    .footer-logo-wrapper {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.9) 100%);
        padding: 15px 20px;
        border-radius: 8px;
        display: inline-block;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(2, 203, 254, 0.15);
        border: 1px solid rgba(2, 203, 254, 0.2);
    }

    .footer-logo {
        height: 45px;
        width: auto;
        display: block;
    }

    .footer-tagline {
        font-size: 14px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 25px;
    }

    .footer-contact-info {
        margin-bottom: 25px;
    }

    .footer-contact-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--white);
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 14px;
        transition: all 0.3s ease;
        padding: 8px 0;
    }

    .footer-contact-item:hover {
        color: var(--alpha-blue);
        padding-left: 5px;
    }

.footer-contact-item svg {
    flex-shrink: 0;
    fill: var(--alpha-blue);
    filter: drop-shadow(0 0 4px rgba(2, 203, 254, 0.3));
}

/* Keep email icon with stroke */
.footer-contact-item:nth-child(2) svg {
    fill: none;
    stroke: var(--alpha-blue);
}

    .footer-hours {
        margin-bottom: 25px;
        background: rgba(255, 255, 255, 0.05);
        padding: 20px;
        border-radius: 8px;
        border-left: 3px solid var(--alpha-blue);
    }

    .footer-hours h4 {
        font-size: 16px;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }



    .footer-hours p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 6px;
    }

    .footer-hours strong {
        color: var(--alpha-blue);
        font-weight: 600;
    }

    /* Social Links */
    .footer-social {
        display: flex;
        gap: 15px;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, rgba(2, 203, 254, 0.1) 0%, rgba(2, 203, 254, 0.05) 100%);
        border: 2px solid rgba(2, 203, 254, 0.3);
        border-radius: 50%;
        color: var(--white);
        transition: all 0.3s ease;
    }

    .social-link:hover {
        background: linear-gradient(135deg, var(--alpha-blue) 0%, #0198c7 100%);
        border-color: var(--alpha-blue);
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 6px 20px rgba(2, 203, 254, 0.4);
    }

    /* Footer Links Columns */
    .footer-links h3 {
        font-size: 18px;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 20px;
        position: relative;
        padding-bottom: 12px;
    }

    .footer-links h3::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 3px;
        background: linear-gradient(90deg, var(--alpha-blue) 0%, transparent 100%);
        border-radius: 2px;
    }

    .footer-links ul {
        list-style: none;
    }

    .footer-links li {
        margin-bottom: 12px;
    }

    .footer-links a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-size: 14px;
        transition: all 0.3s ease;
        display: inline-block;
        position: relative;
    }

    .footer-links a::before {
        content: '→';
        position: absolute;
        left: -20px;
        opacity: 0;
        color: var(--alpha-blue);
        transition: all 0.3s ease;
    }

    .footer-links a:hover {
        color: var(--alpha-blue);
        padding-left: 20px;
    }

    .footer-links a:hover::before {
        opacity: 1;
        left: 0;
    }

    /* Map Column */
    .footer-map h3 {
        font-size: 18px;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 15px;
        position: relative;
        padding-bottom: 12px;
    }

    .footer-map h3::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 3px;
        background: linear-gradient(90deg, var(--alpha-blue) 0%, transparent 100%);
        border-radius: 2px;
    }

    .service-areas-text {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .map-container {
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);
        border: 2px solid rgba(2, 203, 254, 0.2);
        transition: all 0.3s ease;
    }

    .map-container:hover {
        border-color: var(--alpha-blue);
        box-shadow: 0 8px 30px rgba(2, 203, 254, 0.3);
        transform: translateY(-2px);
    }

    .map-container iframe {
        display: block;
        width: 100%;
        filter: grayscale(20%) contrast(1.1);
    }

    /* Footer Bottom */
    .footer-bottom {
        padding: 30px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
    }

    .footer-copyright {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
    }

    .footer-credit-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 24px;
        background: linear-gradient(135deg, rgba(2, 203, 254, 0.1) 0%, rgba(252, 1, 1, 0.1) 100%);
        border: 2px solid rgba(2, 203, 254, 0.3);
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .footer-credit-badge::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        transition: left 0.5s ease;
    }

    .footer-credit-badge:hover::before {
        left: 100%;
    }

    .footer-credit-badge:hover {
        border-color: var(--alpha-blue);
        background: linear-gradient(135deg, rgba(2, 203, 254, 0.2) 0%, rgba(252, 1, 1, 0.15) 100%);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(2, 203, 254, 0.3);
    }

    .credit-text {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 400;
    }

    .credit-company {
        font-size: 15px;
        color: var(--white);
        font-weight: 700;
        background: linear-gradient(135deg, var(--alpha-blue) 0%, var(--alpha-red) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .credit-arrow {
        stroke: var(--alpha-blue);
        transition: transform 0.3s ease;
    }

    .footer-credit-badge:hover .credit-arrow {
        transform: translateX(4px);
    }

    /* ========================================
       TABLET BREAKPOINT (768px+)
       ======================================== */

    @media (min-width: 768px) {
        .site-footer {
            padding: 80px 0 0;
        }

        .footer-container {
            padding: 0 40px;
        }

        .footer-top {
            grid-template-columns: repeat(2, 1fr);
            gap: 50px;
            padding-bottom: 50px;
        }

        .footer-company {
            grid-column: 1 / -1;
        }

        .footer-logo {
            height: 48px;
        }

        .map-container iframe {
            height: 250px;
        }

        .footer-bottom {
            flex-direction: row;
            justify-content: space-between;
            padding: 30px 0;
        }
    }

    /* ========================================
       DESKTOP BREAKPOINT (1024px+)
       ======================================== */

    @media (min-width: 1024px) {
        .footer-top {
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 60px;
        }

        .footer-company {
            grid-column: auto;
        }

        .footer-logo {
            height: 50px;
        }

        .map-container iframe {
            height: 220px;
        }
    }

    /* ========================================
       LARGE DESKTOP (1200px+)
       ======================================== */

    @media (min-width: 1200px) {
        .footer-container {
            padding: 0 50px;
        }

        .footer-top {
            gap: 80px;
        }
    }
</style>

