<script>
// JavaScript to dynamically add a parameter to the iframe href based on the website path

document.addEventListener("DOMContentLoaded", function () {
    // Get the current pathname from the URL
    const pathName = window.location.pathname;

    // Extract the location following "our-showrooms" in the pathname
    const pathSegments = pathName.split("/").filter(Boolean); // Remove empty strings
    const showroomIndex = pathSegments.indexOf("our-showrooms");
    const locationSegment = showroomIndex !== -1 && pathSegments[showroomIndex + 1] ? pathSegments[showroomIndex + 1] : null;

    // Find the iframe on the page
    const iframe = document.querySelector("iframe[src='https://www3.kitchenstudio.co.nz/l/1090342/2025-01-07/7k64vr']");

    if (iframe && locationSegment) {
        // Get the existing iframe URL
        const iframeSrc = new URL(iframe.src);

        // Add or update the "s" parameter in the iframe URL
        iframeSrc.searchParams.set("s", locationSegment);

        // Update the iframe src with the new URL
        iframe.src = iframeSrc.toString();
    }
});
</script>

