twJknM wixui-button ZhVEJq" aria-disabled="false" aria-label="BOOK A HEAT PUMP SERVICE"><span class="OR4Nv8 wixui-button__label">BOOK A HEAT PUMP SERVICE</span></a></div></div></div></div></div><nav aria-label="Slides" class="hImYkx"><ol class="RLaZ7p"><li aria-current="true"><a href="./#comp-km3wh1oc" aria-label="Slide  3" class="v1smN8 JPnvZO"></a></li></ol></nav></div></div></div></section><section id="comp-m2i8vg2s4" tabindex="-1" class="Le88gL comp-m2i8vg2s4 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-m2i8vg2s4" data-hook="bgLayers" data-motion-part="BG_LAYER comp-m2i8vg2s4" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-m2i8vg2s4" data-motion-part="BG_MEDIA comp-m2i8vg2s4" class="ROWgFb"></div></div><div data-mesh-id="comp-m2i8vg2s4inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-m2i8vg2s4inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-kixpa3bn" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-kixpa3bn wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:35px; line-height:normal;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:35px;" class="wixui-rich-text__text"><span class="color_20 wixui-rich-text__text">HEAT PUMP SERVICE &amp; INSTALLATION IN CHRISTCHURCH</span></span></span></h1></div><div id="comp-kixphg6f" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-kixphg6f wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:18px;">Stay comfortable year-round with ATL Heat Pumps, your trusted experts in heat pump installation, repairs, and maintenance across Christchurch and Canterbury. Whether it&rsquo;s for your home or business, we&rsquo;re here to deliver tailored solutions to suit your needs.</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">&nbsp;</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">We believe every Canterbury property should be warm, comfortable, and energy-efficient. That&rsquo;s why we partner with top brands like Mitsubishi Electric and Daikin to bring comfort and energy efficiency to your Canterbury home. From ultra-quiet bedroom units to fully ducted air conditioning solutions, our team ensures you get the perfect fit for your space.</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">&nbsp;</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">Contact ATL today for a free, no-obligation quote and start your journey toward a more comfortable home.</p></div><div id="comp-m7ua0yge" class="comp-m7ua0yge" data-semantic-classname="button"><a data-testid="linkElement" href="tel:0800555770" class="StylableButton2545352419__root style-m7ua1aix__root wixui-button StylableButton2545352419__link" aria-label="0800 555 770"><span class="StylableButton2545352419__container"><span class="StylableButton2545352419__label wixui-button__label" data-testid="stylablebutton-label">0800 555 770</span><span class="StylableButton2545352419__icon wixui-button__icon" aria-hidden="true" data-testid="stylablebutton-icon"><span>
<svg data-bbox="26.025 19.923 147.919 160.178" xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 200 200" data-type="shape">
    <g>
        <path d="M117.1 126.4l14.6-13.1c3.6-3.1 9-3.1 12.2.4l28 31.1c3.2 3.6 2.5 9-1.1 12.1l-23.2 20.9c-2.1 1.8-4.8 2.6-7.5 2.2.1 0-6.1-.7-9.1-1.2-5.6-1-11.3-2.4-17.3-4.7-16.5-6.1-33.2-17-49.9-34.1-1.8-1.9-3.6-3.8-5.4-5.8C30.9 103.4 23 75.5 27 51.3c.5-3.1.8-4.1 1.9-8.2.5-1.8 1.5-3.4 2.8-4.5l18.2-16.4c3.6-3.1 9-3.1 12.2.4l28 31.1c3.2 3.6 2.5 9-1.1 12.1L74.4 78.9l42.7 47.5zm-.7 13.5L60.9 78.2l3.6-3.2L82 59.2 55.6 29.9 38 45.8c-1 3.6-1.2 4.4-1.6 7.1-3.5 21.4 3.6 46.4 29.2 74.8 1.7 1.9 3.4 3.7 5.1 5.5 15.7 16.1 31.2 26.2 46.4 31.9 5.5 2 10.6 3.4 15.6 4.2 2.4.4 7.6 1 8.9 1.2l22.5-20.2-26.4-29.3-21.3 18.9z"></path>
    </g>
</svg>
</span></span></span></a></div></div></div></section><section id="comp-m2i8vg2s5" tabindex="-1" class="Le88gL comp-m2i8vg2s5 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-m2i8vg2s5" data-hook="bgLayers" data-motion-part="BG_LAYER comp-m2i8vg2s5" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-m2i8vg2s5" data-motion-part="BG_MEDIA comp-m2i8vg2s5" class="ROWgFb"></div></div><div data-mesh-id="comp-m2i8vg2s5inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-m2i8vg2s5inlineContent-gridContainer" data-testid="mesh-container-content"><div class="comp-km3x9jr1 mu5PoX" id="comp-km3x9jr1" aria-disabled="false"><a data-testid="linkElement" data-anchor="dataItem-km418lr7" data-anchor-comp-id="comp-km418lqf" href="https://www.atlelectrical.co.nz/heat-pumps#faq" target="_self" class="twJknM wixui-button ZhVEJq" aria-disabled="false" aria-label="FREQUENTLY ASKED QUESTIONS"><span class="OR4Nv8 wixui-button__label">FREQUENTLY ASKED QUESTIONS</span></a></div></div></div></section><section id="comp-m2i8vg2s6" tabindex="-1" class="Le88gL comp-m2i8vg2s6 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-m2i8vg2s6" data-hook="bgLayers" data-motion-part="BG_LAYER comp-m2i8vg2s6" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-m2i8vg2s6" data-motion-part="BG_MEDIA comp-m2i8vg2s6" class="ROWgFb"></div></div><div data-mesh-id="comp-m2i8vg2s6inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-m2i8vg2s6inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-km40h4ag" class="gpDCD5 comp-km40h4ag"><div class="jv9xi4 wixui-box" data-testid="container-bg"></div><div data-mesh-id="comp-km40h4aginlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-km40h4aginlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-km40lwx6" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-km40lwx6 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:36px;">HEAT PUMPS: COMFORT ALL YEAR ROUND</h2></div><div id="comp-kixopmv9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-kixopmv9 wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:18px;">Keeping your home warm in winter and cool in summer is essential, and at ATL, we understand how important it is to have a system you can depend on. We work with trusted brands like Mitsubishi Electric and Daikin, offering solutions designed specifically for New Zealand homes.</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">&nbsp;</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">Not sure which system suits your property? Our experts provide free on-site consultations throughout Christchurch. We&rsquo;ll listen to your needs, assess your space, and recommend a heat pump or ventilation system that matches your lifestyle.</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">&nbsp;</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">All our installers are trained and approved by our brand partners, ensuring professional installation and warranty coverage. With ATL Heat Pumps, you&rsquo;ll enjoy peace of mind knowing your system is installed by knowledgeable technicians who prioritise safety, efficiency, and cleanliness.</p></div><div id="comp-m7uam4th" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-m7uam4th wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:36px;">HEAT PUMPS: COMFORT ALL YEAR ROUND</h2></div><div id="comp-m7uand2r" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-m7uand2r wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:18px;">At ATL Electrical, we understand that no two homes are the same. If a standard split system isn&rsquo;t the right fit, our team will find a solution that works. We can customise installations with options like extended pipe runs and condensate pumps, ensuring your heat pump performs efficiently in any setup.</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">&nbsp;</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">For those looking for comprehensive climate control, we also offer ducted heat pump systems. These systems provide consistent heating and cooling throughout your home, giving you ultimate comfort no matter the season.</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">&nbsp;</p>

<p class="font_7 wixui-rich-text__text" style="font-size:18px;">Our team works closely with you, from consultation to installation, ensuring you&rsquo;re fully satisfied with the result. Let ATL Heat Pumps keep your home&rsquo;s climate comfortable all year round.</p></div></div></div></div></div></div></section><section id="comp-m2i8vg2t" tabindex="-1" class="Le88gL comp-m2i8vg2t wixui-section" data-block-level-container="ClassicSection"><div class="ClLWjk" id="heat-pumps-5"></div><div id="bgLayers_comp-m2i8vg2t" data-hook="bgLayers" data-motion-part="BG_LAYER comp-m2i8vg2t" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-m2i8vg2t" data-motion-part="BG_MEDIA comp-m2i8vg2t" class="ROWgFb"></div></div><div data-mesh-id="comp-m2i8vg2tinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-m2i8vg2tinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-km3z9xk7" class="comp-km3z9xk7 wH18kY"><div data-mesh-id="comp-km3z9xk7inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-km3z9xk7inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-kixq870w" class="W4V2qg comp-kixq870w wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="400px" srcSet="https://static.wixstatic.com/media/d60bbd_d13f826c6dc54b57bc07f38c20938f43~mv2.jpg/v1/crop/x_10,y_0,w_976,h_609/fill/w_400,h_250,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/_materials_ids_lifestyle_ef-lifestyle-20.jpg 1x, https://static.wixstatic.com/media/d60bbd_d13f826c6dc54b57bc07f38c20938f43~mv2.jpg/v1/crop/x_10,y_0,w_976,h_609/fill/w_800,h_500,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/_materials_ids_lifestyle_ef-lifestyle-20.jpg 2x" id="img_comp-kixq870w" src="https://static.wixstatic.com/media/d60bbd_d13f826c6dc54b57bc07f38c20938f43~mv2.jpg/v1/crop/x_10,y_0,w_976,h_609/fill/w_400,h_250,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/_m