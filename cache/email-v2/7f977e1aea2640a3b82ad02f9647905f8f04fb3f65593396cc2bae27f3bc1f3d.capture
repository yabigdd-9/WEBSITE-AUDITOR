<style id="stylableCss_qndoc">/*** VSM_CSS ***/ /* END STYLABLE DIRECTIVE RULES */

#comp-m7ua0yge .style-m7ua1aix__root{-st-extends: StylableButton;transition: all 0.2s ease, visibility 0s;background: rgba(0, 0, 0, 0)}

/* START STYLABLE DIRECTIVE RULES */

#comp-m7ua0yge .style-m7ua1aix__root:hover{background: rgba(255, 255, 255, 0);border: 0px solid #222222}

#comp-m7ua0yge .style-m7ua1aix__root:hover .StylableButton2545352419__label{text-shadow: none;color: #121212;font-weight: 700}

#comp-m7ua0yge .style-m7ua1aix__root:disabled{background: #E2E2E2}

#comp-m7ua0yge .style-m7ua1aix__root:disabled .StylableButton2545352419__label{color: #8F8F8F}

#comp-m7ua0yge .style-m7ua1aix__root:disabled .StylableButton2545352419__icon{fill: #8F8F8F}

#comp-m7ua0yge .style-m7ua1aix__root .StylableButton2545352419__container{transition: inherit;flex-direction: row-reverse}

#comp-m7ua0yge .style-m7ua1aix__root .StylableButton2545352419__label{transition: inherit;font-family: barlow-medium,barlow,sans-serif;font-size: 20px;color: #E1251D;font-weight: 700;margin: 0px 0px 0px 2.5px;letter-spacing: 0.05em}

#comp-m7ua0yge .style-m7ua1aix__root .StylableButton2545352419__icon{transition: inherit;fill: #E1251D;width: 25px;height: 25px;margin: 0px 2.5px 0px 0px}

#comp-m7ua0yge .style-m7ua1aix__root:hover .StylableButton2545352419__icon{
    fill: #121212}

@media screen and (min-width: 1px) and (max-width: 0px) {
    #comp-m7ua0yge .style-m7ua1aix__root .StylableButton2545352419__icon {
        width: 32px;
        height: 32px;
    }
    #comp-m7ua0yge .style-m7ua1aix__root .StylableButton2545352419__label {
        display: none;
    }
    #comp-m7ua0yge .style-m7ua1aix__root:hover .StylableButton2545352419__icon {
        fill: #FFFFFF;
    }
}/* END STYLABLE DIRECTIVE RULES */

#comp-mcs9idk75 .style-mcs9idkc1__root{-st-extends: StylableButton;transition: all 0.2s ease, visibility 0s;background: #FF0000}

/* START STYLABLE DIRECTIVE RULES */

#comp-mcs9idk75 .style-mcs9idkc1__root:hover{border: 1px solid #FF0000;background: #FFFFFF}

#comp-mcs9idk75 .style-mcs9idkc1__root:hover .StylableButton2545352419__label{
    color: #FF0000}

#comp-mcs9idk75 .style-mcs9idkc1__root:disabled{background: #E2E2E2}

#comp-mcs9idk75 .style-mcs9idkc1__root:disabled .StylableButton2545352419__label{color: #8F8F8F}

#comp-mcs9idk75 .style-mcs9idkc1__root:disabled .StylableButton2545352419__icon{fill: #8F8F8F}

#comp-mcs9idk75 .style-mcs9idkc1__root .StylableButton2545352419__container{transition: inherit}

#comp-mcs9idk75 .style-mcs9idkc1__root .StylableButton2545352419__label{transition: inherit;letter-spacing: 0em;margin: 0px 4px 0px 0px;display: inherited;text-shadow: none;color: #FFFFFF;font-family: avenir-lt-w01_35-light1475496,avenir-lt-w05_35-light,sans-serif;font-weight: normal;font-style: normal;font-size: 14px}

#comp-mcs9idk75 .style-mcs9idkc1__root .StylableButton2545352419__icon{transition: inherit;fill: #FFFFFF;width: 10px;height: 10px;margin: 0px 0px 0px 4px;display: none}

#comp-mcs9idk75 .style-mcs9idkc1__root:hover .StylableButton2545352419__icon{fill: #000000}</style>
