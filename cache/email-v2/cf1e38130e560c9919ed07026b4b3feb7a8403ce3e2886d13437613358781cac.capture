    line-height: 0.875;
  }

  .footer-top-right input.hs-button {
    font-weight: 600;
    font-size: 18px;
  }

  .footer-topimage {
    margin-bottom: -221px;
  }

  .footer-image {
    position: relative;
    top: -4px;
    overflow: hidden;
    padding-top: 50px;
  }
  
  .footer-top-right .hs-main-font-element {
  
    
    
    height: 66px;
    @media (max-width:820px){
      height: 12vw;
    }
  }

  .footer-top-right form {
    display: flex;
  }

  .footer-top-right .form-title {
    display: none;
  }

  .footer-top-right form input[type=email] {
    height: 50px;
    font-size: 18px;
  }

  .footer-top-right form input::placeholder {
    color: #818181;
  }

  .footer-top-right .hs_email {
    width: 64.6%;
  }

  .footer-top-right .hs_submit {
    width: 32%;
    
  }

  .footer-top-right .actions input.hs-button.primary.large {
    padding: 0 30px;
    height: 50px;
    text-transform: uppercase;
  }

  .footer-top-right .actions input.hs-button.primary.large:hover {
/*     padding-left: 14px; */
  }

  .footer-top-right label.hs-error-msg {
    color: #fff !important;
    line-height: 22px;
  }

  .footer-top-right form .hs_submit .actions {
    max-width: 164px;
  }

  .footer-top-left img {
    width: 26px;
    height: auto;
  }

  .footer-top-left a {
    display: flex;
    padding-bottom: 1.333rem;
    align-items: center;
  }

  .footer-top-left a span {
    font-size: 1.125rem;
    line-height: 1.333;
    padding-left: 1rem;
  }
 
  .footer-middle-content {
    padding: 0px 0;
  }

  .footer-middle-content ul {
    padding: 0;
    margin: 0;
  } 

  .footer-middle-content li a:hover {
    color: #fff;
  }

  .footer-middle-content li:last-child a {
    padding-right: 0;
  }

  .footer-bottom-content {
    padding-bottom: 76px;
    max-width: 935px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .footer-bottom-content h4 {
    font-size: 18px;
    line-height: 40px;
    max-width: 225px;
    font-family: 'Aeonik-Bold' !important;
  }

  .footer-bottom-content .hs-menu-wrapper.flyouts .hs-menu-children-wrapper {
    left: unset;
    opacity: 1;
    position: unset;
  }

  .footer-bottom-content ul li.hs-item-has-children {
    display: inline-block;
    padding-right: 114px;
  }

  .footer-bottom-content ul li.hs-item-has-children>a {
    cursor: pointer !important;
    font-size: 21px;
    line-height: 40px;
    font-weight: bold;
    display: block;
    max-width: 200px;
  }

  .footer-bottom-content ul li.hs-item-has-children>a:hover {
    color: #fff;
    cursor: auto;
    text-decoration: none;
  }

  .footer-bottom-content ul li.hs-item-has-children:last-child {
    padding-right: 0;
  }

  .footer-bottom-content ul li.hs-item-has-children:last-child>a {
    display: block;
    max-width: 200px;
  }

  .footer-bottom-content ul li.hs-item-has-children>ul {
    padding-top: 12px;
  }

  .footer-bottom-content a {
    font-size: 16px;
    line-height: 32px;
    font-weight: 400;
  }

  .footer-bottom-content a:hover {
    color: #fff;
    text-decoration: none;
  }

  .footer .copyright {
    background: #114242;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .footer .copyright p,
  .footer .copyright p a {
    line-height: 1.28;
    font-size: 0.875rem;
    color: #a2bfac;
    text-decoration: none;
  }

  .footer .copyright p a,
  .footer .copyright p a:visited {
    text-decoration: none;
    padding: 0 10px;
  }

  .footer .copyright p a:hover {
    color: #d6f700;
  } 
  
  .footer .copyright p a:hover:after {
    color: #a2bfac;
  }

  .footer .copyright p a:first-child {
    position: relative;
  }  

  .footer .copyright p a:not(:last-child):after {
    position: absolute;
    content: '|';
    right: 0;
  }  

  .footer .copyright p:last-child {
    margin-bottom: 0;
  }

  .footer .content-foot p a {
    padding: 0;
  }

  .footer .content-foot p a:after {
    display: none;
  }

  a.mobiletop-scroll {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background: #38974c;
    border-radius: 50%;
    position: absolute;
    top: 33px;
    right: 20px;
    z-index: 1;
  }

  a.mobiletop-scroll img {
    width: 20px;
    height: 20px;
  }

