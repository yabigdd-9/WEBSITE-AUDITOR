<style>
  .form-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .module-send-us-a-message .form-left ul {
    list-style-type: none;
    padding-left: 0;
  }

  .module-send-us-a-message .actions {
    background-color: transparent;
  }

  .module-send-us-a-message .hs-form-field {
    margin-bottom: 0px;
  }

  .module-send-us-a-message .call-now {
    color: white;
  }

  .module-send-us-a-message input::placeholder,
  .module-send-us-a-message select::placeholder, 
  .module-send-us-a-message textarea::placeholder{    
    color: #a2bfac !important;
    font-family: 'Aeonik-Regular', sans-serif;
  }

  .module-send-us-a-message .form-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between; 
    align-items: flex-start; 
    height: 100%; 
  }

  .hs-richtext {
    font-family: 'Aeonik-Regular', sans-serif;
  }

  .module-send-us-a-message option {
    color: #114242;
  }

  .module-send-us-a-message h2 {
    font-family: 'ReplicaLLWeb-Heavy', sans-serif;
    font-size: 4rem;
    line-height: 0.86;
    text-align: center;
    color: #d6f700;
    margin: 1rem auto 3rem;
    text-transform: uppercase;
  } 

  .module-send-us-a-message form {
    display: block !important;
  }

  .module-send-us-a-message .main-text {
    padding-bottom: 2rem;
  }

  .module-send-us-a-message .main-text p {
    font-size: 1.5rem;
    line-height: 1.333;
    letter-spacing: 0.01em;
    color: white;
    margin-bottom: 0.6rem;
  }

  .hs_recaptcha.hs-recaptcha {
    margin-bottom: 1rem;
  }

  .module-send-us-a-message .form-right p {
    font-size: 12px !important;
    color: #114242;
    font-family: "Aeonik-Regular", sans-serif;    
    margin: 0px;
  }

  .module-send-us-a-message .call-now .one {
    color:white;
    display: block;
    line-height: 0.86;
    font-size: 4rem;
    font-family: 'ReplicaLLWeb-Heavy', sans-serif; 
  }

  .module-send-us-a-message .call-now .two {
    color: #d6f700;
    display: block;
    line-height: 0.86;
    margin-bottom: 10px;
    font-size: 4rem;
    font-family: 'ReplicaLLWeb-Heavy', sans-serif;  
  }

  .module-send-us-a-message .call-now p {
    margin: 0;
  }

  .module-send-us-a-message .form-left li {
    position: relative;
    padding-left: 2rem;
    font-size: 1.5rem;
    letter-spacing: 0.01em;
    color: white;
  }

  .module-send-us-a-message .form-left li::before {
    content: url('https://www.energysmart.co.nz/hubfs/Resources/Logos/EnergySmart%20Icon_Mid%20Green.svg');
    position: absolute;
    left: 0;
    width: 1.125rem;
  }

  .module-send-us-a-message .hs-fieldtype-textarea.hs-input {
    height: 14vh;
  }

  .module-send-us-a-message input, .module-send-us-a-message select, .module-send-us-a-message textarea {
    display: block;
    width: 100%;
    border: none !important;
    color: #114242;
  }

  .module-send-us-a-message .hs-form-radio-display {
    display: flex;
    cursor: pointer;
  }

  .module-send-us-a-message input[type="submit"]{
    font-size: 1.333rem !important;
    background-color: #D6F700;   
    margin: 0;
    font-family: 'ReplicaLLWeb-Heavy', sans-serif;
  } 

  .module-send-us-a-message {
    padding: 2rem;
    background-color: #053539;
  }

  .module-send-us-a-message .rich-text {
    text-align: LEFT !important;
    font-size: 28px !important;
    color: #114242 !important;
    font-family: 'Aeonik-Regular',Poppins, sans-serif !important;
    line-height: 1.3em;
  }

  .module-send-us-a-message .form-left .sub-heading {
    text-align: left;
    font-size: 3rem;
    line-height: 1.15;
    color: white;
    font-family: 'Aeonik-Bold', sans-serif;
    width:%;
  }

  .module-send-us-a-message .call-now {
    
  }

  .module-send-us-a-message .sub-heading{
    
  } 

  .module-send-us-a-message .hs-richtext,
  .module-send-us-a-message .hs-richtext p {
    text-align: LEFT!important;
    font-size: 0.875rem !important;
    line-height: 1.28 !important;
    font-family: 'Aeonik-Regular', sans-serif;  
    color: #a2bfac;
    max-width: 95%;
    text-wrap: pretty;
  }

  @media (max-width: 1280px) {
    .module-send-us-a-message .form-left .sub-heading {
      font-size: 250%;
    }

    .module-send-us-a-message .call-now .one,
    .module-send-us-a-message .call-now .two {
      font-size: 340%;
    }
  }

  /* in unison with js for hiding the list, this places 'call now' after message form */
  @media (max-width: 820px) {
    .module-send-us-a-message {
      padding: 0;
    }

    .module-send-us-a-message input[type="submit"]{
      font-size: 4vw !important;
    }

    
    .form-wrapper {
      display: flex;
      flex-direction: column-reverse;
      gap: 0;
    }

    .form-left-content {
      display: none;
    }

    .module-send-us-a-message form {
      padding: 3vw;
    }

    .module-send-us-a-message h2 {
      font-size: 10.5vw;
      line-height: 10.5vw;
      padding-left: 3vw;
      padding-right: 3vw;
      padding-top: 13vw;
      margin-top: 0;
      margin-bottom: 0;
    }

    .module-send-us-a-message .call-now {
      text-align: center;
      width: 100%;
      padding: 3vw;
      margin: 0;
    }

    .module-send-us-a-message .call-now .one,
    .module-send-us-a-message .call-now .two {
      font-size: 10vw;
      text-align: center;
    }

    .module-send-us-a-message .call-now .two {
      margin-bottom: 2vw;
    }

    .module-send-us-a-message .call-now p {
      font-size: 4vw;
      line-height: 5vw;
      margin: 0;
    }

    .module-send-us-a-message .hs-richtext,
    .module-send-us-a-message .hs-richtext p {
      font-size: 3.3vw !important;
      line-height: 2vw;
      margin: 0 0 2vw;
    }

    .module-send-us-a-message input, 
    .module-send-us-a-message select, 
    .module-send-us-a-message textarea {
      margin: 0 0 3vw 0 !important;
      font-size: 4.25vw !important;
      padding: 1.25vw 2vw !important;
    }

    .module-send-us-a-message input.hs-button.primary.large {
      padding: 2.3vw 3.3vw !important;
    }

    .hs-fieldtype-textarea.hs-input {
      height: 33vw;
    }
  }

  
  .module-send-us-a-message.module-theme--light {
    background: #f6f9f4;
  }

  .module-send-us-a-message.module-theme--light .form-left .sub-heading,
  .module-send-us-a-message.module-theme--light li,
  .module-send-us-a-message.module-theme--light form label span,
  .module-send-us-a-message.module-theme--light .call-now, 
  .module-send-us-a-message.module-theme--light .form-right span:first-child {
    color: #053539;
  }
  
  .module-send-us-a-message.module-theme--light .call-now .one {
    color: #114242;
  }

  .module-send-us-a-message.module-theme--light h2,
