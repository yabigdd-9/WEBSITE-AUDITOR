<style> 
  
  .module-locations{
    background-color: #F6F9F4;
    position: relative;
    background-size: 50vh; 
    background-position: left; 
    background-position-x: 20%;
    background-repeat: no-repeat;
    background-image: url('https://www.energysmart.co.nz/hubfs/NZ_Map.svg');
  }
  
  .module-locations .content-wrapper {
    margin: 0;
    padding-left: 50%;
    min-height: 97svh;
    align-content: center;


  }

  .module-locations .locations-text-container {
    display: flex;
    flex-direction: column;
    align-content: space-around;
  }
  
  .module-locations h2{
    max-width: 80%;
    text-wrap: balance;
    text-align: LEFT !important;
    font-size: 47px !important;
    color: #082021 !important; 
    font-family: 'Aeonik-Bold',Poppins, sans-serif !important;
  }
  
  .module-locations ul {
    list-style-type: none;
    padding-left: 2rem;
  }
  
  .module-locations li a{
    position: relative;
    padding-left: 2rem;
    margin-left: -2rem;
    line-height: 1.5;
    font-size: 1.5rem;
    color: #082021 !important; 
    font-family: 'Aeonik-Regular',Poppins, sans-serif !important;
  } 
  
  .module-locations li a::before {
  content: url('https://www.energysmart.co.nz/hubfs/Resources/Logos/EnergySmart%20Icon_Mid%20Green.svg');
    position: absolute;
    left: 0;
    top: -4px;
    width: 1.125rem;
    height: auto;
  }
  
  @media (max-width: 820px) {
    .module-locations {
      
      background-position: center;
      
    }
    
    .module-locations .content-wrapper{
      padding: calc(3vw * 2) 3vw;
    }
    
    .module-locations h2 {
      font-size: 7vw !important;
      line-height: 7vw;
    }
    
    .module-locations li a {
      font-size: 4.25vw !important;
      padding-left: 6vw !important;
      
    }
    
    .module-locations li a::before {
      top: -0.8vw;
      width: 3.2vw;
    }

  }
  
</style>

<link rel="stylesheet" href="https://www.energysmart.co.nz/hubfs/hub_generated/module_assets/1/147310199414/1740804714274/module_Footer.min.css">

  <style>
    
        
    .footer-top-right .hs_email {
      width: 100% !important;
      flex: 1 1 auto !important;
      margin: 0 !important;
    }
    
    .footer-wrap .actions input.hs-button.primary {
      color: #053638;
      transition: all .3s;
