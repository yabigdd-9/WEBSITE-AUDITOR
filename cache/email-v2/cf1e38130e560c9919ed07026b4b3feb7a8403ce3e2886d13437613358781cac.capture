    }

    .footer-topimage,
    .footer-bottomimage {
      width: 100%;
      height: 103px;
    }

    .footer-top-content {
/*       max-width: 310px; */
      margin: 0 auto;
      position: relative;
    }
    
    .footer-top-content .footer-top-right{
        
        width: 100%; 
     }

    .footer-top-left img {
      width: 30px;
      height: 30px;
    }

    .footer-top-left a {
      display: flex;
      padding-bottom: 30px;
      align-items: center;
    }

    .footer-top-left a span {
      
    }

    .footer-middle-content {
      padding: 30px 0;
    }

    .footer-middle-content li {
      list-style: none;
      display: block;
      padding-right: 0;
      padding-bottom: 13px;
    }

    .footer .copyright {
      
      padding: 0px 0;
      text-align: center;
    }

    .footer .copyright p,
    .footer .copyright p a {
      color: #fff;
      font-size: 14px;
      font-weight: 400;
    }

    .footer:after {
      display: none;
    }

    .footer:before {
      right: -20%;
      width: 430px;
      height: 630px;
      z-index: -1;
      bottom: 7%;
    }

    .footer-middle-content h3 {
      font-size: 28px;
    }

    .footer-image {
      position: relative;
      top: -4px;
    }

    .footer {
      margin-top: -25px;
    }
  }

  @media(max-width:640px) {
    a.mobiletop-scroll {
      display: flex;
    }
  }

  @media(max-width:480px) {
    .footer-top-content {
/*       max-width: 310px; */
      margin: 0 auto;
    }
