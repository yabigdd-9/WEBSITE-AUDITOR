		<div class="elementor-element elementor-element-c19210e e-con-full e-flex e-con e-child" data-id="c19210e" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-8f6080d elementor-widget elementor-widget-image" data-id="8f6080d" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
				<div class="elementor-widget-container">
															<img loading="lazy" decoding="async" width="800" height="527" src="https://www.butterfieldbathrooms.co.nz/wp-content/uploads/2025/10/66754255c55f4a886f5d5b2c_module-graphic-calculator-1024x675.jpg" class="attachment-large size-large wp-image-163" alt="" srcset="https://www.butterfieldbathrooms.co.nz/wp-content/uploads/2025/10/66754255c55f4a886f5d5b2c_module-graphic-calculator-1024x675.jpg 1024w, https://www.butterfieldbathrooms.co.nz/wp-content/uploads/2025/10/66754255c55f4a886f5d5b2c_module-graphic-calculator-300x198.jpg 300w, https://www.butterfieldbathrooms.co.nz/wp-content/uploads/2025/10/66754255c55f4a886f5d5b2c_module-graphic-calculator-768x506.jpg 768w, https://www.butterfieldbathrooms.co.nz/wp-content/uploads/2025/10/66754255c55f4a886f5d5b2c_module-graphic-calculator.jpg 1342w" sizes="(max-width: 800px) 100vw, 800px" />															</div>
