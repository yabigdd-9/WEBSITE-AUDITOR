    </div>
<div class="hero-form" id="quote-form" style="max-width:520px;margin:0 auto;">
      <h2>Get a free quote</h2>
      <p class="hero-form-sub">Quick and easy — Ben will get back to you shortly.</p>
      <form action="https://formspree.io/f/mjgzdorw" method="POST" class="js-quote-form" novalidate>
        <input type="hidden" name="_subject" value="New quote request (about page) — simpsoncc.co.nz">
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="field-group">
          <div><label for="qf-name">Your name</label><input type="text" id="qf-name" name="name" placeholder="John Doe" required autocomplete="name"></div>
          <div><label for="qf-phone">Contact number</label><input type="tel" id="qf-phone" name="phone" placeholder="021 234 5678" required autocomplete="tel"></div>
          <div><label for="qf-email">Email address</label><input type="email" id="qf-email" name="email" placeholder="john@example.com" required autocomplete="email"></div>
          <div><label for="qf-message">Note <span class="optional">(optional)</span></label><textarea id="qf-message" name="message" rows="3" placeholder="e.g. Calculator said 5.0 kW for my living room"></textarea></div>
        </div>
        <div class="step-error">Please fill in your name, phone, and a valid email.</div>
        <button type="submit" class="btn-submit">Request my free quote</button>
        <p class="form-privacy">Your details go straight to Ben and are never shared.</p>
      </form>
      <div class="success-msg" role="alert">
        <div class="success-icon"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg></div>
        <h2>Request sent!</h2>
        <p>Ben will get back to you shortly. Need it urgently? <a href="tel:+64273149391">Call 027 314 9391</a>.</p>
      </div>
    </div>
  </div>
</section>

