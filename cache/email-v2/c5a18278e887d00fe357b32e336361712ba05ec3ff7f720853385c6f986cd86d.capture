<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
  (function () {
    function trackConversion() {
      try {
        if (typeof gtag === 'function') {
          if (window.SCC_CONVERSION_ID && window.SCC_CONVERSION_ID.indexOf('XXXX') === -1) {
            gtag('event', 'conversion', { 'send_to': window.SCC_CONVERSION_ID });
          }
          gtag('event', 'generate_lead', { 'event_category': 'quote_form' });
        }
      } catch (err) {}
    }
    function validate(form) {
      var ok = true;
      form.querySelectorAll('[required]').forEach(function (f) {
        f.classList.remove('field-error');
        var bad = !f.value.trim() || (f.type === 'email' && f.value.indexOf('@') === -1);
        if (bad) { f.classList.add('field-error'); ok = false; }
      });
      var err = form.querySelector('.step-error');
      if (err) err.style.display = ok ? 'none' : 'block';
      return ok;
    }
    document.querySelectorAll('.js-quote-form').forEach(function (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!validate(form)) return;
        var button = form.querySelector('.btn-submit');
        var success = form.parentElement.querySelector('.success-msg');
        var original = button.innerText;
        button.disabled = true; button.innerText = 'Sending...';
        try {
          var response = await fetch(form.action, {
            method: form.method, body: new FormData(form),
            headers: { 'Accept': 'application/json' }
          });
          if (response.ok) {
            trackConversion();
            form.style.display = 'none';
            var title = form.parentElement.querySelector('h3');
            var sub = form.parentElement.querySelector('.hero-form-sub');
            if (title) title.style.display = 'none';
            if (sub) sub.style.display = 'none';
            if (success) { success.style.display = 'block'; success.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          } else { throw new Error('bad response'); }
        } catch (error) {
          alert('There was a problem sending your request. Please try again, or call 027 314 9391.');
          button.disabled = false; button.innerText = original;
        }
      });
    });
  })();
</script>

<script>
  (function () {
    var burger = document.querySelector('.nav-burger');
    var menu = document.getElementById('mobile-menu');
    if (!burger || !menu) return;
    function setOpen(open) {
      menu.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }
    burger.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(!menu.classList.contains('open'));
    });
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('click', function (e) {
      if (menu.classList.contains('open') && !e.target.closest('.mobile-menu') && !e.target.closest('.nav-burger')) setOpen(false);
    });
  })();
</script>
<script>
  /* Phone-call click tracking. Fires a Google Ads conversion for every tap on a
     tel: link (mobile sticky bar, nav, hero, CTA bands). Paste the send_to value
     from Google Ads > Goals > Conversions > "Phone call click" below. Until then
     the GA4-style event still fires so the clicks are not lost. */
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href^="tel:"]');
    if (!a || typeof gtag !== 'function') return;
    gtag('event', 'contact', { 'event_category': 'phone_call_click', 'event_label': location.pathname });
    if (window.SCC_CALL_CONVERSION_ID) {
      gtag('event', 'conversion', { 'send_to': window.SCC_CALL_CONVERSION_ID });
    }
  }, true);
</script>
