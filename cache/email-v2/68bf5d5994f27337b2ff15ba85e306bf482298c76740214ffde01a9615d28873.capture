width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg></button></div><div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;align-items:center"><a href="/heat-pumps/residential" style="display:inline-flex;align-items:center;gap:8px;font-family:&quot;Satoshi&quot;,sans-serif;font-weight:800;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:#fff;text-decoration:none;border-bottom:2px solid rgba(255,255,255,0.3);padding-bottom:2px;transition:border-color 0.2s">View Our Services<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg></a><a href="/contact" class="btn btn-primary" style="height:52px;padding:0 32px;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;line-height:1">Book a Free Consultation</a></div></div></div></section><section id="reviews" style="width:100%;background:#021225;padding:80px 0"><div class="wrap"><div style="width:100%;min-height:280px;display:flex;justify-content:center"></div></div></section><section style="width:100%;background:#e8edf2;padding:60px 0"><div class="wrap"><div class="map-cta-grid" style="min-height:500px;box-shadow:0 20px 60px rgba(0,0,0,0.12);overflow:hidden;display:grid;grid-template-columns:1fr 1fr"><div style="position:relative;overflow:hidden;min-height:500px"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d204986.9!2d174.537!3d-36.8623!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6d0d47fb5a9ce6fb%3A0x500ef6143a29917!2sAuckland%2C%20New%20Zealand!5e0!3m2!1sen!2snz!4v1700000000000!5m2!1sen!2snz" style="border:0;display:block;position:absolute;inset:0;width:100%;height:100%;filter:grayscale(20%) contrast(1.05)" allowFullScreen="" loading="laz