}
.faq-item { border-bottom:1px solid rgba(255,255,255,0.12); }
.faq-btn { width:100%; background:none; border:none; cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:28px 0; gap:24px; text-align:left; }
.faq-q { font-family:'Satoshi',sans-serif; font-weight:700; font-size:18px; color:#fff; line-height:1.3; transition:color 0.15s; }
.faq-btn:hover .faq-q { color:#f0cc58; }
.faq-icon { flex-shrink:0; width:34px; height:34px; border:1.5px solid rgba(255,255,255,0.25); display:flex; align-items:center; justify-content:center; transition:border-color 0.2s, background 0.2s; }
