alt="Trustindex" width="150" height="25" /> </div> </div> </div> </div> <div class="ti-reviews-container"> <div class="ti-controls"> <div class="ti-next" aria-label="Next review" role="button" tabindex="0"></div> <div class="ti-prev" aria-label="Previous review" role="button" tabindex="0"></div> </div> <div class="ti-reviews-container-wrapper"> <div class="ti-review-item source-Google ti-image-layout-thumbnail" data-platform-page-url="https://www.google.com/maps/search/?api=1&amp;query=Google&amp;query_place_id=ChIJ3bTyL1WsQG0RVCdxKyLScvY" data-time="1782516629" data-id="379f0743da8a9604f85fd5b0485ee7df" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Google</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a-/ALV-UjUdxMAhZCSJ_clpp8-pwpVhDYvhrE2lkF_LoRNzL57qXDjqiTSY=w40-h40-c-rp-mo-br100" srcset="https://lh3.googleusercontent.com/a-/ALV-UjUdxMAhZCSJ_clpp8-pwpVhDYvhrE2lkF_LoRNzL57qXDjqiTSY=w80-h80-c-rp-mo-br100 2x" alt="Hooman Bahraini profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> Hooman Bahraini </div> <div class="ti-date">26 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 1" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 2" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 3" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 4" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 5" width="17" height="17"  /><span class="ti-verified-review ti-verified-platform ti-color-blue"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Google.</span></span></span> <div class="ti-review-text-container ti-review-content">Lomu and Liam did an awesome job. Many thanks</div> <span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more" ></span> </div> </div> <div class="ti-review-item source-Google ti-image-layout-thumbnail" data-platform-page-url="https://www.google.com/maps/search/?api=1&amp;query=Google&amp;query_place_id=ChIJ3bTyL1WsQG0RVCdxKyLScvY" data-time="1782355516" data-id="52d1d47086ed517485202f5a7f8c506b" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Google</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a/ACg8ocK5polObZFNn2cdw_6vN9gRY2LIQliqxjvOhm7uPUkGLjPfbg=w40-h40-c-rp-mo-br100" srcset="https://lh3.googleusercontent.com/a/ACg8ocK5polObZFNn2cdw_6vN9gRY2LIQliqxjvOhm7uPUkGLjPfbg=w80-h80-c-rp-mo-br100 2x" alt="Lyn Taylor profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> Lyn Taylor </div> <div class="ti-date">25 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 1" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 2" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 3" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 4" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 5" width="17" height="17"  /><span class="ti-verified-review ti-verified-platform ti-color-blue"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Google.</span></span></span> <div class="ti-review-text-container ti-review-content">Outstanding service from Blizzard HVAC & Electrical, thank you</div> <span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more" ></span> </div> </div> <div class="ti-review-item source-Google ti-image-layout-thumbnail" data-platform-page-url="https://www.google.com/maps/search/?api=1&amp;query=Google&amp;query_place_id=ChIJ3bTyL1WsQG0RVCdxKyLScvY" data-time="1782091771" data-id="5d1c48df60e962053aa584cf0732c8d2" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Google</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a/ACg8ocJq91x2_oRSDdla5MqHaO4UDCPaEEOpM5Ijk39Geq1Ab2vbqA=w40-h40-c-rp-mo-br100" srcset="https://lh3.googleusercontent.com/a/ACg8ocJq91x2_oRSDdla5MqHaO4UDCPaEEOpM5Ijk39Geq1Ab2vbqA=w80-h80-c-rp-mo-br100 2x" alt="John Coffey profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> John Coffey </div> <div class="ti-date">22 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 1" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 2" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 3" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 4" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 5" width="17" height="17"  /><span class="ti-verified-review ti-verified-platform ti-color-blue"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Google.</span></span></span> <div class="ti-review-text-container ti-review-content">I wish to thank Lomu and Liam for there great work today installing our heat pump both of them were very polite and professional at there job</div> <span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more" ></span> </div> </div> <div class="ti-review-item source-Google ti-image-layout-thumbnail" data-platform-page-url="https://www.google.com/maps/search/?api=1&amp;query=Google&amp;query_place_id=ChIJ3bTyL1WsQG0RVCdxKyLScvY" data-time="1781745341" data-id="e7600f5bbd701eb99f603be836248668" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Google</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a/ACg8ocLwKgK2DIvi1_RU87KgjHQeJDtDk68n1Ww_j6So9Pi94XFAsQ=w40-h40-c-rp-mo-br100" srcset="https://lh3.googleusercontent.com/a/ACg8ocLwKgK2DIvi1_RU87KgjHQeJDtDk68n1Ww_j6So9Pi94XFAsQ=w80-h80-c-rp-mo-br100 2x" alt="Mark Malan profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> Mark Malan </div> <div class="ti-date">18 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 1" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 2" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 3" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 4" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 5" width="17" height="17"  /><span class="ti-verified-review ti-verified-platform ti-color-blue"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Google.</span></span></span> <div class="ti-review-text-container ti-review-content">Blizzard was quick to come out to assess and quote for a replacement/upgrade to our dysfunctional heatpump. Being retirees, we spend a lot of time at home - and this is not fun without decent heating during a Wellington winter. Blizzard recommended an 8KW Daikin split-unit heat pump, which they installed in less than a week of us accepting their quotation. We have been living with our new heat pump for two days now, and have immediately enjoyed basking in our new indoor warmth. My wife and I are extremely happy with the Daikin. We were equally impressed by the absolute professionalism and efficiency of the very friendly and polite installation team. Many thanks to Caitlin in the office, and especially to James, Lomu and Liam for a super neat installation. Sincerely, Mark and Suzanne</div> <span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more" ></span> </div> </div> <div class="ti-review-item source-Google ti-image-layout-thumbnail" data-platform-page-url="https://www.google.com/maps/search/?api=1&amp;query=Google&amp;query_place_id=ChIJ3bTyL1WsQG0RVCdxKyLScvY" data-time="1781343289" data-id="d2717563320fe6395c2c63081059fcca" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Google</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a-/ALV-UjXjMpM0dkRHL7XOCS4-6OkEjkb-DYslEBH6Jn0sb59N9SGCquE-=w40-h40-c-rp-mo-br100" srcset="https://lh3.googleusercontent.com/a-/ALV-UjXjMpM0dkRHL7XOCS4-6OkEjkb-DYslEBH6Jn0sb59N9SGCquE-=w80-h80-c-rp-mo-br100 2x" alt="Terry Barwick profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> Terry Barwick </div> <div class="ti-date">13 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 1" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 2" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 3" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 4" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 5" width="17" height="17"  /><span class="ti-verified-review ti-verified-platform ti-color-blue"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Google.</span></span></span> <div class="ti-review-text-container ti-review-content">I’ve had my heat pump for five years and hadn’t got around to getting it serviced, so I booked a hydro clean. Russell provided an excellent service — replaced the filters, gave the outdoor unit a thorough clean, checked that everything was running correctly, and offered really helpful advice on cleaning and operating the heat pump properly. Great communication throughout. Thanks for the great work.</div> <span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more" ></span> </div> </div> <div class="ti-review-item source-Trustindex ti-image-layout-thumbnail" data-platform-page-url="https://www.trustindex.io/reviews/www.blizzard.co.nz" data-time="1781065086" data-id="1956af20a34137217484b1b38a32195c" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Trustindex</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Trustindex/icon.svg" alt="Trustindex" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a/ACg8ocLtWpixMRVgXCAnNrQ306OxrZyrNRm9U1hE2wsLu0Fw77KmSQ=w40-h40-c" srcset="https://lh3.googleusercontent.com/a/ACg8ocLtWpixMRVgXCAnNrQ306OxrZyrNRm9U1hE2wsLu0Fw77KmSQ=w80-h80-c 2x" alt="Laura Barnett profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> Laura Barnett </div> <div class="ti-date">10 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Trustindex/star/f.svg" alt="Trustindex star 1" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Trustindex/star/f.svg" alt="Trustindex star 2" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Trustindex/star/f.svg" alt="Trustindex star 3" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Trustindex/star/f.svg" alt="Trustindex star 4" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Trustindex/star/f.svg" alt="Trustindex star 5" width="17" height="17"  /><span class="ti-verified-review ti-verified-platform ti-color-blue"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Trustindex.</span></span></span> <div class="ti-review-text-container ti-review-content"><strong>Great service</strong> The team at Blizzard gave really good service with my recent heat pump purchase and installation. They responded promptly to my enquiry, did a quote with various options, and the installation by James and Liam went very smoothly. I was kept informed of their progress and given a tutorial about how to get the best out of the units. Very happy with the service and the products.</div> <span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more" ></span> </div> </div> <div class="ti-review-item source-Google ti-image-layout-thumbnail" data-platform-page-url="https://www.google.com/maps/search/?api=1&amp;query=Google&amp;query_place_id=ChIJ3bTyL1WsQG0RVCdxKyLScvY" data-time="1781049435" data-id="1189f996e379e036e1a22f27129cc4fa" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Google</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a/ACg8ocLKVEhOgKU4CD2yB2LoDaCOi7aDx9d3Bt56g5DnEhrltm_lPQ=w40-h40-c-rp-mo-ba12-br100" srcset="https://lh3.googleusercontent.com/a/ACg8ocLKVEhOgKU4CD2yB2LoDaCOi7aDx9d3Bt56g5DnEhrltm_lPQ=w80-h80-c-rp-mo-ba12-br100 2x" alt="Kate H profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> Kate H </div> <div class="ti-date">9 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 1" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 2" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 3" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 4" width="17" height="17"  /><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star 5" width="17" height="17"  /><span class="ti-verified-review ti-verified-platform ti-color-blue"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Google.</span></span></span> <div class="ti-review-text-container ti-review-content">Highly recommend Blizzard. Russ arrived on time and was super friendly. Plenty of comms from Blizzard to remind me off the appt timing. Service was done quickly and professionally. See you again in a year.</div> <span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more" ></span> </div> </div> <div class="ti-review-item source-Google ti-image-layout-thumbnail" data-platform-page-url="https://www.google.com/maps/search/?api=1&amp;query=Google&amp;query_place_id=ChIJ3bTyL1WsQG0RVCdxKyLScvY" data-time="1780963692" data-id="8b375c284557dfeba144262605723ee8" data-language="en" data-rating="5.0" data-max-rating="5" > <div class="ti-inner"> <div class="ti-review-header"> <div class="ti-platform-icon ti-with-tooltip"> <span class="ti-tooltip">Posted on Google</span> <img decoding="async" class="skip-lazy" src="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20"  /> </div> <div class="ti-profile-img"> <img decoding="async" class="skip-lazy" src="https://lh3.googleusercontent.com/a/ACg8ocKm_3ZcHq9F9wJDuZfd63UETn2AgED6foop-NdfS1ncGtV8RQ=w40-h40-c-rp-mo-br100" srcset="https://lh3.googleusercontent.com/a/ACg8ocKm_3ZcHq9F9wJDuZfd63UETn2AgED6foop-NdfS1ncGtV8RQ=w80-h80-c-rp-mo-br100 2x" alt="Zac Hamilton profile picture"  /> </div> <div class="ti-profile-details"> <div class="ti-name"> Zac Hamilton </div> <div class="ti-date">9 June 2026</div> </div> </div> <span class="ti-stars"><img decoding="async" class="ti-star f skip-lazy" src="https://cdn.trustindex.io/as