    text-align: center;
  }
}
</style>
	</div>
	
<a href="/building-services-christchurch/new-builds/" class="button primary reveal-icon" >
		<span>About us</span>
	<i class="icon-angle-right" aria-hidden="true"></i></a>

		</div>
					</div>

	

	<div id="col-1706385182" class="col medium-10 small-12 large-12"  >
				<div class="col-inner text-center"  >
			
			
	<div class="img has-hover x md-x lg-x y md-y lg-y" id="image_1464150271">
								<div class="img-inner dark" >
			<img loading="lazy" decoding="async" width="1020" height="622" src="https://www.riseresidential.co.nz/wp-content/uploads/2024/06/arrows.svg" class="attachment-large size-large" alt="" />						
					</div>
								
