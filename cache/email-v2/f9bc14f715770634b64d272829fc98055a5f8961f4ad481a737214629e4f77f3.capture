	<div id="text-4043980166" class="text">
		
<h2>Client Reviews</h2>
		
<style>
#text-4043980166 {
  font-size: 1.4rem;
  text-align: center;
}
@media (min-width:550px) {
  #text-4043980166 {
    font-size: 1.35rem;
