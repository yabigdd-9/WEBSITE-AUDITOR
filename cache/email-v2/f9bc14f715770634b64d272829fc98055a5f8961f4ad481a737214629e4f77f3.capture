	<div id="text-413548683" class="text">
		
<h2>New Builds</h2>
		
<style>
#text-413548683 {
  font-size: 0.85rem;
  text-align: left;
}
@media (min-width:550px) {
  #text-413548683 {
    font-size: 1rem;
