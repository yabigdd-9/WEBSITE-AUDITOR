    text-align: center;
  }
}
</style>
	</div>
	

<p><!-- Google Reviews Widget – Rise Residential (static, all 26 reviews, no plugin, no external calls) --></p>
<section class="rr-rev" aria-label="Google customer reviews">
<style>
    .rr-rev{max-width:1160px;margin:0 auto;padding:0px 16px;font-family:'Gilroy-Regular','Gilroy',sans-serif;box-sizing:border-box;}
    .rr-rev *{box-sizing:border-box;}
    .rr-rev__head{text-align:center;margin-bottom:30px;}
    .rr-rev__label{font-family:'Gilroy-SemiBold','Gilroy',sans-serif;font-size:clamp(18px,3vw,22px);font-weight:600;letter-spacing:1px;color:#111;margin:0 0 10px;text-transform:uppercase;}
    .rr-rev__stars-big{display:flex;justify-content:center;gap:4px;margin-bottom:10px;}
    .rr-rev__stars-big svg{width:clamp(22px,4vw,32px);height:clamp(22px,4vw,32px);}
    .rr-rev__sub{font-size:14px;color:#333;margin-bottom:12px;}
    .rr-rev__sub b{font-weight:700;}
    .rr-rev__glogo{display:flex;align-items:center;justify-content:center;}
    .rr-rev__glogo img{height:clamp(30px,5vw,42px);width:auto;display:block;}
    .rr-rev__row{position:relative !important;display:block !important;width:100%;}
    .rr-rev__track{
      display:grid !important;grid-auto-flow:column !important;grid-auto-columns:100% !important;
      grid-template-rows:1fr !important;
      gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;
      padding:4px 4px;margin:0 44px;
      scrollbar-width:none;min-width:0;box-sizing:border-box;
    }
    .rr-rev__track::-webkit-scrollbar{display:none;}
    .rr-rev__track > .rr-card{scroll-snap-align:start;min-width:0;}
    @media (min-width:640px){
      .rr-rev__track{grid-auto-columns:calc(50% - 8px) !important;}
    }
    @media (min-width:960px){
      .rr-rev__track{grid-auto-columns:calc(33.333% - 11px) !important;margin:0 52px;}
    }
    .rr-rev__nav{
      position:absolute !important;top:50% !important;transform:translateY(-50%);
      width:36px;height:36px;border-radius:50% !important;border:1px solid #e2e6e8;
      background:#fff;color:#555;font-size:18px;line-height:1;cursor:pointer;
      display:flex !important;align-items:center;justify-content:center;
      box-shadow:0 2px 8px rgba(0,0,0,0.1);z-index:2;padding:0;
    }
    .rr-rev__nav.rr-prev{left:0;}
    .rr-rev__nav.rr-next{right:0;}
    .rr-rev__nav:hover{background:#f5f7f8;}
    .rr-rev__count{text-align:center;font-size:12px;color:#8a9aa1;margin-top:10px;}
    .rr-card{
      background:#fff;border:1px solid #eceff1;border-radius:12px;
      padding:20px;box-shadow:0 2px 10px rgba(23,59,74,0.06);
      display:flex;flex-direction:column;min-height:100%;
    }
    .rr-card__top{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
    .rr-card__avatar{
      width:40px;height:40px;border-radius:50%;flex:none;color:#fff;font-weight:700;font-size:15px;
      display:flex;align-items:center;justify-content:center;
    }
    .rr-card__name{font-size:14.5px;font-weight:700;color:#1a1a1a;}
    .rr-card__date{font-size:12px;color:#8a9aa1;}
    .rr-card__g{margin-left:auto;flex:none;}
    .rr-card__stars{display:flex;align-items:center;gap:6px;color:#FBBC04;font-size:15px;letter-spacing:1px;margin-bottom:10px;}
    .rr-card__stars svg{width:15px;height:15px;}
    .rr-card__check{
